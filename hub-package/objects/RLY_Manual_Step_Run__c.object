<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <description>One manual step in one org's deploy: the deployment team marks it Done or Not needed there. A deploy into an org waits for its Before deploy steps.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableReports>true</enableReports>
    <enableSearch>false</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <fields>
        <fullName>Step__c</fullName>
        <deleteConstraint>Restrict</deleteConstraint>
        <description>The manual step.</description>
        <label>Step</label>
        <referenceTo>RLY_Manual_Step__c</referenceTo>
        <relationshipLabel>Runs</relationshipLabel>
        <relationshipName>Runs</relationshipName>
        <required>true</required>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Release__c</fullName>
        <deleteConstraint>Restrict</deleteConstraint>
        <description>The release deploying into this org: the one that defined the step, a promotion that carries it, or a back promote sync.</description>
        <label>Release</label>
        <referenceTo>RLY_Release__c</referenceTo>
        <relationshipLabel>Manual Step Runs</relationshipLabel>
        <relationshipName>Manual_Step_Runs</relationshipName>
        <required>true</required>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Org__c</fullName>
        <deleteConstraint>Restrict</deleteConstraint>
        <description>The org the step is done in.</description>
        <label>Org</label>
        <referenceTo>RLY_Org__c</referenceTo>
        <relationshipLabel>Manual Step Runs</relationshipLabel>
        <relationshipName>Manual_Step_Runs</relationshipName>
        <required>true</required>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Status__c</fullName>
        <description>To do, Done, or Not needed (with a note).</description>
        <label>Status</label>
        <required>false</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value><fullName>To_Do</fullName><default>true</default><label>To do</label></value>
                <value><fullName>Done</fullName><default>false</default><label>Done</label></value>
                <value><fullName>Not_Needed</fullName><default>false</default><label>Not needed</label></value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Done_By__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Who marked it Done or Not needed.</description>
        <label>Done By</label>
        <referenceTo>User</referenceTo>
        <relationshipName>RLY_Manual_Steps_Done</relationshipName>
        <required>false</required>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Done_On__c</fullName>
        <description>When it was marked Done or Not needed.</description>
        <label>Done On</label>
        <required>false</required>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Note__c</fullName>
        <description>The deployment team's note (required for Not needed).</description>
        <externalId>false</externalId>
        <label>Note</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Order__c</fullName>
        <description>The step's position in this deploy: carried releases in deploy order, then each step's sequence.</description>
        <externalId>false</externalId>
        <label>Order</label>
        <precision>6</precision>
        <required>false</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <label>Release Relay Manual Step Run</label>
    <nameField>
        <displayFormat>MSR-{00000}</displayFormat>
        <label>Manual Step Run Number</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Release Relay Manual Step Runs</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
</CustomObject>
