<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <description>One entry of a release's history (audit log): raised, pull request, scan, validation, approvals, deploys, manual steps, flow activation, merge back, promotion and back promote. Written only by Release Relay's Apex; read by every Release Relay user and exported as evidence.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableReports>true</enableReports>
    <enableSearch>false</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <fields>
        <fullName>Release__c</fullName>
        <deleteConstraint>Restrict</deleteConstraint>
        <description>The release the event belongs to.</description>
        <label>Release</label>
        <referenceTo>RLY_Release__c</referenceTo>
        <relationshipLabel>Events</relationshipLabel>
        <relationshipName>Events</relationshipName>
        <required>true</required>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Org__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>The org it happened in, when there is one.</description>
        <label>Org</label>
        <referenceTo>RLY_Org__c</referenceTo>
        <relationshipLabel>Release Events</relationshipLabel>
        <relationshipName>Release_Events</relationshipName>
        <required>false</required>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Event_Type__c</fullName>
        <description>What happened.</description>
        <label>Event Type</label>
        <required>false</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value><fullName>Raised</fullName><default>false</default><label>Raised</label></value>
                <value><fullName>Pull_Request</fullName><default>false</default><label>Pull request</label></value>
                <value><fullName>Scan</fullName><default>false</default><label>Code scan</label></value>
                <value><fullName>Validation</fullName><default>false</default><label>Validation</label></value>
                <value><fullName>Approved</fullName><default>false</default><label>Approved</label></value>
                <value><fullName>Rejected</fullName><default>false</default><label>Rejected</label></value>
                <value><fullName>Auto_Approved</fullName><default>false</default><label>Approved automatically</label></value>
                <value><fullName>Deployed</fullName><default>false</default><label>Deployed</label></value>
                <value><fullName>Deploy_Failed</fullName><default>false</default><label>Deploy failed</label></value>
                <value><fullName>Manual_Step</fullName><default>false</default><label>Manual step</label></value>
                <value><fullName>Flow_Activated</fullName><default>false</default><label>Flow activation</label></value>
                <value><fullName>Merged_Back</fullName><default>false</default><label>Merged back</label></value>
                <value><fullName>Promoted</fullName><default>false</default><label>Promoted</label></value>
                <value><fullName>Back_Promoted</fullName><default>false</default><label>Back promoted</label></value>
                <value><fullName>Comment</fullName><default>false</default><label>Comment</label></value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Actor__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Who did it, when a person did (approvals, manual steps, raising); blank for the pipeline and rules.</description>
        <label>Actor</label>
        <referenceTo>User</referenceTo>
        <relationshipName>RLY_Release_Events</relationshipName>
        <required>false</required>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Via__c</fullName>
        <description>Where it happened: Salesforce, Slack, Git, Rule or Pipeline.</description>
        <externalId>false</externalId>
        <label>Via</label>
        <length>40</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Detail__c</fullName>
        <description>What happened, in one human-readable line.</description>
        <label>Detail</label>
        <length>32768</length>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>Reference__c</fullName>
        <description>A reference: deploy id, pull request URL or pipeline run URL.</description>
        <externalId>false</externalId>
        <label>Reference</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Occurred_On__c</fullName>
        <description>When it happened.</description>
        <label>Occurred On</label>
        <required>false</required>
        <type>DateTime</type>
    </fields>
    <label>Release Relay Release Event</label>
    <nameField>
        <displayFormat>EV-{000000}</displayFormat>
        <label>Event Number</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Release Relay Release Events</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
</CustomObject>
