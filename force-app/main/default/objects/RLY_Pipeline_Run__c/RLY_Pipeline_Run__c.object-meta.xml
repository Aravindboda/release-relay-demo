<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <description>One row per GitHub Actions run of the Release Relay pipeline (and each re-run attempt), posted by the pipeline when it starts and when it ends. Read by the Pipeline Monitor tab; removed by the nightly archive after the Retention days.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableReports>false</enableReports>
    <enableSearch>false</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <label>RLY Pipeline Run</label>
    <nameField>
        <displayFormat>PRN-{000000}</displayFormat>
        <label>Pipeline Run Number</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>RLY Pipeline Runs</pluralLabel>
    <searchLayouts></searchLayouts>
    <sharingModel>ReadWrite</sharingModel>
</CustomObject>
