<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Slack_Match_By__c</fullName>
    <description>How approvers are matched to their Slack accounts: SSO (Federation ID looked up in Slack, the default), Email (Salesforce email, when exactly one approver has it) or Manual (nothing automatic). Changing it doesn&apos;t change saved links.</description>
    <label>Match Approvers By</label>
    <required>false</required>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>SSO</fullName>
                <default>true</default>
                <label>SSO Federation ID</label>
            </value>
            <value>
                <fullName>Email</fullName>
                <default>false</default>
                <label>Email</label>
            </value>
            <value>
                <fullName>Manual</fullName>
                <default>false</default>
                <label>Manual only</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
