{"path":"force-app/main/default/lwc/ihRecordTransactions/ihRecordTransactions.html","left":null,"right":"<template>\n    <section class=\"ih-card\" aria-label={cardTitle}>\n        <div class=\"ih-card-head\">\n            <h2 class=\"ih-card-title\">\n                <lightning-icon icon-name=\"standard:data_integration_hub\" size=\"small\" alternative-text=\"\"></lightning-icon>\n                {title}\n            </h2>\n            <div class=\"ih-row\">\n                <template lwc:if={polling}>\n                    <span class=\"ih-small ih-auto\" title=\"Updates by itself while transactions are in progress\">\n                        <lightning-icon icon-name=\"utility:sync\" size=\"xx-small\" alternative-text=\"\"></lightning-icon>\n                        Auto-refreshing\n                    </span>\n                </template>\n                <lightning-button-icon icon-name=\"utility:refresh\" alternative-text=\"Refresh\" title=\"Refresh\"\n                    onclick={handleRefresh} disabled={busy}></lightning-button-icon>\n            </div>\n        </div>\n\n        <template lwc:if={loading}>\n            <div class=\"ih-spinner\"><lightning-spinner alternative-text=\"Loading\" size=\"small\"></lightning-spinner></div>\n        </template>\n        <template lwc:if={error}>\n            <p class=\"ih-error\">{error}</p>\n        </template>\n\n        <template lwc:if={rows.length}>\n            <div class=\"ih-card-body\">\n                <div class=\"ih-tiles\">\n                    <template for:each={tiles} for:item=\"t\">\n                        <button key={t.key} class={t.cls} data-key={t.key} onclick={handleTile}>\n                            <span class=\"ih-tile-label\">{t.label}</span>\n                            <span class=\"ih-tile-value\">{t.value}</span>\n                        </button>\n                    </template>\n                </div>\n            </div>\n        </template>\n\n        <template lwc:if={hasRows}>\n            <ul class=\"list\" style={listStyle}>\n                <template for:each={filtered} for:item=\"r\">\n                    <li key={r.id} class=\"item\">\n                        <div class=\"line1\">\n                            <span class={r.directionClass}>{r.direction}</span>\n                            <a class=\"ih-link\" href={r.url} data-id={r.id} data-label={r.name} onclick={handleOpen}>{r.name}</a>\n                            <span class={r.badgeClass}>{r.status}</span>\n                            <span class=\"ih-spacer\"></span>\n                            <template lwc:if={r.canRetry}>\n                                <lightning-button-menu icon-name=\"utility:refresh\" icon-size=\"small\" menu-alignment=\"auto\"\n                                    alternative-text={r.retryLabel} title=\"Retry\" data-id={r.id}\n                                    onselect={handleRetry} disabled={busy}>\n                                    <lightning-menu-item value=\"new\" label=\"Retry with new payload\" prefix-icon-name=\"utility:refresh\"></lightning-menu-item>\n                                    <lightning-menu-item value=\"original\" label=\"Resend original payload\" prefix-icon-name=\"utility:send\"></lightning-menu-item>\n                                </lightning-button-menu>\n                            </template>\n                        </div>\n                        <div class=\"line2 ih-small\">\n                            {r.eventName} → {r.targetName} · attempts {r.attempts} ·\n                            <lightning-formatted-date-time value={r.createdDate} month=\"short\" day=\"numeric\" hour=\"numeric\"\n                                minute=\"2-digit\"></lightning-formatted-date-time>\n                        </div>\n                        <template lwc:if={r.note}>\n                            <div class={r.noteClass}>{r.note}</div>\n                        </template>\n                    </li>\n                </template>\n            </ul>\n        </template>\n\n        <template lwc:if={isEmpty}>\n            <p class=\"ih-empty\">No integration transactions for this record yet.</p>\n        </template>\n        <template lwc:if={showMore}>\n            <p class=\"ih-card-foot\">{moreText}</p>\n        </template>\n    </section>\n</template>"}
