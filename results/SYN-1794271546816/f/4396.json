{"path":"force-app/main/default/lwc/ihEventCheck/ihEventCheck.html","left":null,"right":"<template>\n    <section class=\"ih-card\" aria-label={cardTitle}>\n        <div class=\"ih-card-head\">\n            <h2 class=\"ih-card-title\">\n                <lightning-icon icon-name=\"standard:data_integration_hub\" size=\"small\" alternative-text=\"\"></lightning-icon>\n                {cardTitle}\n            </h2>\n        </div>\n        <div class=\"ih-card-body\">\n            <template lwc:if={isOutbound}>\n                <p class=\"ih-small\">Sends one GET to the Named Credential URL plus this event's Path. No record data is sent.\n                    A POST API usually answers 405 to a GET, which means the endpoint exists.\n                    Preview payload builds the request for one record exactly as a real send, without sending it.</p>\n            </template>\n            <template lwc:else>\n                <p class=\"ih-small\">Preview payload shows the call the middleware must make to this event, with a sample body\n                    and the answers Salesforce gives. Nothing is created.</p>\n            </template>\n            <template lwc:if={canCheck}>\n                <div class=\"actions\">\n                    <template lwc:if={isOutbound}>\n                        <lightning-button variant=\"brand\" label=\"Check endpoint\" icon-name=\"utility:connected_apps\"\n                            onclick={handleCheck} disabled={checking}></lightning-button>\n                    </template>\n                    <lightning-button label=\"Preview payload\" icon-name=\"utility:preview\"\n                        onclick={handlePreview}></lightning-button>\n                </div>\n            </template>\n            <template lwc:else>\n                <p class=\"ih-small\">Integration Hub Admin permission is needed to run the check or the preview.</p>\n            </template>\n            <template lwc:if={checking}>\n                <div class=\"ih-spinner\"><lightning-spinner alternative-text=\"Checking\" size=\"small\"></lightning-spinner></div>\n            </template>\n            <template lwc:if={result}>\n                <div class={resultClass} role=\"status\">\n                    <lightning-icon icon-name={resultIcon} size=\"x-small\" alternative-text=\"\"></lightning-icon>\n                    <span>{result.message}</span>\n                    <span class=\"ih-small\">{resultTime}</span>\n                </div>\n                <template lwc:if={result.reply}>\n                    <p class=\"ih-small reply\">Reply: {result.reply}</p>\n                </template>\n            </template>\n        </div>\n    </section>\n</template>"}
