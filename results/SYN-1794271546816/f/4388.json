{"path":"force-app/main/default/lwc/ihConfigTransfer/ihConfigTransfer.html","left":null,"right":"<template>\n    <div class={pageClass}>\n        <template lwc:if={showHero}>\n        <section class=\"ih-hero\">\n            <span class=\"ih-hero-icon\">\n                <lightning-icon icon-name=\"utility:sync\" size=\"small\" variant=\"inverse\" alternative-text=\"\"></lightning-icon>\n            </span>\n            <div class=\"ih-hero-text\">\n                <span class=\"ih-eyebrow\">Integration Hub</span>\n                <h1>Export and import</h1>\n                <p>Move connections and their events to another org as one file. Inbound users are never exported.</p>\n            </div>\n        </section>\n        </template>\n\n        <template lwc:if={isAdmin}>\n            <template lwc:if={error}>\n                <p class=\"ih-callout ih-callout_bad\">{error}</p>\n            </template>\n\n            <section class=\"ih-card\">\n                <div class=\"ih-card-head\">\n                    <h2 class=\"ih-card-title\">Export</h2>\n                    <lightning-button variant=\"brand\" label=\"Export file\" icon-name=\"utility:download\" onclick={handleExport}\n                        disabled={exportDisabled}></lightning-button>\n                </div>\n                <div class=\"ih-card-body\">\n                    <template lwc:if={hasConnections}>\n                        <p class=\"ih-small\">Pick the connections to export. Each comes with all of its events.</p>\n                        <template for:each={connectionRows} for:item=\"c\">\n                            <div key={c.id} class=\"ih-row pick\">\n                                <lightning-input type=\"checkbox\" label={c.name} data-id={c.id} checked={c.checked}\n                                    onchange={handlePick}></lightning-input>\n                                <span class=\"ih-small\">Named Credential {c.credential} · {c.eventCount}</span>\n                            </div>\n                        </template>\n                    </template>\n                    <template lwc:else>\n                        <p class=\"ih-empty\">No connections yet.</p>\n                    </template>\n                </div>\n            </section>\n\n            <section class=\"ih-card\">\n                <div class=\"ih-card-head\">\n                    <h2 class=\"ih-card-title\">Import</h2>\n                    <lightning-button variant=\"brand\" label=\"Import\" icon-name=\"utility:upload\" onclick={handleImport}\n                        disabled={importDisabled}></lightning-button>\n                </div>\n                <div class=\"ih-card-body\">\n                    <lightning-input type=\"file\" label=\"Export file (.json)\" accept=\".json,application/json\"\n                        onchange={handleFile}></lightning-input>\n                    <lightning-input type=\"checkbox\" label=\"Import events inactive (switch them on after checking the setup)\"\n                        checked={importInactive} onchange={handleInactive}></lightning-input>\n                    <template lwc:if={hasPlan}>\n                        <p class=\"ih-small\">Connections match by name, events by Event Key: existing ones are updated, new ones created.</p>\n                        <div class=\"ih-table-wrap\">\n                            <table class=\"ih-table\">\n                                <thead>\n                                    <tr><th scope=\"col\">Type</th><th scope=\"col\">Name or key</th><th scope=\"col\">Action</th><th scope=\"col\">Result</th></tr>\n                                </thead>\n                                <tbody>\n                                    <template for:each={planRows} for:item=\"p\">\n                                        <tr key={p.key}>\n                                            <td>{p.kind}</td>\n                                            <td>{p.name}</td>\n                                            <td>{p.action}</td>\n                                            <td class={p.resultClass}>{p.result}</td>\n                                        </tr>\n                                    </template>\n                                </tbody>\n                            </table>\n                        </div>\n                        <p class=\"ih-callout ih-callout_info\">After the import: on each connection set the Inbound User and check that its\n                            Named Credential exists in this org (same Name) with principal access on Integration Hub Read and Admin. Then\n                            switch the events on.</p>\n                    </template>\n                </div>\n            </section>\n        </template>\n        <template lwc:else>\n            <p class=\"ih-callout ih-callout_warn\">You need the Integration Hub Admin permission set to export or import.</p>\n        </template>\n    </div>\n</template>"}
