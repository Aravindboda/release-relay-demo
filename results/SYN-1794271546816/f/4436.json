{"path":"force-app/main/default/lwc/ihTransactionView/ihTransactionView.html","left":null,"right":"<template>\n    <section class=\"ih-card\" aria-label=\"Request and answer\">\n        <div class=\"ih-card-head\">\n            <h2 class=\"ih-card-title\">\n                <lightning-icon icon-name=\"standard:data_integration_hub\" size=\"small\" alternative-text=\"\"></lightning-icon>\n                Request and answer\n            </h2>\n        </div>\n        <div class=\"ih-card-body\">\n            <p class=\"ih-small\">Exactly what was sent and what came back: request, answer, callback, business processing\n                and every attempt. Copy it to share with the middleware team.</p>\n            <template lwc:if={retryText}>\n                <p class=\"ih-callout ih-callout_info retry\">{retryText}.</p>\n            </template>\n            <lightning-button variant=\"brand\" label=\"View request\" icon-name=\"utility:preview\"\n                onclick={handleView} class=\"view\"></lightning-button>\n        </div>\n    </section>\n</template>"}
