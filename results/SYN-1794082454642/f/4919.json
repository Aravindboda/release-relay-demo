{"path":"force-app/main/default/lwc/rlyReleaseTickets/rlyReleaseTickets.html","left":null,"right":"<template>\n    <section class=\"rr-tk\" aria-label=\"Work items\">\n        <div class=\"rr-tk-head\">\n            <template lwc:if={showHeading}><strong>Work items</strong></template>\n            <span class=\"rr-weak rr-small rr-grow\">{trackerLabel}</span>\n            <template lwc:if={canEdit}><lightning-button label=\"Edit\" variant=\"base\" onclick={startEdit} disabled={busy}></lightning-button></template>\n        </div>\n        <template lwc:if={error}><div class=\"rr-msg rr-msg-bad\" role=\"alert\">{error}</div></template>\n        <template lwc:if={editing}>\n            <c-rly-ticket-input value={draft} onchange={handleDraft}></c-rly-ticket-input>\n            <div class=\"rr-tk-actions\">\n                <lightning-button label=\"Cancel\" onclick={cancelEdit} disabled={busy}></lightning-button>\n                <lightning-button label=\"Save\" variant=\"brand\" onclick={saveEdit} disabled={busy}></lightning-button>\n            </div>\n        </template>\n        <template lwc:elseif={hasTickets}>\n            <ul class=\"rr-tk-list\">\n                <template for:each={rows} for:item=\"t\">\n                    <li key={t.ticket} class=\"rr-tk-row\">\n                        <template lwc:if={t.link}><a class=\"rr-a rr-strong\" href={t.link} target=\"_blank\" rel=\"noopener noreferrer\">{t.ticket}</a></template>\n                        <template lwc:else><strong>{t.ticket}</strong></template>\n                        <span class=\"rr-small rr-weak rr-grow\">{t.detail}</span>\n                        <span class={t.pillCls}>{t.statusText}</span>\n                        <template lwc:if={t.failed}><lightning-button label=\"Try again\" onclick={sync} disabled={busy}></lightning-button></template>\n                    </li>\n                </template>\n            </ul>\n        </template>\n        <template lwc:if={showEmpty}><p class=\"rr-small rr-weak\">No tickets on this release.</p></template>\n    </section>\n</template>"}
