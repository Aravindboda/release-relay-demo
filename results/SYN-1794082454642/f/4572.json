{"path":"force-app/main/default/email/unfiled$public/ModifyAppointmentEmailTemplateWithPaymentInfoForGuest.email","left":null,"right":"<!DOCTYPE html>\n<html>\n  <head>\n    <style type=\"text/css\">\n      body {\n       font-family: Segoe UI; \n      }\n      .container {\n        padding: 30px;\n        height: fit-content;\n        border-radius: 5px 5px 0px 0px;\n      }\n      .container-success {\n        background: #B7F5D280;\n        border-top: 5px solid #4BCA81;\n      }\n      .container-warning {\n        background: #fcf3e0;\n        border-top: 5px solid #d79301;\n      }\n      .container-reminder {\n        background: #B7DFF5;\n        border-top: 5px solid #1178B1;\n      }\n      .content {\n        padding: 30px;\n        background: white;\n      }\n      .details-box {\n        border: 1px solid #C9C9C9;\n      }\n      .padding-left-right-small {\n        padding: 0px 20px;\n      }\n      .horizontal-bar {\n        height: 1px;\n        background: #C9C9C9;\n      }\n      .table-container td{\n        padding: 10px;\n        font-size: 12px;\n      }\n      .scheduled-time-cell {\n        display: flex;\n        align-items: center;\n      }\n      .margin-right-xx_small {\n        margin-right: 5px;\n      }\n    </style>\n  </head>\n  <body>\n            <div class=\"container container-success\">\n            <div class=\"content\">\n            <p>\n            Hello, {!Lead.Name},\n            </p>\n            <p>\n            Your service appointment with <b>{!ServiceResource.Name}</b> has been rescheduled.</b>\n            </p>\n            <div class=\"details-box\">\n            <p class=\"padding-left-right-small\">\n            Here are the details:\n            </p>\n            <div class=\"horizontal-bar\"></div>\n            <div class=\"table-container\">\n            <table>\n            <tr>\n            <td>\n            Scheduled On:\n            </td>\n            <td class=\"scheduled-time-cell\">\n            <img src=\"https://test.salesforce.com/img/icon/t4v35/utility/event_60.png\" height=\"15\" class=\"margin-right-xx_small\">\n            <b>{!DATETIMEVALUE(ServiceAppointment.SchedStartTime)} - {!DATETIMEVALUE(ServiceAppointment.SchedEndTime)} ({!User.TimeZoneSidKey})</b>\n            </td>\n            </tr>\n            <tr>\n            <td>\n            Appointment Topic:\n            </td>\n            <td>\n            <b>{!ServiceAppointment.WorkType}</b>\n            </td>\n            </tr>\n            <tr>\n            <td>\n            Appointment with:\n            </td>\n            <td>\n            <b>{!ServiceResource.Name}</b>\n            </td>\n            </tr>\n            <tr>\n            <td>\n            Visit Type:\n            </td>\n            <td>\n            <b>{!ServiceAppointment.AppointmentType}</b>\n            </td>\n            </tr>\n            <tr>\n            <td>\n            Price:\n            </td>\n            <td>\n            <b>[CURRENCY] [AMOUNT]</b>\n            </td>\n            </tr>\n            </table>\n            </div>\n            </div>\n            <p>\n            If you change your mind, you can <a target=\"_blank\" href=\"[[MODIFY_APPT_FLOW_URL]]\">modify or cancel</a> your service appointment.\n            </p>\n            </div>\n            </div>\n          </body>\n</html>"}
