{"path":"force-app/main/default/lwc/rlyWorkTracking/rlyWorkTracking.html","left":null,"right":"<template>\n    <section class=\"rr-wt\" aria-label=\"Work tracking\">\n        <div class=\"rr-wt-head\">\n            <div class=\"rr-grow\">\n                <h2 class=\"rr-h2\">Work tracking</h2>\n                <p class=\"rr-small rr-weak\">{summary}</p>\n            </div>\n            <template lwc:if={isAdmin}>\n                <template lwc:if={showEdit}><lightning-button label=\"Edit\" onclick={startEdit}></lightning-button></template>\n            </template>\n        </div>\n        <template lwc:if={error}><div class=\"rr-msg rr-msg-bad\" role=\"alert\">{error}</div></template>\n        <template lwc:if={saved}><div class=\"rr-msg rr-msg-ok\" role=\"status\">{saved}</div></template>\n        <template lwc:if={editing}>\n            <div class=\"rr-wt-form\">\n                <c-rly-choice-chips mode=\"single\" label=\"Tracker\" options={trackerChips} value={trackerValue} onchange={handleTracker}></c-rly-choice-chips>\n                <div class=\"rr-grid2\">\n                    <lightning-input label=\"Ticket format (regular expressions, space separated)\" value={form.ticketPattern} data-field=\"ticketPattern\"\n                        onchange={handleText} placeholder={ticketHint} max-length=\"255\"></lightning-input>\n                    <lightning-input label=\"Link (optional)\" value={form.linkPattern} data-field=\"linkPattern\" onchange={handleText}\n                        placeholder={linkHint} max-length=\"255\"></lightning-input>\n                </div>\n                <lightning-input type=\"toggle\" label=\"Tickets required to raise\" checked={form.required} data-field=\"required\" onchange={handleToggle}\n                    message-toggle-active=\"\" message-toggle-inactive=\"\"></lightning-input>\n                <template lwc:if={integrates}>\n                    <div class=\"rr-grid2\">\n                        <lightning-input label=\"Named Credential (API name)\" value={form.namedCredential} data-field=\"namedCredential\" onchange={handleText}\n                            placeholder={credentialHint} max-length=\"80\"\n                            field-level-help=\"Created by an admin in Setup → Named Credentials. It holds the tracker's sign-in; Release Relay stores only its name.\"></lightning-input>\n                        <template lwc:if={isServiceNow}>\n                            <lightning-input label=\"ServiceNow table for work notes\" value={form.serviceNowTable} data-field=\"serviceNowTable\" onchange={handleText}\n                                placeholder=\"change_request\" max-length=\"80\"></lightning-input>\n                        </template>\n                    </div>\n                    <lightning-input type=\"toggle\" label=\"Post each moment to the ticket (raised, approval, deployed, failed, rolled back)\" checked={form.postUpdates}\n                        data-field=\"postUpdates\" onchange={handleToggle} message-toggle-active=\"\" message-toggle-inactive=\"\"></lightning-input>\n                    <lightning-textarea label=\"State map (optional JSON: moment → state or transition)\" value={form.stateMap} data-field=\"stateMap\"\n                        onchange={handleText} placeholder={stateHint} max-length=\"2000\"></lightning-textarea>\n                </template>\n                <template lwc:if={isServiceNow}>\n                    <div class=\"rr-grid2\">\n                        <lightning-input type=\"toggle\" label=\"Require an approved change before production\" checked={form.requireChange} data-field=\"requireChange\"\n                            onchange={handleToggle} message-toggle-active=\"\" message-toggle-inactive=\"\"></lightning-input>\n                        <lightning-input label=\"Change number format\" value={form.changePattern} data-field=\"changePattern\" onchange={handleText}\n                            placeholder={changeHint} max-length=\"80\"></lightning-input>\n                    </div>\n                </template>\n                <p class=\"rr-small rr-weak\">Without an integration, Release Relay tracks each ticket itself (Work items tab). With one, the same moments are posted to the ticket; a post that fails shows on the release with Try again.</p>\n                <div class=\"rr-wt-actions\">\n                    <lightning-button label=\"Cancel\" onclick={cancel} disabled={busy}></lightning-button>\n                    <lightning-button label=\"Save\" variant=\"brand\" onclick={save} disabled={busy}></lightning-button>\n                </div>\n            </div>\n        </template>\n    </section>\n</template>"}
