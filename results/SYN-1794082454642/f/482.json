{"path":"force-app/main/default/pages/FileNotFound.page","left":null,"right":"<apex:page showHeader=\"false\" title=\"{!$Label.site.file_not_found}\" cache=\"false\">\n  <apex:composition template=\"{!$Site.Template}\">\n    <apex:define name=\"body\">\n      <center>\n        <apex:panelGrid bgcolor=\"white\" columns=\"1\">\n          <br/>\n          <br/>\n          <apex:panelGrid width=\"758\" cellpadding=\"0\" cellspacing=\"0\" bgcolor=\"white\" columns=\"1\" styleClass=\"topPanelContainer\">\n            <br/>\n            <apex:outputPanel layout=\"block\" styleClass=\"topPanel\">\n              <apex:panelGrid width=\"758\" cellpadding=\"0\" cellspacing=\"0\" bgcolor=\"white\" columns=\"3\">\n                <apex:image url=\"{!URLFOR($Resource.SiteSamples, 'img/clock.png')}\"/>\n                <apex:image url=\"{!URLFOR($Resource.SiteSamples, 'img/warning.png')}\"/>\n                <apex:panelGroup >\n                  <apex:outputText styleClass=\"title\" value=\"{!$Label.site.page_not_found_detail}\">\n                   <apex:param value=\"{!$Site.OriginalUrl}\"/>\n                  </apex:outputText>\n                  <br/>\n                  <br/>\n                  <apex:outputText value=\"{!$Label.site.stay_tuned}\"/>\n                </apex:panelGroup>\n              </apex:panelGrid>\n             </apex:outputPanel>\n            <c:SitePoweredBy />\n          </apex:panelGrid>\n        </apex:panelGrid>\n      </center>\n    </apex:define>\n  </apex:composition>\n  <site:previewAsAdmin />\n</apex:page>"}
