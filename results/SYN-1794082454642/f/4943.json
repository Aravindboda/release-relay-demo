{"path":"force-app/main/default/lwc/rlySlackOrgReminders/rlySlackOrgReminders.html","left":null,"right":"<template>\n    <div class=\"rr-rem\" aria-label=\"Slack reminders\">\n        <div class=\"rr-row\">\n            <h4 class=\"rr-h4 rr-grow\">Reminders and alerts</h4>\n            <template lwc:if={canEdit}><lightning-button label=\"Edit\" onclick={startEdit} disabled={busy}></lightning-button></template>\n        </div>\n        <template lwc:if={error}><p class=\"rr-msg rr-msg-bad\" role=\"alert\">{error}</p></template>\n        <template lwc:if={ready}>\n            <template lwc:if={slackOff}><p class=\"rr-hint\">Slack is off for the hub: nothing is sent until it is on (Slack card above).</p></template>\n            <template lwc:if={noChannel}><p class=\"rr-hint\">Set this org's channel first: reminders, the digest and hotfix alerts post there.</p></template>\n            <template lwc:if={editing}>\n                <div class=\"rr-form\">\n                    <div class=\"rr-line\">\n                        <lightning-input type=\"toggle\" label=\"Reminders\" checked={form.reminders} data-field=\"reminders\" onchange={handleToggle}\n                            message-toggle-active=\"On\" message-toggle-inactive=\"Off\"></lightning-input>\n                        <lightning-input type=\"number\" label=\"Hours waiting before a nudge (and between nudges)\" value={form.hours} min=\"1\" max=\"72\"\n                            step=\"1\" data-field=\"hours\" onchange={handleNumber} disabled={remindersOff} placeholder=\"4\" class=\"rr-num\"></lightning-input>\n                    </div>\n                    <div class=\"rr-line\">\n                        <lightning-input type=\"toggle\" label=\"Daily digest\" checked={form.digest} data-field=\"digest\" onchange={handleToggle}\n                            message-toggle-active=\"On\" message-toggle-inactive=\"Off\"></lightning-input>\n                        <lightning-combobox label=\"Send at\" options={hourOptions} value={digestHourValue} data-field=\"digestHour\"\n                            onchange={handleNumber} disabled={digestOff} class=\"rr-hour\"></lightning-combobox>\n                    </div>\n                    <lightning-input type=\"toggle\" label=\"Mentions (the developer when checks fail, approvers when ready)\" checked={form.mentions}\n                        data-field=\"mentions\" onchange={handleToggle} message-toggle-active=\"On\" message-toggle-inactive=\"Off\"></lightning-input>\n                    <lightning-input type=\"toggle\" label=\"Hotfix alerts (post even when reminders are off)\" checked={form.hotfixAlerts}\n                        data-field=\"hotfixAlerts\" onchange={handleToggle} message-toggle-active=\"On\" message-toggle-inactive=\"Off\"></lightning-input>\n                    <p class=\"rr-hint\">Times use the hub's time zone ({s.timeZone}). Reminders are quiet between 8 PM and 7 AM. With reminders and the digest off, nothing is checked for this org.</p>\n                    <div class=\"rr-row rr-end\">\n                        <lightning-button label=\"Cancel\" onclick={cancel} disabled={busy}></lightning-button>\n                        <lightning-button variant=\"brand\" label=\"Save\" onclick={save} disabled={busy}></lightning-button>\n                    </div>\n                </div>\n            </template>\n            <template lwc:else>\n                <dl class=\"rr-facts\">\n                    <template for:each={facts} for:item=\"f\">\n                        <div key={f.key} class=\"rr-fact\"><dt>{f.label}</dt><dd>{f.value}</dd></div>\n                    </template>\n                </dl>\n            </template>\n        </template>\n        <template lwc:elseif={busy}><p class=\"rr-hint\">Reading…</p></template>\n    </div>\n</template>"}
