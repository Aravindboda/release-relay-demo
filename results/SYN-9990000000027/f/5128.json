{"path":"force-app/main/default/lwc/rlyWorkTracking/rlyWorkTracking.html","left":null,"right":"<template>\n    <!-- design board: several trackers (build 47, sections 1 and 2) -->\n    <section class=\"rr-wt\" aria-label=\"Work tracking\">\n        <div class=\"rr-wt-head\">\n            <div class=\"rr-grow\">\n                <h2 class=\"rr-h2\">Work tracking</h2>\n                <p class=\"rr-small rr-weak\">{summary}</p>\n            </div>\n            <template lwc:if={showAdd}><lightning-button label=\"Add tracker\" icon-name=\"utility:add\" onclick={startAdd} disabled={busy}></lightning-button></template>\n        </div>\n        <template lwc:if={error}><div class=\"rr-msg rr-msg-bad\" role=\"alert\">{error}</div></template>\n        <template lwc:if={saved}><div class=\"rr-msg rr-msg-ok\" role=\"status\">{saved}</div></template>\n\n        <template lwc:if={form}>\n            <div class=\"rr-wt-form\" aria-label={formTitle}>\n                <p class=\"rr-strong\">{formTitle}</p>\n                <c-rly-choice-chips mode=\"single\" label=\"Tracker\" options={kindOptions} value={form.kind} onchange={handleKind}></c-rly-choice-chips>\n                <div class=\"rr-grid2\">\n                    <lightning-input label=\"Name\" value={form.name} data-field=\"name\" onchange={handleText} placeholder={hints.name} max-length=\"80\"></lightning-input>\n                    <lightning-input label=\"Ticket pattern (regular expressions, space separated)\" value={form.ticketPattern} data-field=\"ticketPattern\"\n                        onchange={handleText} placeholder={hints.pattern} max-length=\"255\"\n                        field-level-help=\"The first active tracker whose pattern matches a ticket takes it. Leave it blank to take every ticket the others don't.\"></lightning-input>\n                </div>\n                <lightning-input label=\"Link (optional)\" value={form.linkPattern} data-field=\"linkPattern\" onchange={handleText}\n                    placeholder={hints.link} max-length=\"255\"></lightning-input>\n                <template lwc:if={integrates}>\n                    <div class=\"rr-grid2\">\n                        <lightning-input label=\"Named Credential (API name)\" value={form.namedCredential} data-field=\"namedCredential\" onchange={handleText}\n                            placeholder={hints.credential} max-length=\"80\"\n                            field-level-help=\"Created by an admin in Setup → Named Credentials, named RLY_Work_…. It holds the tracker's sign-in; Release Relay stores only its name.\"></lightning-input>\n                        <template lwc:if={isServiceNow}>\n                            <lightning-input label=\"ServiceNow table for work notes\" value={form.serviceNowTable} data-field=\"serviceNowTable\" onchange={handleText}\n                                placeholder=\"change_request\" max-length=\"80\"></lightning-input>\n                        </template>\n                    </div>\n                    <lightning-textarea label=\"State map (optional JSON: moment → state or transition)\" value={form.stateMap} data-field=\"stateMap\"\n                        onchange={handleText} placeholder={stateHint} max-length=\"2000\"></lightning-textarea>\n                </template>\n                <c-rly-choice-chips options={formChipOptions} value={formChipValue} onchange={handleFormChips}></c-rly-choice-chips>\n                <template lwc:if={isServiceNow}><p class=\"rr-small rr-weak\">Change must mention the release: the change gate only accepts a change request whose short description or description names the release, for example REL-00052.</p></template>\n                <p class=\"rr-small rr-weak\">Without an integration, Release Relay tracks each ticket itself (Work items tab). With one, the moments are posted to the ticket; a post that fails shows on the release with Try again.</p>\n                <div class=\"rr-wt-actions\">\n                    <lightning-button label=\"Cancel\" onclick={cancel} disabled={busy}></lightning-button>\n                    <lightning-button label=\"Save\" variant=\"brand\" onclick={save} disabled={busy}></lightning-button>\n                </div>\n            </div>\n        </template>\n\n        <template lwc:if={hasTrackers}>\n            <div class=\"rr-table\" role=\"table\" aria-label=\"Trackers\">\n                <div class=\"rr-tr rr-th\" role=\"row\">\n                    <span role=\"columnheader\">#</span><span role=\"columnheader\">Tracker</span><span role=\"columnheader\">Ticket pattern</span>\n                    <span role=\"columnheader\">Named Credential</span><span role=\"columnheader\">Posts</span><span role=\"columnheader\"></span>\n                </div>\n                <template for:each={rows} for:item=\"t\">\n                    <div key={t.id} class={t.rowCls} role=\"row\">\n                        <span class=\"rr-small rr-weak\" role=\"cell\">{t.position}</span>\n                        <span role=\"cell\"><span class=\"rr-strong rr-block\">{t.name}</span><span class={t.kindCls}>{t.kindLabel}</span></span>\n                        <span class=\"rr-mono rr-break\" role=\"cell\">{t.patternText}</span>\n                        <span class=\"rr-mono rr-break\" role=\"cell\">{t.credentialText}</span>\n                        <span role=\"cell\"><span class={t.postsCls}>{t.postsText}</span></span>\n                        <span class=\"rr-acts\" role=\"cell\">\n                            <template lwc:if={isAdmin}>\n                                <c-rly-choice-chips options={t.activeOptions} value={t.activeValue} data-id={t.id} onchange={handleActive} disabled={busy}></c-rly-choice-chips>\n                                <lightning-button-icon icon-name=\"utility:arrowup\" alternative-text=\"Move up\" title=\"Move up\" data-id={t.id} onclick={moveUp} disabled={t.upDisabled}></lightning-button-icon>\n                                <lightning-button-icon icon-name=\"utility:arrowdown\" alternative-text=\"Move down\" title=\"Move down\" data-id={t.id} onclick={moveDown} disabled={t.downDisabled}></lightning-button-icon>\n                                <lightning-button label=\"Edit\" data-id={t.id} onclick={startEdit} disabled={busy}></lightning-button>\n                                <lightning-button label=\"Test\" data-id={t.id} onclick={test} disabled={busy}></lightning-button>\n                            </template>\n                            <template lwc:else><span class={t.activeCls}>{t.activeText}</span></template>\n                        </span>\n                        <template lwc:if={t.test}><div class={t.testCls} role=\"status\">{t.test.message}</div></template>\n                    </div>\n                </template>\n            </div>\n            <div class=\"rr-try\">\n                <lightning-input label=\"Try a ticket\" value={tryText} onchange={handleTry} placeholder=\"PROJ-123\" max-length=\"80\"></lightning-input>\n                <template lwc:if={tryResult}><p class={tryResult.cls}>{tryResult.text}</p></template>\n            </div>\n        </template>\n        <template lwc:if={noTrackers}><p class=\"rr-small rr-weak\">Add a tracker for each place your tickets live, for example Jira for stories and ServiceNow for change requests.</p></template>\n\n        <div class=\"rr-switches\">\n            <p class=\"rr-strong rr-small\">For every tracker</p>\n            <c-rly-choice-chips options={switchOptions} value={switchValue} onchange={handleSwitches} disabled={switchesDisabled}></c-rly-choice-chips>\n            <template lwc:if={showChangePattern}>\n                <lightning-input class=\"rr-narrow\" label=\"Change number format\" value={switches.changePattern} onchange={handleChangePattern}\n                    placeholder={changeHint} max-length=\"80\" disabled={switchesDisabled}\n                    field-level-help=\"Only tickets that went to an active ServiceNow tracker and match this format count as the change request.\"></lightning-input>\n            </template>\n            <template lwc:if={switchesDirty}>\n                <div class=\"rr-wt-actions\">\n                    <lightning-button label=\"Cancel\" onclick={resetSwitches} disabled={busy}></lightning-button>\n                    <lightning-button label=\"Save\" variant=\"brand\" onclick={saveSwitches} disabled={busy}></lightning-button>\n                </div>\n            </template>\n        </div>\n    </section>\n</template>"}
