{"path":"force-app/main/default/pages/ForgotPassword.page","left":null,"right":"<apex:page id=\"forgotPassword\" showHeader=\"false\" controller=\"ForgotPasswordController\" title=\"{!$Label.site.forgot_password}\">\n <apex:composition template=\"{!$Site.Template}\">\n    <apex:define name=\"body\">\n      <center>\n        <apex:panelGrid bgcolor=\"white\" columns=\"1\"> \n          <br/>\n          <br/>\n          <apex:panelGrid width=\"758\" cellpadding=\"0\" cellspacing=\"0\" bgcolor=\"white\" columns=\"1\" styleClass=\"topPanelContainer\"> \n            <br/>\n            <apex:outputPanel layout=\"block\" styleClass=\"topPanel\">\n              <apex:panelGrid width=\"758\" cellpadding=\"0\" cellspacing=\"0\" bgcolor=\"white\" columns=\"2\"> \n                <apex:image url=\"{!URLFOR($Resource.SiteSamples, 'img/clock.png')}\"/>\n                <apex:panelGroup >\n                  <br/>\n                  <apex:outputText styleClass=\"title\" value=\"{!$Label.site.enter_password}\"/>\n                  <br/>\n                  <apex:form id=\"theForm\">\n                    <apex:pageMessages id=\"error\"/>\n                    <apex:panelGrid columns=\"3\" style=\"margin-top:1em;\">\n                      <apex:outputLabel value=\"{!$Label.site.username}\" for=\"username\"/>\n                      <apex:inputText required=\"true\" id=\"username\" value=\"{!username}\"/>\n                      <apex:commandButton id=\"submit\" value=\"{!$Label.site.submit}\" action=\"{!forgotPassword}\"/>\n                    </apex:panelGrid> \n                    </apex:form>                  \n                  <br/>\n                </apex:panelGroup>\n              </apex:panelGrid> \n             </apex:outputPanel>\n            <c:SitePoweredBy />\n          </apex:panelGrid> \n       </apex:panelGrid>\n      </center>\n      <br/>\n    </apex:define>\n  </apex:composition>\n</apex:page>"}
