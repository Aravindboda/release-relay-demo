{"path":"force-app/main/default/lwc/rlyProfileAccess/rlyProfileAccess.html","left":null,"right":"<template>\n    <div class=\"rr-pa\">\n        <!-- profiles -->\n        <section class=\"rr-pa-card\" aria-label=\"Profiles\">\n            <div class=\"rr-pa-top\">\n                <p class=\"rr-h3 rr-grow\">Profiles</p>\n                <span class=\"rr-small rr-weak\">Optional: skip this step if the release changes no profile.</span>\n            </div>\n            <template lwc:if={profileError}><div class=\"rr-msg rr-msg-bad\" role=\"alert\">{profileError}</div></template>\n            <template lwc:if={hasPicked}>\n                <div class=\"rr-chips\" role=\"group\" aria-label=\"Picked profiles\">\n                    <template for:each={pickedChips} for:item=\"p\">\n                        <span key={p.profile} class=\"rr-pa-picked\">\n                            <button type=\"button\" class={p.cls} aria-pressed={p.pressed} data-profile={p.profile} onclick={showProfile}>\n                                <span>{p.shown}</span><span class=\"rr-pa-count\">{p.count}</span>\n                            </button>\n                            <button type=\"button\" class=\"rr-pa-x\" data-profile={p.profile} onclick={dropProfile} disabled={disabled}\n                                title=\"Remove this profile\" aria-label=\"Remove this profile\">\n                                <lightning-icon icon-name=\"utility:close\" size=\"xx-small\" alternative-text=\"\"></lightning-icon>\n                            </button>\n                        </span>\n                    </template>\n                </div>\n            </template>\n            <lightning-input type=\"search\" label=\"Search profiles\" variant=\"label-hidden\" placeholder=\"Search profiles\"\n                value={search} onchange={handleSearch} disabled={disabled}></lightning-input>\n            <template lwc:if={profilesLoading}><p class=\"rr-small rr-weak\">Listing the profiles…</p></template>\n            <div class=\"rr-chips\" role=\"group\" aria-label=\"Profiles to add\">\n                <template for:each={matches} for:item=\"m\">\n                    <button key={m.profile} type=\"button\" class=\"rr-chip\" data-profile={m.profile} onclick={pickProfile} disabled={atLimit}>\n                        <lightning-icon icon-name=\"utility:add\" size=\"xx-small\" alternative-text=\"\"></lightning-icon><span>{m.shown}</span>\n                    </button>\n                </template>\n            </div>\n            <template lwc:if={moreMatches}><p class=\"rr-small rr-weak\">{moreMatches}</p></template>\n        </section>\n\n        <!-- the grid -->\n        <template lwc:if={hasPicked}>\n            <section class=\"rr-pa-card\" aria-label={gridLabel}>\n                <div class=\"rr-pa-top\">\n                    <p class=\"rr-h3 rr-grow\">{activeLabel}</p>\n                    <span class=\"rr-small rr-weak\">Grey: {sourceName} now · blue: will be sent · rows left blank aren't sent</span>\n                </div>\n                <template lwc:if={isReading}><p class=\"rr-small rr-weak\" role=\"status\">Reading the profiles' access…</p></template>\n                <template lwc:if={hasRows}>\n                    <table class=\"rr-pa-table\">\n                        <caption class=\"slds-assistive-text\">{gridLabel}</caption>\n                        <thead>\n                            <tr><th scope=\"col\" class=\"rr-pa-c1\">Component</th><th scope=\"col\" class=\"rr-pa-c2\">{targetHead}</th><th scope=\"col\">Send</th></tr>\n                        </thead>\n                        <template for:each={sections} for:item=\"s\">\n                            <tbody key={s.key}>\n                                <tr class=\"rr-pa-sec\"><th scope=\"colgroup\" colspan=\"3\">{s.label}</th></tr>\n                                <template for:each={s.rows} for:item=\"r\">\n                                    <tr key={r.id} class={r.rowCls}>\n                                        <th scope=\"row\" class=\"rr-pa-name\"><span class=\"rr-trunc rr-block\" title={r.key}>{r.key}</span></th>\n                                        <td class=\"rr-small rr-weak\">{r.targetText}</td>\n                                        <td>\n                                            <div class=\"rr-pa-send\">\n                                                <template lwc:if={r.isText}>\n                                                    <lightning-input class=\"rr-pa-text\" label=\"Layout\" variant=\"label-hidden\" value={r.textValue}\n                                                        placeholder={r.textHint} data-row={r.id} onchange={handleLayout} disabled={disabled}></lightning-input>\n                                                </template>\n                                                <template for:each={r.chips} for:item=\"c\">\n                                                    <button key={c.key} type=\"button\" class={c.cls} aria-pressed={c.pressed} data-row={r.id} data-value={c.key}\n                                                        onclick={handleChip} disabled={disabled}>{c.label}</button>\n                                                </template>\n                                                <template lwc:if={r.sent}>\n                                                    <button type=\"button\" class=\"rr-pa-x\" data-row={r.id} onclick={clearRow} disabled={disabled}\n                                                        title=\"Don't send this row\" aria-label=\"Don't send this row\">\n                                                        <lightning-icon icon-name=\"utility:undo\" size=\"xx-small\" alternative-text=\"\"></lightning-icon>\n                                                    </button>\n                                                </template>\n                                                <template lwc:if={r.added}>\n                                                    <button type=\"button\" class=\"rr-pa-x\" data-row={r.id} onclick={removeAdded} disabled={disabled}\n                                                        title=\"Remove this row\" aria-label=\"Remove this row\">\n                                                        <lightning-icon icon-name=\"utility:delete\" size=\"xx-small\" alternative-text=\"\"></lightning-icon>\n                                                    </button>\n                                                </template>\n                                            </div>\n                                        </td>\n                                    </tr>\n                                </template>\n                            </tbody>\n                        </template>\n                    </table>\n                </template>\n                <template lwc:else><p class=\"rr-small rr-weak\">{noRowsText}</p></template>\n                <div class=\"rr-pa-actions\">\n                    <lightning-button label={copyLabel} icon-name=\"utility:copy\" onclick={copySource} disabled={disabled}></lightning-button>\n                    <lightning-button label=\"Clear\" onclick={clearProfile} disabled={disabled}></lightning-button>\n                </div>\n            </section>\n        </template>\n\n        <!-- add access: picked from the developer org (build 58.1) -->\n        <section class=\"rr-pa-card\" aria-label=\"Add access\">\n            <p class=\"rr-h3\">Add access</p>\n            <p class=\"rr-small rr-weak\">For system permissions, custom settings, or a component already in the target. Pick the kind, then pick from {sourceName}.</p>\n            <div class=\"rr-pa-add\">\n                <lightning-combobox class=\"rr-pa-add-kind\" label=\"Kind\" options={sectionOptions} value={addSection} placeholder=\"Pick a kind\"\n                    onchange={handleAddSection} disabled={disabled}></lightning-combobox>\n                <template lwc:if={hasKind}>\n                    <lightning-input class=\"rr-pa-add-name\" type=\"search\" label=\"Find\" value={pickSearch} placeholder={pickPlaceholder}\n                        onchange={handlePickSearch} disabled={disabled}></lightning-input>\n                </template>\n            </div>\n            <template lwc:if={inObject}>\n                <div class=\"rr-chips\">\n                    <button type=\"button\" class=\"rr-chip\" onclick={backToObjects}>\n                        <lightning-icon icon-name=\"utility:chevronleft\" size=\"xx-small\" alternative-text=\"\"></lightning-icon><span>All objects</span>\n                    </button>\n                    <span class=\"rr-small rr-strong rr-pa-crumb\">{objectCrumb}</span>\n                </div>\n            </template>\n            <template lwc:if={picksLoading}><p class=\"rr-small rr-weak\" role=\"status\">Listing them in {sourceName}…</p></template>\n            <template lwc:if={hasPickMatches}>\n                <div class=\"rr-chips\" role=\"group\" aria-label=\"Components to add\">\n                    <template for:each={pickMatches} for:item=\"p\">\n                        <button key={p.key} type=\"button\" class=\"rr-chip\" title={p.title} data-key={p.key} onclick={choosePick} disabled={disabled}>\n                            <lightning-icon icon-name={p.icon} size=\"xx-small\" alternative-text=\"\"></lightning-icon><span>{p.label}</span>\n                        </button>\n                    </template>\n                </div>\n            </template>\n            <template lwc:if={noPicks}><p class=\"rr-small rr-weak\">Nothing matches.</p></template>\n            <template lwc:if={pickCount}><p class=\"rr-small rr-weak\">{pickCount}</p></template>\n            <template lwc:if={addError}><p class=\"rr-pa-error\" role=\"alert\">{addError}</p></template>\n        </section>\n\n        <template lwc:if={hasNotes}>\n            <div class=\"rr-msg rr-msg-warn\" role=\"status\">\n                <template for:each={noteList} for:item=\"n\"><p key={n.key}>{n.text}</p></template>\n            </div>\n        </template>\n        <template for:each={usageLines} for:item=\"u\">\n            <p key={u.key} class=\"rr-small rr-weak rr-pa-usage\"><lightning-icon icon-name=\"utility:connected_apps\" size=\"xx-small\" alternative-text=\"\"></lightning-icon> {u.text}</p>\n        </template>\n    </div>\n</template>"}
