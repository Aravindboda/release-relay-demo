{"path":"force-app/main/default/lwc/rlyCompare/rlyCompare.html","left":null,"right":"<template>\n    <section role=\"dialog\" tabindex=\"-1\" aria-modal=\"true\" aria-labelledby=\"rr-cmp-title\" aria-describedby=\"rr-cmp-intro\"\n        class=\"slds-modal slds-fade-in-open slds-modal_large rr-modal\" onkeydown={handleKeydown}>\n        <div class=\"slds-modal__container rr-modal-container\">\n            <button type=\"button\" class=\"slds-button slds-button_icon slds-modal__close rr-close\" title=\"Close\" onclick={close}>\n                <lightning-icon icon-name=\"utility:close\" size=\"small\" variant=\"inverse\" alternative-text=\"Close\"></lightning-icon>\n            </button>\n            <div class=\"slds-modal__header rr-modal-head\">\n                <h1 id=\"rr-cmp-title\" class=\"slds-modal__title rr-title\">{heading}</h1>\n                <p id=\"rr-cmp-intro\" class=\"rr-small rr-weak\">{intro}</p>\n            </div>\n            <div class=\"slds-modal__content rr-modal-body\">\n                <template lwc:if={showPipelineOffer}>\n                    <div class=\"rr-offer\" role=\"status\">\n                        <span class=\"rr-grow\">{pipelineOfferText}</span>\n                        <lightning-button label=\"Compare all in the pipeline\" onclick={startPipeline}></lightning-button>\n                    </div>\n                </template>\n                <template lwc:if={showProgress}>\n                    <div class=\"rr-prog\" role=\"status\">\n                        <strong>{progressText}</strong>\n                        <span class=\"rr-bar\" aria-hidden=\"true\"><i class=\"rr-bar-ok\" style={barReadyStyle}></i><i class=\"rr-bar-run\" style={barRunStyle}></i></span>\n                        <span class=\"rr-small rr-weak\">{runningText}</span>\n                        <template lwc:if={pipeRunUrl}><a href={pipeRunUrl} target=\"_blank\" rel=\"noopener noreferrer\" class=\"rr-small\">View run</a></template>\n                    </div>\n                </template>\n                <template lwc:if={hasTicks}>\n                    <span class=\"rr-tick\" aria-hidden=\"true\">\n                        <template for:each={ticks} for:item=\"t\">\n                            <span key={t.key} class={t.cls} data-part={t.part} onanimationend={handleTick}></span>\n                        </template>\n                    </span>\n                </template>\n                <div class=\"rr-cmp\">\n                    <!-- below 900px the list becomes a choice above the diff -->\n                    <div class=\"rr-c-pick\">\n                        <lightning-combobox label=\"Component\" value={selectedKey} options={pickOptions} onchange={handlePickChange}></lightning-combobox>\n                    </div>\n                    <nav class=\"rr-c-list\" aria-label=\"Components compared\">\n                        <p class=\"rr-c-head\">{countText}</p>\n                        <template lwc:if={showSearch}>\n                            <div class=\"rr-c-search\">\n                                <c-rly-search-box label=\"Search components\" placeholder=\"Search by name or type\" shown={shownCount} total={rowCount}\n                                    onsearch={handleSearch}></c-rly-search-box>\n                            </div>\n                        </template>\n                        <div class=\"rr-scroll\">\n                        <ul>\n                            <template for:each={shownRows} for:item=\"r\">\n                                <li key={r.key}>\n                                    <button type=\"button\" class={r.cls} aria-current={r.current} data-key={r.key} onclick={pickComponent}>\n                                        <span class=\"rr-c-l1\"><strong class=\"rr-c-name\" title={r.name}><template for:each={r.nameParts} for:item=\"t\"><template lwc:if={t.hit}><mark key={t.key}>{t.text}</mark></template><template lwc:else><span key={t.key}>{t.text}</span></template></template></strong><span class={r.chipCls}>{r.chipLabel}</span></span>\n                                        <span class=\"rr-small rr-weak\">{r.sub}</span>\n                                        <template lwc:if={r.why}><span class=\"rr-c-why\">{r.why}</span></template>\n                                    </button>\n                                </li>\n                            </template>\n                        </ul>\n                        <template lwc:if={noMatch}>\n                            <p class=\"rr-nomatch-p\">{noMatchText} <button type=\"button\" class=\"rr-linkbtn\" onclick={clearSearch}>Clear search</button></p>\n                        </template>\n                        </div>\n                    </nav>\n\n                    <div class=\"rr-c-pane\">\n                        <template lwc:if={error}>\n                            <div class=\"rr-msg rr-msg-bad\" role=\"alert\">{error}</div>\n                        </template>\n                        <template lwc:elseif={pipeFailed}>\n                            <div class=\"rr-c-card\">\n                                <div class=\"rr-c-cardh\"><strong>Compare in the pipeline</strong></div>\n                                <div class=\"rr-c-empty\">\n                                    <span class=\"rr-pill rr-pill-bad\">Couldn&rsquo;t compare</span>\n                                    <p>{pipeMessage}</p>\n                                    <template lwc:if={pipeRunUrl}><a href={pipeRunUrl} target=\"_blank\" rel=\"noopener noreferrer\">Open the run</a></template>\n                                </div>\n                            </div>\n                        </template>\n                        <template lwc:elseif={selectedFailed}>\n                            <div class=\"rr-c-card\">\n                                <div class=\"rr-c-cardh\"><strong class=\"rr-mono\">{unavailableName}</strong></div>\n                                <div class=\"rr-c-empty\">\n                                    <span class=\"rr-pill rr-pill-bad\">Couldn&rsquo;t read</span>\n                                    <p>{selectedError}</p>\n                                    <p class=\"rr-small rr-weak\">Only this part stopped; the other components carry on.</p>\n                                    <lightning-button label=\"Try again\" data-part={retryPartId} onclick={retryPart}></lightning-button>\n                                </div>\n                            </div>\n                        </template>\n                        <template lwc:elseif={loading}>\n                            <div class=\"rr-c-wait\" role=\"status\">\n                                <div class=\"rr-c-spin\"><lightning-spinner alternative-text=\"Loading\" size=\"small\"></lightning-spinner></div>\n                                <strong>{loadingTitle}</strong>\n                                <span class=\"rr-small rr-weak\">{loadingText}</span>\n                            </div>\n                        </template>\n                        <template lwc:elseif={showUnavailable}>\n                            <div class=\"rr-c-card\">\n                                <div class=\"rr-c-cardh\"><strong class=\"rr-mono\">{unavailableName}</strong></div>\n                                <div class=\"rr-c-empty\">\n                                    <span class=\"rr-pill rr-pill-none\">Not available</span>\n                                    <p>{unavailableReason}</p>\n                                    <template lwc:if={unavailableUrl}><p><a href={unavailableUrl} target=\"_blank\" rel=\"noopener\">Open it on the {targetBranch} branch</a></p></template>\n                                    <p class=\"rr-small rr-weak\">After raising, open the release and look at Changes: it shows the file as it lands on the branch.</p>\n                                </div>\n                            </div>\n                        </template>\n                        <template lwc:elseif={showFile}>\n                            <template lwc:if={fileDiff}>\n                                <c-rly-diff-view title={diffTitle} left-label={leftLabel} right-label={rightLabel} left={leftText} right={rightText}>\n                                    <template lwc:if={hasSubheader}>\n                                        <div slot=\"subheader\">\n                                            <template lwc:if={hasPicker}>\n                                                <div class=\"rr-fpick\" role=\"group\" aria-label=\"Files\">\n                                                    <template for:each={pickerFiles} for:item=\"f\">\n                                                        <button key={f.path} type=\"button\" class={f.cls} aria-pressed={f.pressed} data-path={f.path} onclick={pickFile}>{f.label}</button>\n                                                    </template>\n                                                    <span class={fileChipCls}>{fileChipLabel}</span>\n                                                </div>\n                                            </template>\n                                            <template lwc:if={flowLine}>\n                                                <div class=\"rr-fver\">\n                                                    <span class={flowLine.sourceCls}>{flowLine.source}</span><span class=\"rr-small rr-weak\">{flowLine.sourceWhere}</span>\n                                                    <template lwc:if={flowLine.hasTarget}>\n                                                        <span class=\"rr-vs\">vs</span>\n                                                        <span class={flowLine.targetCls}>{flowLine.target}</span><span class=\"rr-small rr-weak\">{flowLine.targetWhere}</span>\n                                                    </template>\n                                                    <template lwc:if={flowLine.note}><span class=\"rr-fver-note\">{flowLine.note}</span></template>\n                                                </div>\n                                            </template>\n                                        </div>\n                                    </template>\n                                </c-rly-diff-view>\n                            </template>\n                            <template lwc:elseif={filePatchShown}>\n                                <div class=\"rr-c-card\">\n                                    <div class=\"rr-c-cardh\"><strong class=\"rr-mono\">{diffTitle}</strong></div>\n                                    <template lwc:if={hasPicker}>\n                                        <div class=\"rr-fpick\" role=\"group\" aria-label=\"Files\">\n                                            <template for:each={pickerFiles} for:item=\"f\">\n                                                <button key={f.path} type=\"button\" class={f.cls} aria-pressed={f.pressed} data-path={f.path} onclick={pickFile}>{f.label}</button>\n                                            </template>\n                                        </div>\n                                    </template>\n                                    <p class=\"rr-small rr-weak rr-patch-note\">Too large to show both copies: the changed lines only (+ in {rightLabel}, &minus; on the {targetBranch} branch).</p>\n                                    <pre class=\"rr-patch\"><template for:each={patchLines} for:item=\"l\"><span key={l.key} class={l.cls}>{l.text}</span></template></pre>\n                                </div>\n                            </template>\n                            <template lwc:else>\n                                <div class=\"rr-c-card\">\n                                    <div class=\"rr-c-cardh\"><strong class=\"rr-mono\">{diffTitle}</strong></div>\n                                    <template lwc:if={hasPicker}>\n                                        <div class=\"rr-fpick\" role=\"group\" aria-label=\"Files\">\n                                            <template for:each={pickerFiles} for:item=\"f\">\n                                                <button key={f.path} type=\"button\" class={f.cls} aria-pressed={f.pressed} data-path={f.path} onclick={pickFile}>{f.label}</button>\n                                            </template>\n                                        </div>\n                                    </template>\n                                    <template lwc:if={filePending}>\n                                        <div class=\"rr-c-wait rr-c-wait-sm\" role=\"status\">\n                                            <div class=\"rr-c-spin\"><lightning-spinner alternative-text=\"Loading\" size=\"small\"></lightning-spinner></div>\n                                            <span class=\"rr-small rr-weak\">{fileReadingText}</span>\n                                        </div>\n                                    </template>\n                                    <template lwc:else>\n                                        <div class=\"rr-c-empty\">\n                                            <span class={fileChipCls}>{fileChipLabel}</span>\n                                            <p>{fileReason}</p>\n                                            <template lwc:if={fileTooLarge}>\n                                                <lightning-button label=\"Compare all in the pipeline\" onclick={startPipeline}></lightning-button>\n                                            </template>\n                                        </div>\n                                    </template>\n                                </div>\n                            </template>\n                        </template>\n                    </div>\n                </div>\n            </div>\n            <div class=\"slds-modal__footer rr-modal-foot\">\n                <span class=\"rr-grow rr-small rr-weak\">\n                    <template lwc:if={readAt}>{readLabel} <lightning-formatted-date-time value={readAt} month=\"short\" day=\"numeric\" hour=\"numeric\" minute=\"2-digit\"></lightning-formatted-date-time></template>\n                </span>\n                <lightning-button label=\"Close\" onclick={close}></lightning-button>\n            </div>\n        </div>\n    </section>\n    <div class=\"slds-backdrop slds-backdrop_open\" role=\"presentation\"></div>\n</template>"}
