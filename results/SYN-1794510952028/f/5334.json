{"path":"force-app/main/default/lwc/rlyRelayUpdate/rlyRelayUpdate.html","left":null,"right":"<template>\n    <!-- design board: scratchpad b51u/board.html (Install Release Relay update, admins only) -->\n    <template lwc:if={visible}>\n        <section class=\"rr-ru\" aria-label=\"Install Release Relay update\">\n            <span class=\"rr-ticks\" aria-hidden=\"true\">\n                <template for:each={ticks} for:item=\"t\"><span key={t.key} class=\"rr-tick rr-tick-30\" onanimationend={handleTick}></span></template>\n            </span>\n            <div class=\"rr-ru-head\">\n                <div class=\"rr-grow\">\n                    <h2 class=\"rr-h2\">Install Release Relay update</h2>\n                    <p class=\"rr-small rr-weak\">{subtitle}</p>\n                </div>\n                <span class={pillCls}>{pill}</span>\n            </div>\n\n            <template lwc:if={error}><div class=\"rr-msg rr-msg-bad\" role=\"alert\">{error}</div></template>\n            <template lwc:if={notSupported}><div class=\"rr-msg rr-msg-warn\" role=\"note\">{notSupportedText}</div></template>\n            <template lwc:if={notSigned}><p class=\"rr-small rr-weak\">The hub has no run-signing key yet, so these runs start unsigned (Security and credentials, Run signing).</p></template>\n\n            <template lwc:if={showForm}>\n                <div class=\"rr-ru-form\">\n                    <div class=\"rr-ru-field\">\n                        <lightning-input label=\"Update branch\" value={form.branch} placeholder=\"feature/relay-build-52\" onchange={handleBranch} disabled={busy}></lightning-input>\n                        <p class=\"rr-hint\">{branchHint}</p>\n                    </div>\n                    <div class=\"rr-ru-field\">\n                        <lightning-input label=\"Title\" value={form.title} placeholder=\"Release Relay build 52\" max-length=\"150\" onchange={handleTitle} disabled={busy}></lightning-input>\n                        <p class=\"rr-hint\">Shown on the pull requests and runs</p>\n                    </div>\n                </div>\n                <template lwc:if={hasStages}>\n                    <c-rly-choice-chips label=\"Test it in\" mode=\"single\" options={stageOptions} value={form.testOrgId} onchange={handleOrg} disabled={busy}></c-rly-choice-chips>\n                    <p class=\"rr-hint\">A stage on the route. Its install branch is rly-(its Git environment)-install.</p>\n                </template>\n                <template lwc:else><p class=\"rr-msg rr-msg-warn\" role=\"note\">Add a stage to the route first: the update is tested there before production.</p></template>\n            </template>\n            <template lwc:else>\n                <dl class=\"rr-facts\">\n                    <div><dt>Update branch</dt><dd class=\"rr-mono\">{current.branch}</dd></div>\n                    <div><dt>Zip</dt><dd class=\"rr-mono\">{current.zipPath}</dd></div>\n                    <div><dt>Tests</dt><dd>{testsText}</dd></div>\n                </dl>\n            </template>\n\n            <div>\n                <p class=\"rr-label\">Step</p>\n                <div class=\"rr-steps\" role=\"group\" aria-label=\"Steps, in order\">\n                    <template for:each={stepChips} for:item=\"c\">\n                        <span key={c.key} class=\"rr-step-wrap\">\n                            <template lwc:if={c.notFirst}><span class=\"rr-arrow\" aria-hidden=\"true\">→</span></template>\n                            <button type=\"button\" class={c.cls} aria-pressed={c.pressed} data-key={c.key} onclick={pickStep} disabled={c.off} title={c.title}>\n                                <span class=\"rr-n\" aria-hidden=\"true\">{c.mark}</span>\n                                <span>{c.label}</span>\n                                <template lwc:if={c.statusText}><span class=\"rr-st\">{c.statusText}</span></template>\n                            </button>\n                        </span>\n                    </template>\n                </div>\n            </div>\n            <template lwc:if={whatText}><div class=\"rr-what\">{whatText}</div></template>\n\n            <template lwc:if={hasRows}>\n                <div class=\"rr-tbl\" role=\"table\" aria-label=\"Steps run\">\n                    <div class=\"rr-tr rr-th\" role=\"row\">\n                        <span role=\"columnheader\">Step</span><span role=\"columnheader\">Status</span><span role=\"columnheader\">Request</span>\n                        <span role=\"columnheader\">Run</span><span role=\"columnheader\">Tests run</span><span role=\"columnheader\">Failures</span>\n                    </div>\n                    <template for:each={rows} for:item=\"r\">\n                        <div key={r.key} class=\"rr-tr\" role=\"row\">\n                            <span role=\"cell\">{r.label}</span>\n                            <span role=\"cell\"><span class={r.pillCls}>{r.status}</span></span>\n                            <span role=\"cell\" class=\"rr-mono rr-break\">{r.requestId}</span>\n                            <span role=\"cell\"><template lwc:if={r.runUrl}><a class=\"rr-a\" href={r.runUrl} target=\"_blank\" rel=\"noopener noreferrer\">Open run ↗</a></template><template lwc:else><span class=\"rr-weak\">—</span></template></span>\n                            <span role=\"cell\">{r.testsText}</span>\n                            <span role=\"cell\">{r.failText}</span>\n                        </div>\n                    </template>\n                </div>\n            </template>\n\n            <template lwc:if={problem}>\n                <template lwc:if={problem.message}><div class=\"rr-msg rr-msg-bad\" role=\"alert\">{problem.message}</div></template>\n                <template lwc:if={problem.hasFailures}>\n                    <ul class=\"rr-fails\" aria-label=\"Failures\">\n                        <template for:each={problem.failures} for:item=\"f\"><li key={f.key} class=\"rr-break\">{f.text}</li></template>\n                    </ul>\n                </template>\n            </template>\n            <template lwc:if={doneText}><div class=\"rr-msg rr-msg-ok\" role=\"status\">{doneText}</div></template>\n\n            <div class=\"rr-acts\">\n                <template lwc:if={showAnother}><lightning-button label=\"Start another update\" onclick={startAnother} disabled={busy}></lightning-button></template>\n                <template lwc:if={showCancelAnother}><lightning-button label=\"Cancel\" onclick={cancelAnother} disabled={busy}></lightning-button></template>\n                <span class=\"rr-small rr-weak rr-grow\">{footText}</span>\n                <template lwc:if={running}><lightning-button label=\"Refresh\" onclick={refreshNow} disabled={busy}></lightning-button></template>\n                <lightning-button variant=\"brand\" label={startLabel} onclick={startStep} disabled={cantStart}></lightning-button>\n            </div>\n        </section>\n    </template>\n</template>"}
