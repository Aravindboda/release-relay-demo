{"path":"force-app/main/default/lwc/rlyGuide/rlyGuide.html","left":null,"right":"<template>\n    <div class=\"guide\">\n        <div class=\"top\">\n            <div>\n                <h1 class=\"title\">Guide</h1>\n                <template lwc:if={isAdmin}>\n                    <p class=\"sub\">You see every guide because you have the Release Relay Admin permission set. Other users see Connection types and the Salesforce user, Approver and Git user guides.</p>\n                </template>\n                <template lwc:else>\n                    <p class=\"sub\">Step-by-step help for raising and reviewing pull requests from this org.</p>\n                </template>\n            </div>\n            <div class=\"top-actions\">\n                <a class=\"btn\" href={guideFileUrl} download=\"rly-guide.json\">\n                    <lightning-icon icon-name=\"utility:download\" size=\"x-small\" class=\"btn-icon\"></lightning-icon>Download guide\n                </a>\n                <template lwc:if={isAdmin}>\n                    <button class=\"btn btn-brand\" onclick={toggleEdit}>\n                        <lightning-icon icon-name=\"utility:edit\" size=\"x-small\" variant=\"inverse\" class=\"btn-icon\"></lightning-icon>{editLabel}\n                    </button>\n                </template>\n            </div>\n        </div>\n\n        <template lwc:if={showEdit}>\n            <section class=\"card edit-card\" aria-label=\"Edit the guide\">\n                <h2 class=\"h2\">Edit or share the guide</h2>\n                <p class=\"muted\">The guide is one file stored in Salesforce. Edit the file and upload it back; everyone in this org sees the change. The same file is the sample you share with another org.</p>\n                <ol class=\"numbered\">\n                    <li><span class=\"n\">1</span><span><strong>Download guide</strong> saves rly-guide.json with every guide and step.</span></li>\n                    <li><span class=\"n\">2</span><span>Edit it in any text editor. Each step has a title, who, where, actions, and an optional tip, table, code and picture.</span></li>\n                    <li><span class=\"n\">3</span><span>In Setup, open Static Resources, click <strong>RLY_Guide_Content</strong>, then Edit, choose your file, and Save.</span></li>\n                    <li><span class=\"n\">4</span><span>Reload this page. To share it, send the file; the other org uploads it the same way.</span></li>\n                </ol>\n                <div class=\"row-actions\">\n                    <a class=\"btn btn-brand\" href=\"/lightning/setup/StaticResources/home\" target=\"_blank\">Open Static Resources</a>\n                    <a class=\"btn\" href={guideFileUrl} download=\"rly-guide.json\">Download current file</a>\n                </div>\n                <p class=\"muted small\">Deploying a newer Release Relay package replaces this file with the built-in guide. Keep your edited copy, for example in the repository, and upload it again after an update.</p>\n            </section>\n        </template>\n\n        <template lwc:if={loading}>\n            <div class=\"card muted\">Loading the guide…</div>\n        </template>\n        <template lwc:if={loadError}>\n            <div class=\"card error\" role=\"alert\">{loadError}</div>\n        </template>\n\n        <template lwc:if={ready}>\n            <div class=\"roles\" role=\"group\" aria-label=\"Show the guide for\">\n                <template for:each={roleButtons} for:item=\"r\">\n                    <button key={r.id} class={r.cls} data-id={r.id} aria-pressed={r.pressed} onclick={handleRole}>\n                        <span class=\"role-dot\"></span>{r.label}\n                    </button>\n                </template>\n            </div>\n\n            <p class=\"intro\">{roleInfo.intro}</p>\n\n            <template lwc:if={roleInfo.art}>\n                <div class=\"intro-art\"><c-rly-guide-art name={roleInfo.art}></c-rly-guide-art></div>\n            </template>\n\n            <!-- Setup order -->\n            <template lwc:if={isOrder}>\n                <section class=\"card\" aria-label=\"Setup order\">\n                    <div class=\"order-head\">\n                        <h2 class=\"h2\">Setup order</h2>\n                        <div class=\"legend\">\n                            <span><span class=\"lg lg-gitAdmin\"></span>Git admin</span>\n                            <span><span class=\"lg lg-sfAdmin\"></span>Salesforce admin</span>\n                            <span><span class=\"lg lg-sfUser\"></span>Users</span>\n                        </div>\n                    </div>\n                    <ol class=\"timeline\">\n                        <template for:each={orderRows} for:item=\"o\">\n                            <li key={o.id} class=\"tl-row\">\n                                <div class=\"tl-rail\" aria-hidden=\"true\">\n                                    <span class={o.dotCls}>{o.num}</span>\n                                    <span class={o.lineCls}></span>\n                                </div>\n                                <div class=\"tl-body\">\n                                    <button class=\"link-btn tl-title\" data-num={o.num} onclick={handleOrderOpen}>{o.title}</button>\n                                    <span class={o.badgeCls}>{o.who}</span>\n                                    <template lwc:if={o.hasHandoff}>\n                                        <span class=\"handoff handoff-out tl-handoff\">{o.handoff}</span>\n                                    </template>\n                                </div>\n                            </li>\n                        </template>\n                    </ol>\n                    <p class=\"muted small\">Click a step to open it in that person's guide.</p>\n                </section>\n            </template>\n\n            <!-- Role guides -->\n            <template lwc:if={notOrder}>\n                <template lwc:if={hasSteps}>\n                    <div class=\"layout\">\n                        <aside class=\"card rail\" aria-label=\"Steps\">\n                            <div class=\"prog\">\n                                <div class=\"prog-label\"><strong>Your progress</strong><span>{progress.label}</span></div>\n                                <div class=\"prog-bar\" aria-hidden=\"true\"><div class=\"prog-fill\" style={progress.style}></div></div>\n                            </div>\n                            <ol class=\"rail-list\">\n                                <template for:each={steps} for:item=\"s\">\n                                    <li key={s.key}>\n                                        <button class={s.railCls} data-index={s.i} aria-current={s.current} onclick={handlePick}>\n                                            <span class={s.dotCls}>{s.dot}</span>\n                                            <span class=\"rail-text\">{s.title}</span>\n                                        </button>\n                                    </li>\n                                </template>\n                            </ol>\n                        </aside>\n\n                        <section class=\"card step-card\" aria-label={step.title}>\n                            <div class=\"meta\">\n                                <span class={step.badgeCls}>{step.whoLabel}</span>\n                                <template lwc:if={step.ofLabel}><span class=\"of\">{step.ofLabel}</span></template>\n                                <template lwc:if={step.isDone}><span class=\"done-tag\">Done</span></template>\n                            </div>\n                            <h2 class=\"step-title\">{step.title}</h2>\n                            <template lwc:if={step.summary}><p class=\"muted\">{step.summary}</p></template>\n                            <template lwc:if={step.where}><p class=\"where\">{step.where}</p></template>\n\n                            <template lwc:if={step.needs}>\n                                <p class=\"handoff handoff-in\"><lightning-icon icon-name=\"utility:download\" size=\"x-small\" class=\"btn-icon\"></lightning-icon>Before you start: {step.needs}</p>\n                            </template>\n\n                            <div class=\"step-body\">\n                                <template lwc:if={step.art}>\n                                    <figure class=\"step-art\"><c-rly-guide-art name={step.art}></c-rly-guide-art></figure>\n                                </template>\n                                <div class=\"step-text\">\n                                    <ol class=\"actions\">\n                                        <template for:each={step.actionList} for:item=\"a\">\n                                            <li key={a.id}><span class=\"n\">{a.n}</span><span>{a.text}</span></li>\n                                        </template>\n                                    </ol>\n                                    <template lwc:if={step.code}><pre class=\"code-block\">{step.code}</pre></template>\n                                    <template lwc:if={step.tableView}>\n                                        <div class=\"table-wrap\">\n                                            <table class=\"slds-table slds-table_bordered slds-table_cell-buffer\">\n                                                <thead>\n                                                    <tr>\n                                                        <template for:each={step.tableView.cols} for:item=\"c\"><th key={c.id} scope=\"col\">{c.text}</th></template>\n                                                    </tr>\n                                                </thead>\n                                                <tbody>\n                                                    <template for:each={step.tableView.rows} for:item=\"r\">\n                                                        <tr key={r.id}>\n                                                            <template for:each={r.cells} for:item=\"cell\"><td key={cell.id}>{cell.text}</td></template>\n                                                        </tr>\n                                                    </template>\n                                                </tbody>\n                                            </table>\n                                        </div>\n                                    </template>\n                                    <template lwc:if={step.tip}>\n                                        <p class=\"tip\"><lightning-icon icon-name=\"utility:info\" size=\"x-small\" class=\"btn-icon\"></lightning-icon>{step.tip}</p>\n                                    </template>\n                                </div>\n                            </div>\n\n                            <template lwc:if={step.gives}>\n                                <p class=\"handoff handoff-out\"><lightning-icon icon-name=\"utility:upload\" size=\"x-small\" class=\"btn-icon\"></lightning-icon>When done: {step.gives}</p>\n                            </template>\n\n                            <div class=\"card-foot\">\n                                <button class=\"btn\" onclick={handleBack} disabled={isFirst}>Back</button>\n                                <div class=\"foot-right\">\n                                    <template lwc:if={step.isDone}>\n                                        <button class=\"btn btn-quiet\" onclick={handleUndo}>Mark not done</button>\n                                    </template>\n                                    <button class=\"btn btn-brand\" onclick={handleDone}>{doneButtonLabel}</button>\n                                </div>\n                            </div>\n                        </section>\n                    </div>\n                </template>\n\n                <!-- Git admin: repository files -->\n                <template lwc:if={isGitAdmin}>\n                    <section class=\"card\" aria-label=\"Repository files\">\n                        <div class=\"order-head\">\n                            <div>\n                                <h2 class=\"h2\">Repository files</h2>\n                                <p class=\"muted\">The files for step 1, matching the Release Relay version installed in this org (guide {version}). Commit them to the repository's default branch.</p>\n                            </div>\n                            <a class=\"btn btn-brand\" href={repoZipUrl} download=\"release-relay-repo-files.zip\">\n                                <lightning-icon icon-name=\"utility:download\" size=\"x-small\" variant=\"inverse\" class=\"btn-icon\"></lightning-icon>Download all (.zip)\n                            </a>\n                        </div>\n                        <div class=\"table-wrap\">\n                            <table class=\"slds-table slds-table_bordered slds-table_cell-buffer\">\n                                <thead><tr><th scope=\"col\">File</th><th scope=\"col\">Put it in the repository at</th><th scope=\"col\">What it does</th><th scope=\"col\"><span class=\"slds-assistive-text\">Download</span></th></tr></thead>\n                                <tbody>\n                                    <template for:each={repoFiles} for:item=\"f\">\n                                        <tr key={f.id}>\n                                            <td class=\"mono strong\">{f.file}</td>\n                                            <td class=\"mono\">{f.where}</td>\n                                            <td>{f.what}</td>\n                                            <td><a class=\"btn btn-sm\" href={f.url} download={f.save}>Download</a></td>\n                                        </tr>\n                                    </template>\n                                </tbody>\n                            </table>\n                        </div>\n                        <p class=\"muted small\">Re-download after each Release Relay update and commit any changes.</p>\n                    </section>\n                </template>\n            </template>\n        </template>\n    </div>\n</template>"}
