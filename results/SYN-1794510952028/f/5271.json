{"path":"force-app/main/default/lwc/rlyFileEdit/rlyFileEdit.html","left":null,"right":"<template>\n    <!-- design board \"Package-aware releases\" e: edit any file of an open release -->\n    <section role=\"dialog\" tabindex=\"-1\" aria-modal=\"true\" aria-label={title} class=\"slds-modal slds-fade-in-open slds-modal_large rr-fe\" onkeydown={handleKeydown}>\n        <div class=\"slds-modal__container rr-fe-box\">\n            <div class=\"slds-modal__header rr-fe-head\">\n                <h2 class=\"slds-modal__title\">{title}</h2>\n                <button type=\"button\" class=\"rr-fe-x\" aria-label=\"Close\" title=\"Close\" onclick={close}>×</button>\n            </div>\n            <div class=\"slds-modal__content rr-fe-body\">\n                <template lwc:if={error}><div class=\"rr-msg rr-msg-bad\" role=\"alert\">{error}</div></template>\n                <template lwc:if={whyNot}><div class=\"rr-msg rr-msg-info\" role=\"status\">{whyNot}</div></template>\n                <div class=\"rr-fe-main\">\n                    <nav class=\"rr-fe-list\" aria-label=\"Files in this release\">\n                        <template for:each={items} for:item=\"i\">\n                            <button key={i.key} type=\"button\" class={i.cls} aria-current={i.current} data-key={i.key} onclick={handleItem} disabled={i.disabled}>{i.label}</button>\n                        </template>\n                    </nav>\n                    <div class=\"rr-fe-file\">\n                        <template lwc:if={loading}><p class=\"rr-small rr-weak\" role=\"status\">Reading the branches…</p></template>\n                        <template lwc:if={file}>\n                            <div class=\"rr-fe-bar\">\n                                <strong class=\"rr-fe-path\" title={file.path}>{file.path}</strong>\n                                <span class=\"rr-pill rr-pill-none\">{statusText}</span>\n                                <span class=\"rr-grow\"></span>\n                                <span class=\"rr-segs\" role=\"group\" aria-label=\"View\">\n                                    <button type=\"button\" class={sideCls} aria-pressed={sidePressed} onclick={showSide}>Side by side</button>\n                                    <button type=\"button\" class={diffCls} aria-pressed={diffPressed} onclick={showDiff}>Only differences</button>\n                                </span>\n                            </div>\n                            <template lwc:if={hasTabs}>\n                                <div class=\"rr-fe-tabs\" role=\"group\" aria-label=\"Files of this component\">\n                                    <template for:each={fileTabs} for:item=\"t\">\n                                        <button key={t.key} type=\"button\" class={t.cls} aria-pressed={t.pressed} data-path={t.path} onclick={handleTab}>{t.label}</button>\n                                    </template>\n                                </div>\n                            </template>\n                            <template lwc:if={fileReason}><div class=\"rr-msg rr-msg-wait\" role=\"status\">{fileReason}</div></template>\n                            <template lwc:if={isSide}>\n                                <div class=\"rr-fe-cols\">\n                                    <div class=\"rr-fe-col\">\n                                        <p class=\"rr-fe-colhead\">{orgHeading}</p>\n                                        <template lwc:if={orgNote}><p class=\"rr-small rr-weak rr-fe-note\">{orgNote}</p></template>\n                                        <span class=\"rr-fe-ticks\" aria-hidden=\"true\">\n                                            <template for:each={ticks} for:item=\"t\"><span key={t.key} class=\"rr-fe-tick\" onanimationend={handleTick}></span></template>\n                                        </span>\n                                        <div class=\"rr-fe-code\">\n                                            <template for:each={orgLines} for:item=\"l\"><div key={l.key} class={l.cls}><span class=\"rr-ln-n\">{l.n}</span><span class=\"rr-ln-t\">{l.text}</span></div></template>\n                                        </div>\n                                    </div>\n                                    <div class=\"rr-fe-col\">\n                                        <p class=\"rr-fe-colhead\">{targetHeading}</p>\n                                        <template lwc:if={targetNote}><p class=\"rr-small rr-weak rr-fe-note\">{targetNote}</p></template>\n                                        <div class=\"rr-fe-code\">\n                                            <template for:each={targetLines} for:item=\"l\"><div key={l.key} class={l.cls}><span class=\"rr-ln-n\">{l.n}</span><span class=\"rr-ln-t\">{l.text}</span></div></template>\n                                        </div>\n                                    </div>\n                                    <div class=\"rr-fe-col\">\n                                        <div class=\"rr-fe-colbar\">\n                                            <p class=\"rr-fe-colhead rr-grow\">{deployHeading}</p>\n                                            <template lwc:if={canEdit}><button type=\"button\" class=\"rr-linkbtn\" onclick={toggleEdit}>{editLabel}</button></template>\n                                        </div>\n                                        <template lwc:if={editing}>\n                                            <textarea class=\"rr-fe-text\" aria-label={deployHeading} spellcheck=\"false\" value={draft} oninput={handleDraft}></textarea>\n                                        </template>\n                                        <template lwc:else>\n                                            <div class=\"rr-fe-code\">\n                                                <template for:each={deployLines} for:item=\"l\">\n                                                    <div key={l.key} class={l.cls}><span class=\"rr-ln-n\">{l.n}</span><span class=\"rr-ln-t\">{l.text}</span><template lwc:if={l.tag}><span class=\"rr-ln-tag\">{l.tag}</span></template></div>\n                                                </template>\n                                            </div>\n                                        </template>\n                                    </div>\n                                </div>\n                            </template>\n                            <template lwc:else>\n                                <c-rly-diff-view title={diffTitle} left-label={targetHeading} right-label={deployHeading} left={diffLeft} right={draft}></c-rly-diff-view>\n                            </template>\n                        </template>\n                    </div>\n                </div>\n            </div>\n            <div class=\"slds-modal__footer rr-fe-foot\">\n                <div class=\"rr-grow rr-fe-notes\">\n                    <template for:each={packageNote} for:item=\"n\"><p key={n.key} class=\"rr-small\">{n.text}</p></template>\n                    <p class=\"rr-small rr-weak\">Saving commits the file to the release branch, records \"Edited by\" you in History and runs the checks again.</p>\n                </div>\n                <lightning-button label=\"Discard\" onclick={discard} disabled={cantSave}></lightning-button>\n                <lightning-button variant=\"brand\" label={saveLabel} onclick={save} disabled={cantSave}></lightning-button>\n                <lightning-button label=\"Close\" onclick={close} disabled={saving}></lightning-button>\n            </div>\n        </div>\n    </section>\n    <div class=\"slds-backdrop slds-backdrop_open\" role=\"presentation\"></div>\n</template>"}
