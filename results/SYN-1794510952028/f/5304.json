{"path":"force-app/main/default/lwc/rlyOrgPackages/rlyOrgPackages.html","left":null,"right":"<template>\n    <!-- design board \"Package-aware releases\" a: which org has which package -->\n    <section class=\"rr-pk\" aria-label=\"Installed packages\">\n        <div class=\"rr-pk-head\">\n            <div class=\"rr-grow\">\n                <h3 class=\"rr-h3\">Installed packages</h3>\n                <p class=\"rr-small rr-weak\">Read from each org · Check now and the nightly pass</p>\n            </div>\n            <template lwc:if={isAdmin}><lightning-button label={checkLabel} onclick={handleCheck} disabled={busy}></lightning-button></template>\n        </div>\n        <template lwc:if={error}><div class=\"rr-msg rr-msg-bad\" role=\"alert\">{error}</div></template>\n        <template lwc:if={message}><div class=\"rr-msg rr-msg-ok\" role=\"status\">{message}</div></template>\n        <template for:each={errorRows} for:item=\"e\"><div key={e.key} class=\"rr-msg rr-msg-wait\" role=\"status\">{e.text}</div></template>\n        <template lwc:if={busy}><p class=\"rr-small rr-weak\" role=\"status\">Reading each org's installed packages…</p></template>\n        <template lwc:if={hasPackages}>\n            <div class=\"rr-pk-scroll\">\n                <table class=\"rr-pk-table\">\n                    <caption class=\"slds-assistive-text\">Managed packages per org</caption>\n                    <thead>\n                        <tr>\n                            <th scope=\"col\">Package</th>\n                            <th scope=\"col\">Namespace</th>\n                            <template for:each={headers} for:item=\"h\"><th key={h.key} scope=\"col\">{h.name}</th></template>\n                        </tr>\n                    </thead>\n                    <tbody>\n                        <template for:each={rows} for:item=\"r\">\n                            <tr key={r.key}>\n                                <th scope=\"row\" class=\"rr-pk-name\">{r.name}</th>\n                                <td class=\"rr-mono\">{r.ns}</td>\n                                <template for:each={r.cells} for:item=\"c\">\n                                    <td key={c.key}>\n                                        <template lwc:if={c.toggle}>\n                                            <button type=\"button\" class={c.cls} aria-pressed={c.pressed} title={c.title} data-org={c.orgId} data-ns={c.ns}\n                                                data-off={c.off} onclick={handleMark} disabled={busy}>{c.text}</button>\n                                        </template>\n                                        <template lwc:else><span class={c.cls} title={c.title}>{c.text}</span></template>\n                                    </td>\n                                </template>\n                            </tr>\n                        </template>\n                        <tr class=\"rr-pk-raise\">\n                            <th scope=\"row\" colspan=\"2\">Can raise releases</th>\n                            <template for:each={raiseCells} for:item=\"c\">\n                                <td key={c.key}>\n                                    <template lwc:if={c.toggle}>\n                                        <button type=\"button\" class={c.cls} aria-pressed={c.pressed} title={c.title} data-id={c.id} data-on={c.on}\n                                            onclick={handleRaise} disabled={busy}>{c.text}</button>\n                                    </template>\n                                    <template lwc:else><span class={c.cls}>{c.text}</span></template>\n                                </td>\n                            </template>\n                        </tr>\n                    </tbody>\n                </table>\n            </div>\n            <template for:each={notes} for:item=\"n\"><div key={n.key} class=\"rr-msg rr-msg-warn\">{n.text}</div></template>\n            <p class=\"rr-small rr-weak\">Can raise releases: offer a stage in New release for changes that need a package the orgs below it lack. Its releases go to the next stop on the route.</p>\n        </template>\n        <template lwc:if={noPackages}><p class=\"rr-small rr-weak\">{noPackagesText}</p></template>\n        <template lwc:if={loaded}>\n            <p class=\"rr-small rr-weak rr-pb\">{footText}<a class=\"rr-a\" href=\"#\" onclick={openGuide}>What does this mean? (Guide)</a></p>\n        </template>\n    </section>\n</template>"}
