{"path":"force-app/main/default/lwc/rlyProfileAccessList/rlyProfileAccessList.html","left":null,"right":"<template>\n    <template lwc:if={error}><div class=\"rr-msg rr-msg-bad\" role=\"alert\">{error}</div></template>\n    <template lwc:if={hasAccess}>\n        <section class=\"rr-pal\" aria-label=\"Profile access\">\n            <div class=\"rr-pal-head\">\n                <p class=\"rr-h3 rr-pal-grow\">Profile access</p>\n                <span class=\"rr-pill rr-pill-info\">{countText}</span>\n            </div>\n            <p class=\"rr-small rr-weak rr-pal-note\">Only these rows of each profile are written and deployed; the rest of each profile stays as it is in the target.</p>\n            <template for:each={groups} for:item=\"g\">\n                <div key={g.key} class=\"rr-pal-group\">\n                    <p class=\"rr-strong rr-small\">{g.label}</p>\n                    <table class=\"rr-pal-table\">\n                        <caption class=\"slds-assistive-text\">Profile access for {g.label}</caption>\n                        <thead><tr><th scope=\"col\">Kind</th><th scope=\"col\">Component</th><th scope=\"col\">Sends</th></tr></thead>\n                        <tbody>\n                            <template for:each={g.rows} for:item=\"r\">\n                                <tr key={r.key}><td>{r.kind}</td><th scope=\"row\" class=\"rr-pal-name\">{r.name}</th><td>{r.sends}</td></tr>\n                            </template>\n                        </tbody>\n                    </table>\n                </div>\n            </template>\n        </section>\n    </template>\n</template>"}
