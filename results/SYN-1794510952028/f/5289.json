{"path":"force-app/main/default/lwc/rlyKeepLines/rlyKeepLines.html","left":null,"right":"<template>\n    <template lwc:if={show}>\n        <template lwc:if={isReading}>\n            <p class=\"rr-hint\" role=\"status\">{readingText}</p>\n            <template for:each={waits} for:item=\"w\"><c-rly-wait key={w.key} ms={w.ms} ondone={handleWaitDone}></c-rly-wait></template>\n        </template>\n        <template lwc:if={isFailed}>\n            <p class=\"rr-hint\" role=\"status\">{failedText}</p>\n        </template>\n        <template lwc:if={hasRows}>\n            <div class=\"rr-keep\" role=\"group\" aria-label={headline}>\n                <div class=\"rr-keep-warn\">\n                    <svg class=\"rr-keep-icon\" aria-hidden=\"true\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 3l9 16H3z\"></path><path d=\"M12 10v4\"></path><path d=\"M12 17h.01\"></path></svg>\n                    <div class=\"rr-keep-text\">\n                        <p class=\"rr-keep-title\">{headline}</p>\n                        <p class=\"rr-keep-explain\">{explain}</p>\n                    </div>\n                </div>\n                <div class=\"rr-keep-scroll\">\n                    <table class=\"rr-keep-table\">\n                        <thead>\n                            <tr>\n                                <th scope=\"col\">Line on the {branch} branch</th>\n                                <th scope=\"col\">Came from</th>\n                                <th scope=\"col\">This release</th>\n                            </tr>\n                        </thead>\n                        <tbody>\n                            <template for:each={lines} for:item=\"l\">\n                                <tr key={l.key}>\n                                    <td><strong>{l.name}</strong> · {l.words}</td>\n                                    <td class=\"rr-keep-from\">{branch}</td>\n                                    <td>\n                                        <div class=\"rr-tog-row\" role=\"group\" aria-label={l.groupLabel}>\n                                            <button type=\"button\" class={l.keepCls} data-key={l.key} data-value=\"keep\" aria-pressed={l.keepPressed} disabled={disabled} onclick={handleChoice}>Keep</button>\n                                            <button type=\"button\" class={l.removeCls} data-key={l.key} data-value=\"remove\" aria-pressed={l.removePressed} disabled={disabled} onclick={handleChoice}>Remove on purpose</button>\n                                        </div>\n                                    </td>\n                                </tr>\n                            </template>\n                        </tbody>\n                    </table>\n                </div>\n                <p class=\"rr-hint\">Lines {source} changed or added are never listed here; they always go in. Only items the release would take away appear, one row per item (layout field, permission, picklist value, value).</p>\n                <template lwc:if={leftOverText}><p class=\"rr-hint\">{leftOverText}</p></template>\n            </div>\n        </template>\n    </template>\n</template>"}
