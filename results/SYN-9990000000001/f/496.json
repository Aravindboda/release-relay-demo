{"path":"force-app/main/default/pages/SiteRegister.page","left":null,"right":"<apex:page id=\"Registration\" showHeader=\"false\" controller=\"SiteRegisterController\" title=\"{!$Label.site.register}\">\n  <apex:composition template=\"{!$Site.Template}\">\n    <apex:define name=\"body\">  \n      <center>\n        <apex:panelGrid bgcolor=\"white\" columns=\"1\"> \n          <br/>\n          <br/>\n          <apex:panelGrid width=\"758\" cellpadding=\"0\" cellspacing=\"0\" bgcolor=\"white\" columns=\"1\" styleClass=\"topPanelContainer\"> \n            <br/>\n            <apex:outputPanel layout=\"block\" styleClass=\"topPanel\">\n              <apex:panelGrid width=\"758\" cellpadding=\"0\" cellspacing=\"0\" bgcolor=\"white\" columns=\"2\"> \n                <apex:image url=\"{!URLFOR($Resource.SiteSamples, 'img/clock.png')}\"/>\n                <apex:panelGroup >\n                  <br/>\n                  <apex:outputText styleClass=\"title\" value=\"{!$Label.site.user_registration}\"/>\n                  <br/>\n                  <apex:form id=\"theForm\" forceSSL=\"true\">\n                    <apex:pageMessages id=\"error\"/>\n                    <apex:panelGrid columns=\"2\" style=\"margin-top:1em;\">\n                      <apex:outputLabel value=\"{!$Label.site.username}\" for=\"username\"/>\n                      <apex:inputText required=\"true\" id=\"username\" value=\"{!username}\"/>\n                      <apex:outputLabel value=\"{!$Label.site.community_nickname}\" for=\"communityNickname\"/>\n                      <apex:inputText required=\"true\" id=\"communityNickname\" value=\"{!communityNickname}\"/>\n                      <apex:outputLabel value=\"{!$Label.site.email}\" for=\"email\"/>\n                      <apex:inputText required=\"true\" id=\"email\" value=\"{!email}\"/>\n                      <apex:outputLabel value=\"{!$Label.site.password}\" for=\"password\"/>\n                      <apex:inputSecret id=\"password\" value=\"{!password}\"/>\n                      <apex:outputLabel value=\"{!$Label.site.confirm_password}\" for=\"confirmPassword\"/>\n                      <apex:inputSecret id=\"confirmPassword\" value=\"{!confirmPassword}\"/>\n                      <apex:outputText value=\"\"/>\n                      <apex:commandButton action=\"{!registerUser}\" value=\"{!$Label.site.submit}\" id=\"submit\"/>\n                    </apex:panelGrid> \n                    </apex:form>                  \n                  <br/>\n                </apex:panelGroup>\n              </apex:panelGrid> \n             </apex:outputPanel>\n            <c:SitePoweredBy />\n          </apex:panelGrid> \n       </apex:panelGrid>\n      </center>\n      <br/>\n    </apex:define>\n  </apex:composition>\n</apex:page>"}
