{"path":"force-app/main/default/lwc/rlyHome/rlyHome.html","left":null,"right":"<template>\n    <template lwc:if={statusRead}>\n        <c-rly-org-gate status={hubStatus}></c-rly-org-gate>\n        <template lwc:if={showPage}>\n            <div class=\"rr-page slds-is-relative\">\n                <template lwc:if={hubCopy}>\n                    <div class=\"slds-notify slds-notify_alert slds-alert_warning\" role=\"alert\">\n                        <lightning-icon icon-name=\"utility:warning\" size=\"x-small\" alternative-text=\"Warning\" class=\"slds-m-right_x-small\"></lightning-icon>\n                        <h2>{hubCopyMessage}</h2>\n                    </div>\n                </template>\n                <template lwc:if={loading}><lightning-spinner alternative-text=\"Loading\" size=\"small\"></lightning-spinner></template>\n\n                <!-- header -->\n                <section class=\"rr-card rr-head\">\n                    <span class=\"rr-head-icon\"><lightning-icon icon-name=\"utility:home\" size=\"x-small\" variant=\"inverse\" alternative-text=\"\"></lightning-icon></span>\n                    <div class=\"rr-head-text\">\n                        <p class=\"rr-kicker\">{kicker}</p>\n                        <h1 class=\"rr-title\">Home</h1>\n                        <template lwc:if={hasHome}>\n                            <p class=\"rr-greet\">\n                                <template lwc:if={narrow}><b class=\"rr-greet-need\">{greetNeeds}</b></template>\n                                <template lwc:else>{greeting} <template lwc:if={needsSomething}><b class=\"rr-greet-need\">{greetNeeds}</b>{greetDetail}</template><template lwc:else>{greetNeeds}</template></template>\n                            </p>\n                        </template>\n                    </div>\n                    <div class=\"rr-head-actions\">\n                        <lightning-button label=\"Refresh\" onclick={reload} disabled={loading} class=\"rr-hide-narrow\"></lightning-button>\n                        <lightning-button variant=\"brand\" label=\"New release\" onclick={openNewRelease} class=\"rr-new\"></lightning-button>\n                    </div>\n                </section>\n\n                <template lwc:if={error}><div class=\"rr-msg rr-msg-bad\" role=\"alert\">{error}</div></template>\n\n                <template lwc:if={hasFreezes}>\n                    <template for:each={freezes} for:item=\"fz\"><div key={fz.key} class={fz.cls} role=\"status\">{fz.text}</div></template>\n                </template>\n                <template lwc:if={hasHome}>\n                    <!-- health line (saved checks only) -->\n                    <section class=\"rr-card rr-hs\" aria-label=\"Health\">\n                        <span class=\"rr-hs-title\">Health</span>\n                        <template lwc:if={healthOk}>\n                            <span class=\"rr-hs-item\"><span class=\"rr-dot rr-dot-ok\"></span>All connections OK</span>\n                        </template>\n                        <template lwc:else>\n                            <span class=\"rr-hs-full\">\n                                <template for:each={healthItems} for:item=\"hi\">\n                                    <span key={hi.key} class={hi.cls} title={hi.title}><span class={hi.dot}></span>{hi.text}</span>\n                                </template>\n                            </span>\n                            <span class=\"rr-hs-short\"><span class={healthSummaryCls}><span class={healthSummaryDot}></span>{healthSummary}</span></span>\n                        </template>\n                        <span class=\"rr-grow\"></span>\n                        <span class=\"rr-weak rr-small rr-hide-narrow\">{checkedText}</span>\n                        <template lwc:if={isAdmin}><button type=\"button\" class=\"rr-link\" onclick={openPipeline}>Pipeline ›</button></template>\n                    </section>\n\n                    <!-- KPI tiles -->\n                    <div class=\"rr-kpis\">\n                        <template for:each={tiles} for:item=\"t\">\n                            <button key={t.key} type=\"button\" class={t.cls} data-key={t.key} onclick={openTile} title={t.title}>\n                                <span class=\"rr-tile-go\" aria-hidden=\"true\">›</span>\n                                <span class=\"rr-tile-label\">{t.label}</span>\n                                <span class=\"rr-tile-value\">{t.value}<template lwc:if={t.hasUnit}><small>{t.unit}</small></template></span>\n                                <span class=\"rr-tile-sub\">{t.sub}</span>\n                            </button>\n                        </template>\n                        <div class=\"rr-tile rr-tile-plain\">\n                            <span class=\"rr-tile-label\">Raise → deployed · 30 days</span>\n                            <span class=\"rr-tile-value\">{leadValue}<template lwc:if={hasLead}><small>days</small></template></span>\n                            <span class=\"rr-tile-sub\">{leadSub}</span>\n                        </div>\n                    </div>\n\n                    <div class=\"rr-row2\">\n                        <!-- Needs you -->\n                        <section class=\"rr-card rr-list-card\" aria-label=\"Needs you\">\n                            <div class=\"rr-card-hd\">\n                                <h2 class=\"rr-h2\">Needs you</h2>\n                                <span class=\"rr-pill rr-pill-wait\">{needsTotal}</span>\n                                <span class=\"rr-grow\"></span>\n                                <span class=\"rr-weak rr-small rr-hide-narrow\">{needsRoles}</span>\n                            </div>\n                            <div class=\"rr-toolbar\">\n                                <c-rly-search-box data-list=\"needs\" label=\"Search Needs you\" placeholder=\"Search release, title, org or raiser\"\n                                    shown={needsShown} total={needsTotal} onsearch={handleNeedsSearch}></c-rly-search-box>\n                            </div>\n                            <div class=\"rr-scroll rr-scroll-needs\">\n                                <table class=\"rr-ft\">\n                                    <template lwc:if={narrow}>\n                                        <colgroup><col><col class=\"rr-w-60\"><col class=\"rr-w-62\"></colgroup>\n                                        <thead><tr><th scope=\"col\">Release</th><th scope=\"col\">Since</th><th scope=\"col\"><span class=\"slds-assistive-text\">Open</span></th></tr></thead>\n                                    </template>\n                                    <template lwc:else>\n                                        <colgroup><col class=\"rr-w-100\"><col><col class=\"rr-w-112\"><col class=\"rr-w-100\"><col class=\"rr-w-112\"><col class=\"rr-w-64\"><col class=\"rr-w-60\"></colgroup>\n                                        <thead><tr><th scope=\"col\">Release</th><th scope=\"col\">Title</th><th scope=\"col\">Status</th><th scope=\"col\">Org</th><th scope=\"col\">Raised by</th><th scope=\"col\">Since</th><th scope=\"col\"><span class=\"slds-assistive-text\">Open</span></th></tr></thead>\n                                    </template>\n                                    <template for:each={needGroups} for:item=\"g\">\n                                        <tbody key={g.key}>\n                                            <tr class=\"rr-gh\"><td colspan=\"7\">{g.label}<em>{g.count}</em></td></tr>\n                                            <template lwc:if={g.isEmpty}>\n                                                <tr><td colspan=\"7\" class=\"rr-group-empty\"><b>{g.emptyTitle}</b>\n                                                    <template lwc:if={g.emptyLink}> <button type=\"button\" class=\"rr-linkbtn\" onclick={openNewRelease}>{g.emptyLink}</button></template>\n                                                    {g.emptyText}</td></tr>\n                                            </template>\n                                            <template for:each={g.rows} for:item=\"r\">\n                                                <tr key={r.key}>\n                                                    <template lwc:if={narrow}>\n                                                        <td title={r.fullTitle}>\n                                                            <span class=\"rr-line\"><button type=\"button\" class=\"rr-rel\" data-id={r.releaseId} onclick={openRelease}><template for:each={r.nameParts} for:item=\"a\"><template lwc:if={a.hit}><mark key={a.key}>{a.text}</mark></template><template lwc:else><span key={a.key}>{a.text}</span></template></template></button> <span class={r.pillCls}>{r.pill}</span></span>\n                                                            <span class=\"rr-line rr-sub\"><template for:each={r.titleParts} for:item=\"b\"><template lwc:if={b.hit}><mark key={b.key}>{b.text}</mark></template><template lwc:else><span key={b.key}>{b.text}</span></template></template></span>\n                                                        </td>\n                                                        <td class=\"rr-weak\">{r.sinceText}</td>\n                                                        <td class=\"rr-c\"><button type=\"button\" class=\"rr-open\" data-id={r.releaseId} onclick={openRelease} aria-label={r.openLabel}>Open</button></td>\n                                                    </template>\n                                                    <template lwc:else>\n                                                        <td><button type=\"button\" class=\"rr-rel\" data-id={r.releaseId} onclick={openRelease}><template for:each={r.nameParts} for:item=\"c\"><template lwc:if={c.hit}><mark key={c.key}>{c.text}</mark></template><template lwc:else><span key={c.key}>{c.text}</span></template></template></button></td>\n                                                        <td title={r.fullTitle}><template for:each={r.titleParts} for:item=\"d\"><template lwc:if={d.hit}><mark key={d.key}>{d.text}</mark></template><template lwc:else><span key={d.key}>{d.text}</span></template></template></td>\n                                                        <td><span class={r.pillCls} title={r.note}>{r.pill}</span></td>\n                                                        <td title={r.org}><template for:each={r.orgParts} for:item=\"e\"><template lwc:if={e.hit}><mark key={e.key}>{e.text}</mark></template><template lwc:else><span key={e.key}>{e.text}</span></template></template></td>\n                                                        <td title={r.raisedBy}><template for:each={r.byParts} for:item=\"f\"><template lwc:if={f.hit}><mark key={f.key}>{f.text}</mark></template><template lwc:else><span key={f.key}>{f.text}</span></template></template></td>\n                                                        <td class=\"rr-weak\">{r.sinceText}</td>\n                                                        <td class=\"rr-c\"><button type=\"button\" class=\"rr-open\" data-id={r.releaseId} onclick={openRelease} aria-label={r.openLabel}>Open</button></td>\n                                                    </template>\n                                                </tr>\n                                            </template>\n                                        </tbody>\n                                    </template>\n                                    <template lwc:if={needsNoMatch}>\n                                        <tbody><tr><td colspan=\"7\" class=\"rr-nomatch\">{needsNoMatchText} <button type=\"button\" class=\"rr-linkbtn\" onclick={clearNeedsSearch}>Clear search</button></td></tr></tbody>\n                                    </template>\n                                </table>\n                            </div>\n                            <template lwc:if={approver}>\n                                <div class=\"rr-lfoot\"><span class=\"rr-grow\"></span><button type=\"button\" class=\"rr-link\" onclick={openApprovals}>Approvals ›</button></div>\n                            </template>\n                        </section>\n\n                        <!-- Deploys chart -->\n                        <section class=\"rr-card\" aria-label=\"Deploys over the last 8 weeks\">\n                            <div class=\"rr-card-hd\"><h2 class=\"rr-h2\">Deploys · last 8 weeks</h2><span class=\"rr-grow\"></span><span class=\"rr-weak rr-small\">All orgs</span></div>\n                            <template lwc:if={hasDeploys}>\n                                <div class=\"rr-chart\">\n                                    <div class=\"rr-legend\"><span><i class=\"rr-key-ok\"></i>Deployed</span><span><i class=\"rr-key-bad\"></i>Failed</span></div>\n                                    <svg viewBox=\"0 0 420 170\" role=\"img\" aria-label=\"Deployed and failed deploys per week, last 8 weeks\" class=\"rr-chart-svg\">\n                                        <template for:each={chart.grid} for:item=\"gl\">\n                                            <g key={gl.key}>\n                                                <line x1=\"28\" y1={gl.y} x2=\"414\" y2={gl.y} class=\"rr-gridline\"></line>\n                                                <text x=\"22\" y={gl.labelY} class=\"rr-axis\">{gl.text}</text>\n                                            </g>\n                                        </template>\n                                        <line x1=\"28\" y1=\"140\" x2=\"414\" y2=\"140\" class=\"rr-baseline\"></line>\n                                        <template for:each={chart.bars} for:item=\"b\">\n                                            <g key={b.key}>\n                                                <title>{b.tip}</title>\n                                                <rect x={b.dx} y={b.dy} width=\"16\" height={b.dh} rx=\"2\" class=\"rr-bar-ok\"></rect>\n                                                <rect x={b.fx} y={b.fy} width=\"16\" height={b.fh} rx=\"2\" class=\"rr-bar-bad\"></rect>\n                                                <text x={b.lx} y=\"156\" class={b.labelCls}>{b.label}</text>\n                                                <template lwc:if={b.showPeak}><text x={b.px} y={b.py} class=\"rr-peak\">{b.peak}</text></template>\n                                            </g>\n                                        </template>\n                                    </svg>\n                                    <div class=\"rr-chart-foot\"><span><b>{chartDeployed}</b> deployed · <b>{chartFailed}</b> failed · <b>{chartSuccess}</b> OK</span><span class=\"rr-grow\"></span><button type=\"button\" class=\"rr-link\" onclick={openDeployed}>Releases ›</button></div>\n                                    <template lwc:if={hasWeekByOrg}>\n                                        <p class=\"rr-cap\">This week by org</p>\n                                        <table class=\"rr-ft rr-ft-small\">\n                                            <colgroup><col><col class=\"rr-w-72\"><col class=\"rr-w-60\"></colgroup>\n                                            <thead><tr><th scope=\"col\">Org</th><th scope=\"col\" class=\"rr-r\">Deployed</th><th scope=\"col\" class=\"rr-r\">Failed</th></tr></thead>\n                                            <tbody>\n                                                <template for:each={weekByOrg} for:item=\"o\">\n                                                    <tr key={o.orgName}><td title={o.orgName}>{o.orgName}</td><td class=\"rr-r\">{o.deployed}</td><td class=\"rr-r\">{o.failed}</td></tr>\n                                                </template>\n                                            </tbody>\n                                        </table>\n                                    </template>\n                                </div>\n                            </template>\n                            <template lwc:else>\n                                <div class=\"rr-pad\"><div class=\"rr-empty\"><b>No deploys in the last 8 weeks.</b><span>Bars appear after the first deploy.</span></div></div>\n                            </template>\n                        </section>\n                    </div>\n\n                    <!-- Route -->\n                    <template lwc:if={showRoute}>\n                        <section class=\"rr-card\" aria-label=\"Route\">\n                            <div class=\"rr-card-hd\"><h2 class=\"rr-h2\">Route</h2><span class=\"rr-weak rr-small rr-hide-narrow\">{routeSub}</span><span class=\"rr-grow\"></span>\n                                <template lwc:if={routeSet}><button type=\"button\" class=\"rr-link\" onclick={openPromote}>Promote ›</button></template></div>\n                            <template lwc:if={routeSet}>\n                                <div class=\"rr-route\">\n                                    <template for:each={stops} for:item=\"s\">\n                                        <div key={s.orgId} class=\"rr-stop-wrap\">\n                                            <div class={s.cls}>\n                                                <div class=\"rr-stop-hd\"><b>{s.name}</b><span class=\"rr-weak rr-tiny\">{s.roleText}</span><span class=\"rr-stop-st\"><span class={s.dot}></span>{s.statusText}</span></div>\n                                                <div class=\"rr-stop-bd\">\n                                                    <div class=\"rr-stop-last\">\n                                                        <p class=\"rr-weak rr-tiny\">{s.lastLabel}</p>\n                                                        <template lwc:if={s.hasLast}>\n                                                            <button type=\"button\" class=\"rr-rel rr-line\" data-id={s.lastId} onclick={openRelease} title={s.lastText}>{s.lastText}</button>\n                                                            <span class=\"rr-weak rr-line\">{s.meta}</span>\n                                                        </template>\n                                                        <template lwc:else><span class=\"rr-weak\">{s.noLast}</span></template>\n                                                    </div>\n                                                    <div class=\"rr-stop-count\">\n                                                        <span class=\"rr-stop-n\">{s.count}</span>\n                                                        <span class=\"rr-grow rr-stop-text\">{s.countText}</span>\n                                                        <lightning-button label={s.action} variant={s.actionVariant} size=\"small\" data-kind={s.kind} onclick={openStop}></lightning-button>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                            <template lwc:if={s.showArrow}><span class=\"rr-arrow\" aria-hidden=\"true\"><span class=\"rr-arrow-right\">→</span><span class=\"rr-arrow-down\">↓</span></span></template>\n                                        </div>\n                                    </template>\n                                </div>\n                            </template>\n                            <template lwc:else>\n                                <div class=\"rr-pad\"><div class=\"rr-empty\"><b>No route yet. Set the route in Pipeline.</b><button type=\"button\" class=\"rr-link\" onclick={openPipeline}>Open Pipeline ›</button></div></div>\n                            </template>\n                        </section>\n                    </template>\n\n                    <!-- Recent activity -->\n                    <section class=\"rr-card rr-list-card\" aria-label=\"Recent activity\">\n                        <div class=\"rr-card-hd\"><h2 class=\"rr-h2\">Recent activity</h2><span class=\"rr-weak rr-small rr-hide-narrow\">Last 50 events, every release</span><span class=\"rr-grow\"></span>\n                            <button type=\"button\" class=\"rr-link\" onclick={openReleases}>Releases ›</button></div>\n                        <template lwc:if={hasActivity}>\n                            <div class=\"rr-toolbar\">\n                                <c-rly-search-box data-list=\"activity\" label=\"Search recent activity\" placeholder=\"Search release, event, org or who\"\n                                    shown={actShown} total={actTotal} onsearch={handleActSearch}></c-rly-search-box>\n                                <div class=\"rr-chips\" role=\"group\" aria-label=\"Show events\">\n                                    <template for:each={chips} for:item=\"c\">\n                                        <button key={c.id} type=\"button\" class={c.cls} data-id={c.id} onclick={pickChip} aria-pressed={c.pressed}>{c.label} <i>{c.count}</i></button>\n                                    </template>\n                                </div>\n                            </div>\n                            <div class=\"rr-scroll rr-scroll-activity\">\n                                <table class=\"rr-ft\">\n                                    <template lwc:if={narrow}>\n                                        <colgroup><col class=\"rr-w-34\"><col><col class=\"rr-w-64\"></colgroup>\n                                        <thead><tr><th scope=\"col\"><span class=\"slds-assistive-text\">Kind</span></th><th scope=\"col\">Release · event</th><th scope=\"col\" class=\"rr-r\">When</th></tr></thead>\n                                    </template>\n                                    <template lwc:else>\n                                        <colgroup><col class=\"rr-w-40\"><col class=\"rr-w-108\"><col><col class=\"rr-w-96\"><col class=\"rr-w-136\"><col class=\"rr-w-156\"></colgroup>\n                                        <thead><tr><th scope=\"col\"><span class=\"slds-assistive-text\">Kind</span></th><th scope=\"col\">Release</th><th scope=\"col\">Event</th><th scope=\"col\">Org</th><th scope=\"col\">Who</th><th scope=\"col\" class=\"rr-r\">When ▼</th></tr></thead>\n                                    </template>\n                                    <tbody>\n                                        <template for:each={activityRows} for:item=\"a\">\n                                            <tr key={a.key}>\n                                                <td class=\"rr-c\"><span class={a.iconCls}><lightning-icon icon-name={a.icon} size=\"xx-small\" alternative-text={a.iconAlt}></lightning-icon></span></td>\n                                                <template lwc:if={narrow}>\n                                                    <td title={a.eventText}>\n                                                        <span class=\"rr-line\"><button type=\"button\" class=\"rr-rel\" data-id={a.releaseId} onclick={openRelease}><template for:each={a.nameParts} for:item=\"g\"><template lwc:if={g.hit}><mark key={g.key}>{g.text}</mark></template><template lwc:else><span key={g.key}>{g.text}</span></template></template></button> <b><template for:each={a.labelParts} for:item=\"h\"><template lwc:if={h.hit}><mark key={h.key}>{h.text}</mark></template><template lwc:else><span key={h.key}>{h.text}</span></template></template></b></span>\n                                                        <span class=\"rr-line rr-sub\"><template for:each={a.narrowDetailParts} for:item=\"i\"><template lwc:if={i.hit}><mark key={i.key}>{i.text}</mark></template><template lwc:else><span key={i.key}>{i.text}</span></template></template></span>\n                                                    </td>\n                                                    <td class=\"rr-r rr-weak\">{a.whenShort}</td>\n                                                </template>\n                                                <template lwc:else>\n                                                    <td><button type=\"button\" class=\"rr-rel\" data-id={a.releaseId} onclick={openRelease}><template for:each={a.nameParts} for:item=\"j\"><template lwc:if={j.hit}><mark key={j.key}>{j.text}</mark></template><template lwc:else><span key={j.key}>{j.text}</span></template></template></button></td>\n                                                    <td title={a.eventText}><b><template for:each={a.labelParts} for:item=\"k\"><template lwc:if={k.hit}><mark key={k.key}>{k.text}</mark></template><template lwc:else><span key={k.key}>{k.text}</span></template></template></b><template for:each={a.detailParts} for:item=\"l\"><template lwc:if={l.hit}><mark key={l.key}>{l.text}</mark></template><template lwc:else><span key={l.key}>{l.text}</span></template></template></td>\n                                                    <td title={a.orgName}><template for:each={a.orgParts} for:item=\"m\"><template lwc:if={m.hit}><mark key={m.key}>{m.text}</mark></template><template lwc:else><span key={m.key}>{m.text}</span></template></template></td>\n                                                    <td title={a.who}><template for:each={a.whoParts} for:item=\"n\"><template lwc:if={n.hit}><mark key={n.key}>{n.text}</mark></template><template lwc:else><span key={n.key}>{n.text}</span></template></template></td>\n                                                    <td class=\"rr-r rr-weak\">{a.when}</td>\n                                                </template>\n                                            </tr>\n                                        </template>\n                                        <template lwc:if={actNoMatch}>\n                                            <tr><td colspan=\"6\" class=\"rr-nomatch\">{actNoMatchText}\n                                                <template lwc:if={actSearching}> <button type=\"button\" class=\"rr-linkbtn\" onclick={clearActSearch}>Clear search</button></template></td></tr>\n                                        </template>\n                                    </tbody>\n                                </table>\n                            </div>\n                            <div class=\"rr-lfoot\"><span>Newest first · the last 50 events</span></div>\n                        </template>\n                        <template lwc:else>\n                            <div class=\"rr-pad\"><div class=\"rr-empty\"><b>No releases yet.</b><span>Raise the first one from a developer org.</span>\n                                <lightning-button variant=\"brand\" label=\"New release\" onclick={openNewRelease}></lightning-button></div></div>\n                        </template>\n                    </section>\n                </template>\n            </div>\n        </template>\n    </template>\n</template>"}
