{"path":"force-app/main/default/lwc/rlySlackLink/rlySlackLink.html","left":null,"right":"<template>\n    <div class=\"rr-page\">\n        <section class=\"rr-card\">\n            <div class=\"rr-head\">\n                <h1 class=\"rr-title rr-grow\">Link your Slack account</h1>\n                <span class=\"rr-pill rr-pill-info\">From Slack</span>\n            </div>\n            <div class=\"rr-body\">\n                <template lwc:if={loading}><lightning-spinner alternative-text=\"Loading\" size=\"small\"></lightning-spinner></template>\n                <template lwc:if={error}><div class=\"rr-msg rr-msg-bad\" role=\"alert\">{error}</div></template>\n\n                <template lwc:if={isReady}>\n                    <p class=\"rr-q\">{question}</p>\n                    <div class=\"rr-pair\">\n                        <div class=\"rr-acct\">\n                            <p class=\"rr-kicker\">Slack</p>\n                            <strong>{slackName}</strong>\n                            <span class=\"rr-small\">{slackEmail}</span>\n                            <span class=\"rr-mono\">{memberId}</span>\n                        </div>\n                        <span class=\"rr-arrow\" aria-hidden=\"true\">→</span>\n                        <div class=\"rr-acct\">\n                            <p class=\"rr-kicker\">Salesforce (you)</p>\n                            <strong>{meLine}</strong>\n                            <span class=\"rr-small\">{meLogin}</span>\n                            <span class={matchCls}>{matchNote}</span>\n                        </div>\n                    </div>\n                    <template lwc:if={replacesText}><div class=\"rr-msg rr-msg-wait\" role=\"status\">{replacesText}</div></template>\n                    <p class=\"rr-hint\">After linking, Approve and Reject in Slack count as you. An admin can see and remove the link.</p>\n                </template>\n\n                <template lwc:if={isLinked}>\n                    <div class=\"rr-msg rr-msg-ok\" role=\"status\">\n                        <strong>✓ {linkedText}</strong>\n                        <template lwc:if={hasRelease}> <button type=\"button\" class=\"rr-linkbtn\" onclick={openRelease}>Open the release</button> to approve here instead.</template>\n                    </div>\n                </template>\n\n                <template lwc:if={isCancelled}>\n                    <div class=\"rr-msg rr-msg-info\" role=\"status\">Nothing was linked. If this isn't your Slack account, close this tab; the link works only for 15 minutes.</div>\n                </template>\n\n                <template lwc:if={isRefused}>\n                    <div class=\"rr-msg rr-msg-bad\" role=\"alert\">{refusedText}</div>\n                </template>\n            </div>\n            <template lwc:if={isReady}>\n                <div class=\"rr-foot\">\n                    <span class=\"rr-hint rr-grow\">{expiresText}</span>\n                    <lightning-button label=\"Not me\" onclick={handleNotMe} disabled={saving}></lightning-button>\n                    <lightning-button variant=\"brand\" label={linkLabel} onclick={handleLink} disabled={saving}></lightning-button>\n                </div>\n            </template>\n        </section>\n    </div>\n</template>"}
