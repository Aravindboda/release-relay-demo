{"path":"force-app/main/default/lwc/rlyDiffView/rlyDiffView.html","left":null,"right":"<template>\n    <section class=\"rr-dv\" aria-label={title}>\n        <!-- header: file path, +n −n, optional link, Split / Unified -->\n        <div class=\"rr-dvh\">\n            <b class=\"rr-path\" title={title}>{title}</b>\n            <span class=\"rr-cnt\" aria-label={countsLabel}>\n                <template lwc:if={showAdded}><span class=\"rr-plus\">{addedText}</span></template>\n                <template lwc:if={showRemoved}><span class=\"rr-minus\">{removedText}</span></template>\n            </span>\n            <span class=\"rr-grow\"></span>\n            <template lwc:if={linkUrl}><a class=\"rr-link\" href={linkUrl} target=\"_blank\" rel=\"noopener\">{linkLabel}</a></template>\n            <span class=\"rr-seg\" role=\"group\" aria-label=\"View\">\n                <button type=\"button\" class={splitCls} aria-pressed={splitPressed} onclick={showSplit}>Split</button>\n                <button type=\"button\" class={unifiedCls} aria-pressed={unifiedPressed} onclick={showUnified}>Unified</button>\n            </span>\n        </div>\n        <slot name=\"subheader\"></slot>\n\n        <template lwc:if={tooLarge}>\n            <div class=\"rr-empty\" role=\"status\"><span class=\"rr-pill rr-pill-none\">Not available</span><p>{tooLargeText}</p></div>\n        </template>\n        <template lwc:elseif={noDifferences}>\n            <div class=\"rr-empty\" role=\"status\"><span class=\"rr-pill rr-pill-none\">Same</span><p>{sameText}</p></div>\n        </template>\n        <template lwc:elseif={isEmpty}>\n            <div class=\"rr-empty\" role=\"status\"><p>{emptyText}</p></div>\n        </template>\n        <template lwc:else>\n            <template lwc:if={isNew}>\n                <div class=\"rr-nf\" role=\"status\"><span class=\"rr-pill rr-pill-ok\">New file</span><span class=\"rr-small rr-weak\">{newText}</span></div>\n            </template>\n            <template lwc:if={isDeleted}>\n                <div class=\"rr-nf\" role=\"status\"><span class=\"rr-pill rr-pill-bad\">Deleted file</span><span class=\"rr-small rr-weak\">{deletedText}</span></div>\n            </template>\n\n            <template lwc:if={isSplit}>\n                <div class=\"rr-sbs\">\n                    <div class=\"rr-sbh\"><span class=\"rr-pill rr-pill-none\">Target</span><b>{leftLabel}</b></div>\n                    <div class=\"rr-sbh\"><span class=\"rr-pill rr-pill-src\">Source</span><b>{rightLabel}</b></div>\n                    <!-- left: the target -->\n                    <div class=\"rr-scr\">\n                        <table class=\"rr-df\" aria-label={leftName}>\n                            <tbody>\n                                <template for:each={splitRowsShown} for:item=\"row\">\n                                    <template lwc:if={row.isLine}>\n                                        <tr key={row.key} class={row.l.rowCls}>\n                                            <td class=\"rr-n\">{row.l.no}</td>\n                                            <td class=\"rr-g\">{row.l.sign}</td>\n                                            <td class=\"rr-c\">{row.l.pre}<template lwc:if={row.l.mark}><mark class=\"rr-mk\">{row.l.mark}</mark></template>{row.l.post}</td>\n                                        </tr>\n                                    </template>\n                                    <template lwc:elseif={row.isFold}>\n                                        <tr key={row.key} class=\"rr-fold\">\n                                            <td colspan=\"3\"><button type=\"button\" class=\"rr-fold-btn\" data-id={row.foldId} onclick={openFold} title=\"Show these lines\">{row.text}</button></td>\n                                        </tr>\n                                    </template>\n                                    <template lwc:else>\n                                        <tr key={row.key} class=\"rr-hunk\"><td colspan=\"3\" class=\"rr-c rr-hunk-text\">{row.text}</td></tr>\n                                    </template>\n                                </template>\n                            </tbody>\n                        </table>\n                    </div>\n                    <!-- right: the source -->\n                    <div class=\"rr-scr\">\n                        <table class=\"rr-df\" aria-label={rightName}>\n                            <tbody>\n                                <template for:each={splitRowsShown} for:item=\"row\">\n                                    <template lwc:if={row.isLine}>\n                                        <tr key={row.key} class={row.r.rowCls}>\n                                            <td class=\"rr-n\">{row.r.no}</td>\n                                            <td class=\"rr-g\">{row.r.sign}</td>\n                                            <td class=\"rr-c\">{row.r.pre}<template lwc:if={row.r.mark}><mark class=\"rr-mk\">{row.r.mark}</mark></template>{row.r.post}</td>\n                                        </tr>\n                                    </template>\n                                    <template lwc:elseif={row.isFold}>\n                                        <tr key={row.key} class=\"rr-fold\"><td colspan=\"3\"><span class=\"rr-fold-btn\">&nbsp;</span></td></tr>\n                                    </template>\n                                    <template lwc:else>\n                                        <tr key={row.key} class=\"rr-hunk\"><td colspan=\"3\" class=\"rr-c\">&nbsp;</td></tr>\n                                    </template>\n                                </template>\n                            </tbody>\n                        </table>\n                    </div>\n                </div>\n            </template>\n            <template lwc:else>\n                <div class=\"rr-scr\">\n                    <table class=\"rr-df rr-uni\" aria-label={title}>\n                        <tbody>\n                            <template for:each={unifiedRowsShown} for:item=\"row\">\n                                <template lwc:if={row.isLine}>\n                                    <tr key={row.key} class={row.rowCls}>\n                                        <td class=\"rr-n\">{row.oldNo}</td>\n                                        <td class=\"rr-n\">{row.newNo}</td>\n                                        <td class=\"rr-g\">{row.sign}</td>\n                                        <td class=\"rr-c\">{row.pre}<template lwc:if={row.mark}><mark class=\"rr-mk\">{row.mark}</mark></template>{row.post}</td>\n                                    </tr>\n                                </template>\n                                <template lwc:elseif={row.isFold}>\n                                    <tr key={row.key} class=\"rr-fold\">\n                                        <td colspan=\"4\"><button type=\"button\" class=\"rr-fold-btn\" data-id={row.foldId} onclick={openFold} title=\"Show these lines\">{row.text}</button></td>\n                                    </tr>\n                                </template>\n                                <template lwc:else>\n                                    <tr key={row.key} class=\"rr-hunk\"><td class=\"rr-n\"></td><td class=\"rr-n\"></td><td colspan=\"2\" class=\"rr-c rr-hunk-text\">{row.text}</td></tr>\n                                </template>\n                            </template>\n                        </tbody>\n                    </table>\n                </div>\n            </template>\n        </template>\n    </section>\n</template>"}
