{"path":"force-app/main/default/lwc/rlyStepFiles/rlyStepFiles.html","left":null,"right":"<template>\n    <!-- board HubStepFiles 1-4: step files and proof per org; 6: narrow (icon buttons, no who column) -->\n    <div class={wrapCls} role=\"group\" aria-label={groupLabel}>\n        <template lwc:if={showHead}>\n        <div class=\"rr-sf-hd\">\n            <template lwc:if={label}><span class=\"rr-sf-label\">{label}</span></template>\n            <template lwc:if={showCount}><span class=\"rr-pill rr-pill-none\">{count}</span></template>\n            <template lwc:if={locked}><span class=\"rr-pill rr-pill-lock\" title={lockText} tabindex=\"0\" aria-label={lockAria}>🔒 Locked: approved files</span></template>\n            <template lwc:if={showEmpty}><span class=\"rr-hint\">{emptyText}</span></template>\n        </div>\n        </template>\n        <template lwc:if={hasFiles}>\n            <ul class=\"rr-sf-list\">\n                <template for:each={rows} for:item=\"f\">\n                    <li key={f.key} class=\"rr-sf-row\">\n                        <span class={f.badgeCls} aria-hidden=\"true\">{f.badge}</span>\n                        <span class=\"rr-sf-name\" title={f.title}>{f.title}</span>\n                        <span class=\"rr-sf-size\">{f.sizeText}</span>\n                        <span class=\"rr-sf-who\" title={f.whoTitle}>{f.createdBy}</span>\n                        <span class=\"rr-sf-act\">\n                            <template lwc:if={f.previewable}>\n                                <lightning-button class=\"rr-wide\" label=\"Preview\" title={f.previewLabel} data-id={f.documentId} onclick={preview}></lightning-button>\n                                <lightning-button-icon class=\"rr-narrow\" icon-name=\"utility:preview\" variant=\"border-filled\" alternative-text={f.previewLabel}\n                                    title={f.previewLabel} data-id={f.documentId} onclick={preview}></lightning-button-icon>\n                            </template>\n                            <lightning-button class=\"rr-wide\" label=\"Download\" title={f.downloadLabel} data-id={f.documentId} onclick={download}></lightning-button>\n                            <lightning-button-icon class=\"rr-narrow\" icon-name=\"utility:download\" variant=\"border-filled\" alternative-text={f.downloadLabel}\n                                title={f.downloadLabel} data-id={f.documentId} onclick={download}></lightning-button-icon>\n                            <template lwc:if={f.canRemove}>\n                                <lightning-button-icon icon-name=\"utility:close\" variant=\"border-filled\" alternative-text={f.removeLabel} title={f.removeLabel}\n                                    data-id={f.documentId} onclick={remove} disabled={disabled}></lightning-button-icon>\n                            </template>\n                        </span>\n                    </li>\n                </template>\n            </ul>\n        </template>\n        <template lwc:if={showUpload}>\n            <div class=\"rr-sf-up\">\n                <lightning-file-upload label={uploadLabel} name=\"rlyStepFile\" record-id={recordId} multiple onuploadfinished={handleUpload}\n                    disabled={disabled}></lightning-file-upload>\n                <p class=\"rr-hint\">{uploadHint}</p>\n            </div>\n        </template>\n    </div>\n</template>"}
