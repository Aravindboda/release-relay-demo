{"path":"force-app/main/default/lwc/ihHowTo/ihHowTo.html","left":null,"right":"<template>\n    <div class=\"ih-page\">\n        <section class=\"ih-hero\">\n            <span class=\"ih-hero-icon\">\n                <lightning-icon icon-name=\"utility:knowledge_base\" size=\"small\" variant=\"inverse\" alternative-text=\"\"></lightning-icon>\n            </span>\n            <div class=\"ih-hero-text\">\n                <span class=\"ih-eyebrow\">Integration Hub</span>\n                <h1>How to use it</h1>\n                <p>Set up, build, give the middleware its contracts, then run and fix. Pick a topic on the left, or answer six questions to see which options you need.</p>\n            </div>\n            <div class=\"ih-hero-actions\">\n                <lightning-button label=\"Which option do I need?\" icon-name=\"utility:question\" onclick={handleOpenChooser}></lightning-button>\n                <a class=\"slds-button slds-button_neutral pdf\" href={pdfUrl} target=\"_blank\" download=\"IntegrationHub_HowTo.pdf\" title=\"The whole How To as one PDF book\">\n                    <lightning-icon icon-name=\"utility:download\" size=\"x-small\" class=\"slds-button__icon_left\" alternative-text=\"\"></lightning-icon>\n                    Download as PDF\n                </a>\n            </div>\n        </section>\n\n        <div class={wideClass}>\n            <template lwc:if={showIndex}>\n                <nav class=\"ih-card index\" aria-label=\"How To topics\">\n                    <lightning-input type=\"search\" label=\"Search How To\" variant=\"label-hidden\" placeholder=\"Search How To...\"\n                        value={query} onchange={handleSearch}></lightning-input>\n                    <template lwc:if={noMatch}>\n                        <p class=\"ih-small no-match\">No topic matches. Try another word.</p>\n                    </template>\n                    <ol class=\"groups\">\n                        <template for:each={groups} for:item=\"g\">\n                            <li key={g.key} class={g.cls}>\n                                <button class=\"g-head\" data-key={g.firstKey} onclick={handlePick}>\n                                    <span class=\"g-badge\">\n                                        <template lwc:if={g.showTick}>&#10003;</template>\n                                        <template lwc:else>{g.badge}</template>\n                                    </span>\n                                    <span class=\"g-name\">{g.name}</span>\n                                </button>\n                                <ul class=\"topics\">\n                                    <template for:each={g.topics} for:item=\"t\">\n                                        <li key={t.key}>\n                                            <button class={t.cls} data-key={t.key} onclick={handlePick} aria-current={t.ariaCurrent}>\n                                                <span class=\"dot\"></span>\n                                                <span>{t.label}</span>\n                                            </button>\n                                        </li>\n                                    </template>\n                                </ul>\n                            </li>\n                        </template>\n                    </ol>\n                    <div class=\"progress\">\n                        <span class=\"ih-small\">{progressText}</span>\n                        <button class=\"ih-link reset\" onclick={handleResetProgress}>Reset</button>\n                    </div>\n                </nav>\n            </template>\n\n            <article class=\"ih-card pane\">\n                <template lwc:if={narrow}>\n                    <div class=\"combo\">\n                        <lightning-combobox label=\"Topic\" value={currentKey} options={topicOptions} onchange={handleCombo}></lightning-combobox>\n                    </div>\n                </template>\n\n                <div class=\"crumb ih-small\">{topic.crumb}</div>\n                <h2 class=\"title\">{topic.title}</h2>\n                <template lwc:if={topic.hasLead}>\n                    <p class=\"lead\">{topic.lead}</p>\n                </template>\n\n                <template lwc:if={topic.hasUsage}>\n                    <c-ih-usage view={topic.usage} info={usageInfo}></c-ih-usage>\n                </template>\n\n                <template lwc:if={topic.hasPoints}>\n                    <ul class=\"points\">\n                        <template for:each={topic.points} for:item=\"p\">\n                            <li key={p.key}>{p.text}</li>\n                        </template>\n                    </ul>\n                </template>\n\n                <template lwc:if={topic.hasTables}>\n                    <template for:each={topic.tables} for:item=\"tb\">\n                        <div key={tb.key} class=\"block\">\n                            <template lwc:if={tb.hasTitle}>\n                                <h3 class=\"block-title\">{tb.title}</h3>\n                            </template>\n                            <div class=\"ih-table-wrap table-box\">\n                                <table class=\"ih-table\">\n                                    <thead>\n                                        <tr>\n                                            <template for:each={tb.cols} for:item=\"c\">\n                                                <th key={c.key} scope=\"col\">{c.label}</th>\n                                            </template>\n                                        </tr>\n                                    </thead>\n                                    <tbody>\n                                        <template for:each={tb.rows} for:item=\"r\">\n                                            <tr key={r.key}>\n                                                <template for:each={r.cells} for:item=\"cell\">\n                                                    <td key={cell.key} class={cell.cls}>{cell.text}</td>\n                                                </template>\n                                            </tr>\n                                        </template>\n                                    </tbody>\n                                </table>\n                            </div>\n                        </div>\n                    </template>\n                </template>\n\n                <template lwc:if={topic.hasCodes}>\n                    <template for:each={topic.codes} for:item=\"c\">\n                        <div key={c.key} class=\"block\">\n                            <div class=\"code-head\">\n                                <h3 class=\"block-title\">{c.label}</h3>\n                                <lightning-button label=\"Copy\" variant=\"base\" icon-name=\"utility:copy\" data-key={c.key}\n                                    onclick={handleCopy}></lightning-button>\n                            </div>\n                            <pre class=\"ih-pre\">{c.code}</pre>\n                        </div>\n                    </template>\n                </template>\n\n                <template lwc:if={topic.hasImages}>\n                    <div class=\"pictures\">\n                        <template for:each={topic.pictures} for:item=\"img\">\n                            <figure key={img.key} class=\"picture\">\n                                <img src={img.src} alt={img.caption} loading=\"lazy\">\n                                <figcaption class=\"ih-small\">{img.caption}</figcaption>\n                            </figure>\n                        </template>\n                    </div>\n                </template>\n\n                <template lwc:if={topic.isChooser}>\n                    <div class=\"chooser\">\n                        <template for:each={questions} for:item=\"q\">\n                            <div key={q.key} class=\"question\">\n                                <lightning-radio-group name={q.key} label={q.label} options={yesNo} value={q.value} type=\"button\"\n                                    data-key={q.key} onchange={handleAnswer}></lightning-radio-group>\n                            </div>\n                        </template>\n                        <template lwc:if={hasChooserRows}>\n                            <div class=\"block\">\n                                <h3 class=\"block-title\">What to set</h3>\n                                <div class=\"ih-table-wrap table-box\">\n                                    <table class=\"ih-table\">\n                                        <thead><tr><th scope=\"col\">Set this</th><th scope=\"col\">Read more</th></tr></thead>\n                                        <tbody>\n                                            <template for:each={chooserRows} for:item=\"r\">\n                                                <tr key={r.key}>\n                                                    <td class=\"cell\">{r.field}</td>\n                                                    <td class=\"cell\">\n                                                        <template lwc:if={r.hasTopic}>\n                                                            <button class=\"ih-link\" data-key={r.topicKey} onclick={handlePick}>{r.topicLabel}</button>\n                                                        </template>\n                                                    </td>\n                                                </tr>\n                                            </template>\n                                        </tbody>\n                                    </table>\n                                </div>\n                            </div>\n                            <template lwc:if={chooserDone}>\n                                <p class=\"ih-small\">Every event also needs a connection (Set up › Connection) and, for outbound, one publish line in your trigger handler (Build › Publish from a trigger).</p>\n                            </template>\n                            <div>\n                                <lightning-button label=\"Start again\" variant=\"base\" onclick={handleResetChooser}></lightning-button>\n                            </div>\n                        </template>\n                    </div>\n                </template>\n\n                <template lwc:if={topic.hasDownloads}>\n                    <div class=\"downloads\">\n                        <span class=\"ih-small\">{topic.downloadNote}</span>\n                        <div class=\"download-buttons\">\n                            <template for:each={topic.downloads} for:item=\"d\">\n                                <a key={d.key} class=\"slds-button slds-button_neutral\" href={d.href} download={d.name}>\n                                    <lightning-icon icon-name=\"utility:download\" size=\"x-small\" class=\"slds-button__icon_left\" alternative-text=\"\"></lightning-icon>\n                                    {d.label}\n                                </a>\n                            </template>\n                        </div>\n                    </div>\n                </template>\n\n                <template lwc:if={topic.embedConfigTransfer}>\n                    <div class=\"block\">\n                        <c-ih-config-transfer embedded=\"true\"></c-ih-config-transfer>\n                    </div>\n                </template>\n\n                <template lwc:if={topic.hasTip}>\n                    <p class=\"ih-small tip\">{topic.tip}</p>\n                </template>\n\n                <template lwc:if={topic.hasGo}>\n                    <div class=\"go\">\n                        <lightning-button label={topic.go} icon-name=\"utility:forward\" icon-position=\"right\" data-target={topic.target}\n                            data-kind={topic.kind} onclick={handleGo}></lightning-button>\n                    </div>\n                </template>\n\n                <div class=\"pager\">\n                    <template lwc:if={prevTopic}>\n                        <lightning-button label={prevTopic.label} icon-name=\"utility:chevronleft\" onclick={handlePrev}></lightning-button>\n                    </template>\n                    <span class=\"ih-spacer\"></span>\n                    <template lwc:if={nextTopic}>\n                        <lightning-button label={nextTopic.label} icon-name=\"utility:chevronright\" icon-position=\"right\"\n                            onclick={handleNext}></lightning-button>\n                    </template>\n                </div>\n            </article>\n        </div>\n    </div>\n</template>"}
