{"path":"force-app/main/default/lwc/ihCleanupStatus/ihCleanupStatus.html","left":null,"right":"<template>\n    <section class=\"ih-card\" aria-label=\"Scheduled jobs\">\n        <div class=\"ih-card-head\">\n            <h2 class=\"ih-card-title\">\n                <lightning-icon icon-name=\"utility:clock\" size=\"x-small\" alternative-text=\"\"></lightning-icon>\n                Scheduled jobs\n            </h2>\n        </div>\n        <div class=\"ih-card-body\">\n            <template lwc:if={loading}>\n                <div class=\"ih-spinner\"><lightning-spinner alternative-text=\"Loading\" size=\"small\"></lightning-spinner></div>\n            </template>\n            <template lwc:if={error}>\n                <p class=\"ih-callout ih-callout_bad\">{error}</p>\n            </template>\n\n            <!-- ======================== nightly clean-up -->\n            <div class=\"job-head\">\n                <h3 class=\"sub\">\n                    <lightning-icon icon-name=\"utility:recycle_bin_empty\" size=\"x-small\" alternative-text=\"\"></lightning-icon>\n                    Nightly clean-up\n                </h3>\n                <template lwc:if={status}>\n                    <span class={badgeClass}>{badgeText}</span>\n                </template>\n            </div>\n\n            <template lwc:if={notScheduled}>\n                <p class=\"ih-callout ih-callout_bad\">The clean-up is not scheduled, so old Success transactions are not deleted\n                    and transactions waiting for a callback never time out. A sandbox refresh removes the job: schedule it again.</p>\n                <lightning-button variant=\"brand\" label=\"Schedule clean-up (02:00 daily)\" icon-name=\"utility:clock\"\n                    onclick={handleSchedule} disabled={busy} class=\"action\"></lightning-button>\n                <p class=\"ih-small\">It runs as you, in your time zone. Use a user who stays active.</p>\n            </template>\n\n            <template lwc:if={scheduled}>\n                <dl class=\"facts\">\n                    <dt>Next run</dt>\n                    <dd><lightning-formatted-date-time value={status.nextRun} year=\"numeric\" month=\"short\" day=\"numeric\"\n                        hour=\"numeric\" minute=\"2-digit\"></lightning-formatted-date-time></dd>\n                    <dt>Runs as</dt>\n                    <dd>{status.scheduledBy}</dd>\n                    <dt>State</dt>\n                    <dd>{status.state}</dd>\n                </dl>\n            </template>\n\n            <template lwc:if={status}>\n                <h4 class=\"sub sub_small\">Last run</h4>\n                <template lwc:if={hasLastRun}>\n                    <dl class=\"facts\">\n                        <dt>Finished</dt>\n                        <dd><lightning-formatted-date-time value={status.lastFinished} year=\"numeric\" month=\"short\" day=\"numeric\"\n                            hour=\"numeric\" minute=\"2-digit\"></lightning-formatted-date-time></dd>\n                        <dt>Deleted</dt>\n                        <dd>{deletedText} Success transaction(s) past retention</dd>\n                        <dt>Timed out</dt>\n                        <dd>{timedOutText} transaction(s) set to Failed: no callback in time</dd>\n                    </dl>\n                </template>\n                <template lwc:else>\n                    <p class=\"ih-small\">No run has finished yet.</p>\n                </template>\n                <template lwc:if={lastRunMissing}>\n                    <p class=\"ih-callout\">The last start has not saved a result yet: it is still running, or it failed.\n                        See Setup &gt; Apex Jobs.</p>\n                </template>\n            </template>\n\n            <p class=\"ih-small note\">Deletes only Success transactions older than the event's Retention (days); an event with a\n                blank Retention keeps them. Failed, Abandoned and Sent transactions are never deleted.</p>\n\n            <!-- ======================== auto-retry -->\n            <div class=\"job-head gap\">\n                <h3 class=\"sub\">\n                    <lightning-icon icon-name=\"utility:refresh\" size=\"x-small\" alternative-text=\"\"></lightning-icon>\n                    Auto-retry (every 15 minutes)\n                </h3>\n                <template lwc:if={status}>\n                    <span class={autoRetryBadgeClass}>{autoRetryBadgeText}</span>\n                </template>\n            </div>\n\n            <template lwc:if={autoRetryMissing}>\n                <p class=\"ih-callout ih-callout_bad\">Auto-retry is not fully scheduled, so temporary failures waiting for an\n                    automatic retry are not sent again. A sandbox refresh removes the jobs: schedule them again.</p>\n                <lightning-button variant=\"brand\" label=\"Schedule auto-retry (every 15 minutes)\" icon-name=\"utility:clock\"\n                    onclick={handleScheduleAutoRetry} disabled={busy} class=\"action\"></lightning-button>\n                <p class=\"ih-small\">Four jobs, at :00, :15, :30 and :45. They run as you; use a user who stays active.</p>\n            </template>\n\n            <template lwc:if={status}>\n                <dl class=\"facts\">\n                    <template lwc:if={autoRetryAll}>\n                        <dt>Next check</dt>\n                        <dd><lightning-formatted-date-time value={status.autoRetryNextRun} month=\"short\" day=\"numeric\"\n                            hour=\"numeric\" minute=\"2-digit\"></lightning-formatted-date-time></dd>\n                    </template>\n                    <dt>Waiting</dt>\n                    <dd>{waitingText} Failed transaction(s) waiting for auto-retry</dd>\n                    <template lwc:if={hasWaiting}>\n                        <dt>Next retry</dt>\n                        <dd><lightning-formatted-date-time value={status.nextRetryAt} month=\"short\" day=\"numeric\"\n                            hour=\"numeric\" minute=\"2-digit\"></lightning-formatted-date-time></dd>\n                    </template>\n                </dl>\n            </template>\n\n            <p class=\"ih-small note\">Only temporary failures (408, 429, 5xx, timeouts) of events with Auto Retry Max are retried,\n                after Retry After minutes, doubled each time. Permanent rejections are never resent automatically.</p>\n        </div>\n    </section>\n</template>"}
