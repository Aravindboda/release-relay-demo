{"path":"force-app/main/default/lwc/ihSetupEditor/ihSetupEditor.html","left":null,"right":"<template>\n    <section class=\"ih-card shell\" aria-label={objectLabel}>\n        <template lwc:if={loading}>\n            <div class=\"ih-spinner\"><lightning-spinner alternative-text=\"Loading\" size=\"small\"></lightning-spinner></div>\n        </template>\n        <template lwc:elseif={loadError}>\n            <p class=\"ih-error\" role=\"alert\">{loadError}</p>\n        </template>\n\n        <!-- ============================================================ no access to create -->\n        <template lwc:elseif={showNoAccess}>\n            <div class=\"ih-card-body\">\n                <p class=\"ih-callout ih-callout_info\">Integration Hub Admin permission is needed to set up connections and events.</p>\n                <div class=\"ih-row\"><lightning-button label=\"Close\" onclick={handleCancel}></lightning-button></div>\n            </div>\n        </template>\n\n        <!-- ============================================================ guided create / edit -->\n        <template lwc:elseif={showEditor}>\n            <div class=\"ih-card-head editor-head\">\n                <h2 class=\"ih-card-title\">{editorTitle}</h2>\n            </div>\n            <div class=\"layout\">\n                <div class=\"main\">\n                    <ol class=\"stepper\">\n                        <template for:each={stepItems} for:item=\"item\">\n                            <li key={item.key} class=\"stepper-item\">\n                                <button type=\"button\" class={item.cls} data-index={item.index} onclick={handleStep}\n                                    aria-current={item.ariaCurrent}>\n                                    <span class=\"step-dot\">\n                                        <template lwc:if={item.showCheck}>\n                                            <lightning-icon icon-name=\"utility:check\" size=\"xx-small\" variant=\"inverse\"\n                                                alternative-text=\"Done\"></lightning-icon>\n                                        </template>\n                                        <template lwc:if={item.showNumber}>{item.number}</template>\n                                    </span>\n                                    <span class=\"step-label\">{item.label}</span>\n                                </button>\n                                <template lwc:if={item.showLine}>\n                                    <span class={item.lineCls} aria-hidden=\"true\"></span>\n                                </template>\n                            </li>\n                        </template>\n                    </ol>\n\n                    <template lwc:if={currentStepErrors}>\n                        <div class=\"ih-callout ih-callout_bad step-error\" role=\"alert\">\n                            <lightning-icon icon-name=\"utility:error\" size=\"x-small\" alternative-text=\"Error\"></lightning-icon>\n                            <div>\n                                <template for:each={currentStepErrors} for:item=\"line\">\n                                    <p key={line.key}>{line.text}</p>\n                                </template>\n                            </div>\n                        </div>\n                    </template>\n\n                    <!-- ======================== EVENT step 1: Basics -->\n                    <template lwc:if={ev.s0}>\n                        <div class=\"fields\">\n                            <div class=\"fld\">\n                                <lightning-input label={f.Name.label} value={values.Name} data-field=\"Name\" onchange={handleChange}\n                                    required={f.Name.required} max-length=\"80\"></lightning-input>\n                                <p class=\"hint\">{f.Name.help}</p>\n                            </div>\n                            <div class=\"fld\">\n                                <lightning-input label={f.Event_Key__c.label} value={values.Event_Key__c} data-field=\"Event_Key__c\"\n                                    onchange={handleChange} required={f.Event_Key__c.required} class=\"ih-mono\"></lightning-input>\n                                <p class=\"hint\">{f.Event_Key__c.help}</p>\n                            </div>\n                            <div class=\"fld\">\n                                <lightning-radio-group label={f.Direction__c.label} options={f.Direction__c.options} type=\"button\"\n                                    value={values.Direction__c} data-field=\"Direction__c\" onchange={handleChange}></lightning-radio-group>\n                                <p class=\"hint\">{f.Direction__c.help}</p>\n                            </div>\n                            <div class=\"fld\">\n                                <lightning-record-picker label={f.Connection__c.label} object-api-name=\"IH_Connection__c\"\n                                    placeholder=\"Search connections…\" value={values.Connection__c} data-field=\"Connection__c\"\n                                    onchange={handleChange} required={f.Connection__c.required}></lightning-record-picker>\n                                <p class=\"hint\">{f.Connection__c.help}</p>\n                            </div>\n                            <template lwc:if={show.Related_Object__c}>\n                                <div class=\"fld fld_wide\">\n                                    <template lwc:if={useRelatedCombo}>\n                                        <lightning-combobox label={f.Related_Object__c.label} options={relatedObjectOptions}\n                                            value={relatedComboValue} placeholder=\"Choose the object…\" onchange={handleRelatedObject}\n                                            required={f.Related_Object__c.required}></lightning-combobox>\n                                    </template>\n                                    <template lwc:else>\n                                        <lightning-input label={f.Related_Object__c.label} value={values.Related_Object__c}\n                                            placeholder=\"API name, e.g. Voucher__c\" onchange={handleRelatedObject}\n                                            required={f.Related_Object__c.required} class=\"ih-mono\"></lightning-input>\n                                    </template>\n                                    <template lwc:if={relatedLine}>\n                                        <p class=\"hint hint_strong\">{relatedLine}</p>\n                                    </template>\n                                    <p class=\"hint\">{f.Related_Object__c.help}\n                                        <template lwc:if={showRelatedToggle}>\n                                            <button type=\"button\" class=\"linkish\" onclick={handleRelatedToggle}>{relatedToggleLabel}</button>\n                                        </template>\n                                    </p>\n                                </div>\n                            </template>\n                            <template lwc:if={show.Share_With_Related_Record__c}>\n                                <div class=\"fld\">\n                                    <lightning-input type=\"checkbox\" label={f.Share_With_Related_Record__c.label}\n                                        checked={flags.Share_With_Related_Record__c} data-field=\"Share_With_Related_Record__c\"\n                                        onchange={handleChange}></lightning-input>\n                                    <p class=\"hint\">{f.Share_With_Related_Record__c.help}</p>\n                                </div>\n                            </template>\n                            <template lwc:if={show.Active__c}>\n                                <div class=\"fld\">\n                                    <lightning-input type=\"checkbox\" label={f.Active__c.label} checked={flags.Active__c}\n                                        data-field=\"Active__c\" onchange={handleChange}></lightning-input>\n                                    <p class=\"hint\">{f.Active__c.help}</p>\n                                </div>\n                            </template>\n                            <template lwc:else>\n                                <div class=\"fld\">\n                                    <p class=\"label-like\">{f.Active__c.label}</p>\n                                    <p class=\"hint\">No: a new event is saved inactive. Activate it after Check endpoint and Preview payload.</p>\n                                </div>\n                            </template>\n                            <div class=\"fld fld_wide\">\n                                <lightning-textarea label={f.Description__c.label} value={values.Description__c}\n                                    data-field=\"Description__c\" onchange={handleChange}></lightning-textarea>\n                                <p class=\"hint\">{f.Description__c.help}</p>\n                            </div>\n                        </div>\n                    </template>\n\n                    <!-- ======================== EVENT step 2: What to send -->\n                    <template lwc:if={ev.s1}>\n                        <div class=\"fields\">\n                            <template lwc:if={isOutbound}>\n                                <div class=\"fld fld_wide\">\n                                    <lightning-input label={f.Path__c.label} value={values.Path__c} data-field=\"Path__c\"\n                                        placeholder={pathPlaceholder} onchange={handleChange}\n                                        required={f.Path__c.required} class=\"ih-mono\"></lightning-input>\n                                    <p class=\"hint\">{pathHint}\n                                        <template lwc:if={pathState}>\n                                            <span class={pathStateClass}>{pathState.text}</span>\n                                        </template>\n                                    </p>\n                                    <p class=\"hint\">{f.Path__c.help}</p>\n                                </div>\n                                <div class=\"fld\">\n                                    <lightning-combobox label={f.Http_Method__c.label} options={f.Http_Method__c.options}\n                                        value={values.Http_Method__c} data-field=\"Http_Method__c\" onchange={handleChange}></lightning-combobox>\n                                    <p class=\"hint\">{f.Http_Method__c.help}</p>\n                                </div>\n                                <div class=\"fld\">\n                                    <lightning-radio-group label={f.Payload_Source__c.label} options={f.Payload_Source__c.options}\n                                        type=\"radio\" value={values.Payload_Source__c} data-field=\"Payload_Source__c\"\n                                        onchange={handleChange}></lightning-radio-group>\n                                    <p class=\"hint\">{f.Payload_Source__c.help}</p>\n                                </div>\n                                <template lwc:if={show.Payload_Fields__c}>\n                                    <div class=\"fld fld_wide\">\n                                        <p class=\"label-like\">{f.Payload_Fields__c.label} · pick fields, including parent fields</p>\n                                        <c-ih-setup-field-picker options={fieldOpts} object-label={fieldPickerLabel}\n                                            loading={fieldsLoading} error={fieldsError} value={values.Payload_Fields__c}\n                                            data-field=\"Payload_Fields__c\" onchange={handleChange}></c-ih-setup-field-picker>\n                                        <p class=\"hint\">{f.Payload_Fields__c.help}</p>\n                                    </div>\n                                </template>\n                                <template lwc:if={show.Payload_Class__c}>\n                                    <div class=\"fld fld_wide\">\n                                        <template lwc:if={hasPayloadClasses}>\n                                            <lightning-combobox label={f.Payload_Class__c.label} options={payloadClassOptions}\n                                                value={values.Payload_Class__c} data-field=\"Payload_Class__c\" onchange={handleChange}\n                                                placeholder=\"Choose the class…\" required={f.Payload_Class__c.required}></lightning-combobox>\n                                        </template>\n                                        <template lwc:else>\n                                            <lightning-input label={f.Payload_Class__c.label} value={values.Payload_Class__c}\n                                                data-field=\"Payload_Class__c\" onchange={handleChange}\n                                                required={f.Payload_Class__c.required} class=\"ih-mono\"></lightning-input>\n                                            <p class=\"hint\">No class implementing IntegrationHub.IPayloadBuilder was found: type its name.</p>\n                                        </template>\n                                        <p class=\"hint\">{f.Payload_Class__c.help}</p>\n                                    </div>\n                                </template>\n                                <div class=\"fld\">\n                                    <lightning-input label={f.Transaction_Id_Key__c.label} value={values.Transaction_Id_Key__c}\n                                        data-field=\"Transaction_Id_Key__c\" onchange={handleChange} class=\"ih-mono\"></lightning-input>\n                                    <p class=\"hint\">{f.Transaction_Id_Key__c.help}</p>\n                                </div>\n                            </template>\n                            <template lwc:else>\n                                <div class=\"fld fld_wide\">\n                                    <p class=\"ih-callout ih-callout_info\">The middleware calls POST <span class=\"ih-mono\">{inboundCallUrl}</span>\n                                        as the connection's Inbound User. Your Handler Class gets the JSON and does the work.</p>\n                                </div>\n                                <div class=\"fld fld_wide\">\n                                    <template lwc:if={hasInboundClasses}>\n                                        <lightning-combobox label={f.Handler_Class__c.label} options={inboundClassOptions}\n                                            value={values.Handler_Class__c} data-field=\"Handler_Class__c\" onchange={handleChange}\n                                            placeholder=\"Choose the class…\" required={f.Handler_Class__c.required}></lightning-combobox>\n                                    </template>\n                                    <template lwc:else>\n                                        <lightning-input label={f.Handler_Class__c.label} value={values.Handler_Class__c}\n                                            data-field=\"Handler_Class__c\" onchange={handleChange}\n                                            required={f.Handler_Class__c.required} class=\"ih-mono\"></lightning-input>\n                                        <p class=\"hint\">No class implementing IntegrationHub.IInboundHandler was found: type its name.</p>\n                                    </template>\n                                    <p class=\"hint\">{f.Handler_Class__c.help}</p>\n                                </div>\n                            </template>\n                        </div>\n                    </template>\n\n                    <!-- ======================== EVENT step 3: Reply & callback -->\n                    <template lwc:if={ev.s2}>\n                        <div class=\"fields\">\n                            <template lwc:if={isOutbound}>\n                                <div class=\"fld fld_wide\">\n                                    <template lwc:if={hasResponseClasses}>\n                                        <lightning-combobox label={f.Response_Handler_Class__c.label} options={responseClassOptions}\n                                            value={values.Response_Handler_Class__c} data-field=\"Response_Handler_Class__c\"\n                                            onchange={handleChange} required={f.Response_Handler_Class__c.required}></lightning-combobox>\n                                    </template>\n                                    <template lwc:else>\n                                        <lightning-input label={f.Response_Handler_Class__c.label} value={values.Response_Handler_Class__c}\n                                            data-field=\"Response_Handler_Class__c\" onchange={handleChange}\n                                            required={f.Response_Handler_Class__c.required} class=\"ih-mono\"></lightning-input>\n                                        <p class=\"hint\">No class implementing IntegrationHub.IResponseHandler was found: type its name, or leave it blank.</p>\n                                    </template>\n                                    <p class=\"hint\">{f.Response_Handler_Class__c.help}</p>\n                                </div>\n                                <div class=\"fld\">\n                                    <lightning-input type=\"checkbox\" label={f.Business_Data_In_Response__c.label}\n                                        checked={flags.Business_Data_In_Response__c} data-field=\"Business_Data_In_Response__c\"\n                                        onchange={handleChange}></lightning-input>\n                                    <p class=\"hint\">{f.Business_Data_In_Response__c.help}</p>\n                                </div>\n                                <div class=\"fld\">\n                                    <lightning-input type=\"checkbox\" label={f.Expects_Callback__c.label}\n                                        checked={flags.Expects_Callback__c} data-field=\"Expects_Callback__c\"\n                                        onchange={handleChange}></lightning-input>\n                                    <p class=\"hint\">{f.Expects_Callback__c.help}</p>\n                                </div>\n                                <template lwc:if={show.Callback_Timeout_Hours__c}>\n                                    <div class=\"fld\">\n                                        <lightning-input type=\"number\" label={f.Callback_Timeout_Hours__c.label}\n                                            value={values.Callback_Timeout_Hours__c} data-field=\"Callback_Timeout_Hours__c\"\n                                            onchange={handleChange} min=\"0\"></lightning-input>\n                                        <p class=\"hint\">{f.Callback_Timeout_Hours__c.help}</p>\n                                    </div>\n                                </template>\n                                <template lwc:if={show.Auto_Retry_Max__c}>\n                                    <div class=\"fld\">\n                                        <lightning-input type=\"number\" label={f.Auto_Retry_Max__c.label}\n                                            value={values.Auto_Retry_Max__c} data-field=\"Auto_Retry_Max__c\"\n                                            onchange={handleChange} min=\"0\" max=\"10\" step=\"1\"></lightning-input>\n                                        <p class=\"hint\">{f.Auto_Retry_Max__c.help}</p>\n                                    </div>\n                                </template>\n                                <template lwc:if={show.Retry_After_Minutes__c}>\n                                    <div class=\"fld\">\n                                        <lightning-input type=\"number\" label={f.Retry_After_Minutes__c.label}\n                                            value={values.Retry_After_Minutes__c} data-field=\"Retry_After_Minutes__c\"\n                                            onchange={handleChange} min=\"1\" max=\"1440\" step=\"1\"></lightning-input>\n                                        <p class=\"hint\">{f.Retry_After_Minutes__c.help}</p>\n                                    </div>\n                                </template>\n                                <template lwc:if={show.Auto_Retry_Max__c}>\n                                    <div class=\"fld fld_wide\">\n                                        <p class=\"hint hint_strong\">Auto-retry: {autoRetryText}</p>\n                                        <template lwc:if={showRetrySuggestion}>\n                                            <p class=\"hint\">Suggested for most systems: 3 retries, the first after 15 minutes.\n                                                <button type=\"button\" class=\"linkish\" onclick={handleSuggestRetry}>Use 3 and 15</button>\n                                            </p>\n                                        </template>\n                                    </div>\n                                </template>\n                            </template>\n                            <template lwc:else>\n                                <div class=\"fld fld_wide\">\n                                    <p class=\"ih-callout ih-callout_info\">An inbound event answers the middleware at once: there is no\n                                        response handler and no callback.</p>\n                                </div>\n                            </template>\n                            <div class=\"fld\">\n                                <lightning-input type=\"number\" label={f.Retention_Days__c.label} value={values.Retention_Days__c}\n                                    data-field=\"Retention_Days__c\" onchange={handleChange} min=\"0\"></lightning-input>\n                                <p class=\"hint\">{f.Retention_Days__c.help}</p>\n                            </div>\n                        </div>\n                    </template>\n\n                    <!-- ======================== CONNECTION step 1: Basics -->\n                    <template lwc:if={cn.s0}>\n                        <div class=\"fields\">\n                            <div class=\"fld\">\n                                <lightning-input label={f.Name.label} value={values.Name} data-field=\"Name\" onchange={handleChange}\n                                    required={f.Name.required} max-length=\"80\"></lightning-input>\n                                <p class=\"hint\">{f.Name.help}</p>\n                            </div>\n                            <template lwc:if={show.Active__c}>\n                                <div class=\"fld\">\n                                    <lightning-input type=\"checkbox\" label={f.Active__c.label} checked={flags.Active__c}\n                                        data-field=\"Active__c\" onchange={handleChange} disabled={isNew}></lightning-input>\n                                    <template lwc:if={isNew}>\n                                        <p class=\"hint\">A new connection is saved inactive. Activate it after Check connection.</p>\n                                    </template>\n                                    <p class=\"hint\">{f.Active__c.help}</p>\n                                </div>\n                            </template>\n                            <div class=\"fld fld_wide\">\n                                <lightning-textarea label={f.Description__c.label} value={values.Description__c}\n                                    data-field=\"Description__c\" onchange={handleChange}></lightning-textarea>\n                                <p class=\"hint\">{f.Description__c.help}</p>\n                            </div>\n                        </div>\n                    </template>\n\n                    <!-- ======================== CONNECTION step 2: Endpoint & headers -->\n                    <template lwc:if={cn.s1}>\n                        <div class=\"fields\">\n                            <template lwc:if={show.Connection_Type__c}>\n                                <div class=\"fld fld_wide\">\n                                    <lightning-radio-group label={f.Connection_Type__c.label} options={connectionTypeOptions}\n                                        type=\"radio\" value={connectionTypeValue} data-field=\"Connection_Type__c\"\n                                        onchange={handleChange}></lightning-radio-group>\n                                    <p class=\"hint\">{f.Connection_Type__c.help}</p>\n                                </div>\n                            </template>\n                            <div class=\"fld fld_wide\">\n                                <template lwc:if={hasCredentials}>\n                                    <lightning-combobox label={f.Named_Credential__c.label} options={credentialOptions}\n                                        value={values.Named_Credential__c} data-field=\"Named_Credential__c\" onchange={handleChange}\n                                        placeholder=\"Choose the Named Credential…\" required={f.Named_Credential__c.required}></lightning-combobox>\n                                    <p class=\"hint\">Picked from Setup &gt; Named Credentials in this org. Each org points it at its own URL; keep the same name everywhere.</p>\n                                </template>\n                                <template lwc:else>\n                                    <lightning-input label={f.Named_Credential__c.label} value={values.Named_Credential__c}\n                                        data-field=\"Named_Credential__c\" onchange={handleChange}\n                                        required={f.Named_Credential__c.required} class=\"ih-mono\"></lightning-input>\n                                    <p class=\"hint\">No Named Credential was found in this org: type its API name.</p>\n                                </template>\n                                <p class=\"hint\">{f.Named_Credential__c.help}</p>\n                                <template lwc:if={isApexAuth}>\n                                    <p class=\"hint\">Apex Auth still needs the Named Credential: it gives the base URL. Your Auth\n                                        Class adds the login header at send time and can log in through this or another Named\n                                        Credential. No secret is stored in a field.</p>\n                                </template>\n                            </div>\n                            <template lwc:if={show.Auth_Class__c}>\n                                <div class=\"fld fld_wide\">\n                                    <template lwc:if={hasAuthClasses}>\n                                        <lightning-combobox label={f.Auth_Class__c.label} options={authClassOptions}\n                                            value={values.Auth_Class__c} data-field=\"Auth_Class__c\" onchange={handleChange}\n                                            placeholder=\"Choose the class…\" required={f.Auth_Class__c.required}></lightning-combobox>\n                                    </template>\n                                    <template lwc:else>\n                                        <lightning-input label={f.Auth_Class__c.label} value={values.Auth_Class__c}\n                                            data-field=\"Auth_Class__c\" onchange={handleChange}\n                                            required={f.Auth_Class__c.required} class=\"ih-mono\"></lightning-input>\n                                        <p class=\"hint\">No class implementing IntegrationHub.IConnectionAuth was found: type its\n                                            name. How To &gt; Which connection type? has a template.</p>\n                                    </template>\n                                    <p class=\"hint\">{f.Auth_Class__c.help}</p>\n                                </div>\n                            </template>\n                            <div class=\"fld\">\n                                <lightning-input type=\"number\" label={f.Timeout_Seconds__c.label} value={values.Timeout_Seconds__c}\n                                    data-field=\"Timeout_Seconds__c\" onchange={handleChange} min=\"1\" max=\"120\"></lightning-input>\n                                <p class=\"hint\">{f.Timeout_Seconds__c.help}</p>\n                            </div>\n                            <div class=\"fld fld_wide\">\n                                <p class=\"label-like\">Extra headers on every call ({f.Headers__c.label})</p>\n                                <c-ih-setup-headers value={values.Headers__c} onchange={handleHeaders}></c-ih-setup-headers>\n                                <p class=\"hint\">{f.Headers__c.help}</p>\n                            </div>\n                        </div>\n                    </template>\n\n                    <!-- ======================== CONNECTION step 3: Inbound user & check -->\n                    <template lwc:if={cn.s2}>\n                        <div class=\"fields\">\n                            <div class=\"fld fld_wide\">\n                                <lightning-record-picker label={f.Inbound_User__c.label} object-api-name=\"User\"\n                                    placeholder=\"Search users…\" value={values.Inbound_User__c} filter={userFilter}\n                                    onchange={handleInboundUser}></lightning-record-picker>\n                                <template lwc:if={accessLine}>\n                                    <p class={accessClass}>{accessLine}</p>\n                                </template>\n                                <p class=\"hint\">{f.Inbound_User__c.help}</p>\n                                <p class=\"hint\">Inbound events are called at <span class=\"ih-mono\">{inboundCallUrl}</span>.</p>\n                            </div>\n                        </div>\n                    </template>\n\n                    <!-- ======================== last step: problems and checks -->\n                    <template lwc:if={isLastStep}>\n                        <div class=\"checks\">\n                            <h3 class=\"sub\">Before saving</h3>\n                            <p class=\"ih-small\">{readyText}</p>\n                            <template lwc:if={hasProblems}>\n                                <ul class=\"problems\">\n                                    <template for:each={problems} for:item=\"p\">\n                                        <li key={p.key}>\n                                            <button type=\"button\" class={p.cls} data-step={p.step} onclick={handleProblem}>\n                                                <lightning-icon icon-name={p.icon} size=\"xx-small\" alternative-text={p.level}></lightning-icon>\n                                                <span class=\"problem-text\">{p.text}</span>\n                                                <span class=\"problem-step\">{p.stepLabel}</span>\n                                            </button>\n                                        </li>\n                                    </template>\n                                </ul>\n                            </template>\n\n                            <h3 class=\"sub\">Checks</h3>\n                            <template lwc:if={canRunChecks}>\n                                <p class=\"ih-small\">The checks use the saved record. Save your changes first to check them.</p>\n                                <div class=\"ih-row\">\n                                    <template lwc:if={isEvent}>\n                                        <template lwc:if={showCheckEndpoint}>\n                                            <lightning-button label=\"Check endpoint\" icon-name=\"utility:connected_apps\"\n                                                onclick={handleCheck} disabled={checking}></lightning-button>\n                                        </template>\n                                        <lightning-button label=\"Preview payload\" icon-name=\"utility:preview\"\n                                            onclick={handlePreview}></lightning-button>\n                                    </template>\n                                    <template lwc:else>\n                                        <lightning-button label=\"Check connection\" icon-name=\"utility:connected_apps\"\n                                            onclick={handleCheck} disabled={checking}></lightning-button>\n                                    </template>\n                                </div>\n                            </template>\n                            <template lwc:else>\n                                <div class=\"ih-row\">\n                                    <template lwc:if={isEvent}>\n                                        <lightning-button label=\"Check endpoint\" icon-name=\"utility:connected_apps\" disabled></lightning-button>\n                                        <lightning-button label=\"Preview payload\" icon-name=\"utility:preview\" disabled></lightning-button>\n                                    </template>\n                                    <template lwc:else>\n                                        <lightning-button label=\"Check connection\" icon-name=\"utility:connected_apps\" disabled></lightning-button>\n                                    </template>\n                                    <span class=\"ih-small\">Available after the first save</span>\n                                </div>\n                            </template>\n                            <template lwc:if={checking}>\n                                <div class=\"ih-spinner\"><lightning-spinner alternative-text=\"Checking\" size=\"small\"></lightning-spinner></div>\n                            </template>\n                            <template lwc:if={checkResult}>\n                                <div class={checkClass} role=\"status\">\n                                    <lightning-icon icon-name={checkIcon} size=\"x-small\" alternative-text=\"\"></lightning-icon>\n                                    <span>{checkResult.message}</span>\n                                    <span class=\"ih-small\">{checkTime}</span>\n                                </div>\n                            </template>\n                        </div>\n                    </template>\n                </div>\n\n                <aside class=\"side\" aria-label=\"Summary\">\n                    <h3 class=\"sub\">Summary</h3>\n                    <dl class=\"kv\">\n                        <template for:each={summaryRows} for:item=\"r\">\n                            <div key={r.key} class={r.cls}>\n                                <dt>{r.label}</dt>\n                                <dd>{r.value}</dd>\n                            </div>\n                        </template>\n                    </dl>\n                    <template lwc:if={summaryNote}>\n                        <p class=\"ih-small\">{summaryNote}</p>\n                    </template>\n                </aside>\n            </div>\n\n            <div class=\"foot\">\n                <lightning-button label=\"Cancel\" onclick={handleCancel} disabled={saving}></lightning-button>\n                <span class=\"ih-spacer\"></span>\n                <lightning-button label=\"Back\" icon-name=\"utility:chevronleft\" onclick={handlePrevious}\n                    disabled={isFirstStep}></lightning-button>\n                <template lwc:if={notLastStep}>\n                    <lightning-button variant=\"brand\" label=\"Next\" icon-name=\"utility:chevronright\" icon-position=\"right\"\n                        onclick={handleNext}></lightning-button>\n                </template>\n                <template lwc:else>\n                    <lightning-button variant=\"brand\" label=\"Save\" onclick={handleSave} disabled={saveDisabled}></lightning-button>\n                </template>\n            </div>\n            <template lwc:if={saving}>\n                <lightning-spinner alternative-text=\"Saving\" size=\"small\"></lightning-spinner>\n            </template>\n        </template>\n\n        <!-- ============================================================ read-only summary -->\n        <template lwc:elseif={showView}>\n            <div class=\"ih-card-head\">\n                <h2 class=\"ih-card-title\">\n                    Setup summary\n                    <template for:each={viewBadges} for:item=\"b\">\n                        <span key={b.key} class={b.cls}>{b.label}</span>\n                    </template>\n                </h2>\n                <div class=\"ih-row\">\n                    <template lwc:if={canRunChecks}>\n                        <template lwc:if={isEvent}>\n                            <template lwc:if={showCheckEndpoint}>\n                                <lightning-button label=\"Check endpoint\" onclick={handleCheck} disabled={checking}></lightning-button>\n                            </template>\n                            <lightning-button label=\"Preview payload\" onclick={handlePreview}></lightning-button>\n                        </template>\n                        <template lwc:else>\n                            <lightning-button label=\"Check connection\" onclick={handleCheck} disabled={checking}></lightning-button>\n                        </template>\n                        <lightning-button variant=\"brand\" label=\"Edit\" onclick={handleEdit}></lightning-button>\n                    </template>\n                </div>\n            </div>\n            <div class=\"ih-card-body\">\n                <template lwc:if={notAdminInEdit}>\n                    <p class=\"ih-callout ih-callout_info\">Integration Hub Admin permission is needed to edit. This is the summary.</p>\n                </template>\n                <template lwc:if={checking}>\n                    <div class=\"ih-spinner\"><lightning-spinner alternative-text=\"Checking\" size=\"small\"></lightning-spinner></div>\n                </template>\n                <template lwc:if={checkResult}>\n                    <div class={checkClass} role=\"status\">\n                        <lightning-icon icon-name={checkIcon} size=\"x-small\" alternative-text=\"\"></lightning-icon>\n                        <span>{checkResult.message}</span>\n                        <span class=\"ih-small\">{checkTime}</span>\n                    </div>\n                </template>\n                <div class=\"cards\">\n                    <template for:each={viewCards} for:item=\"card\">\n                        <div key={card.key} class=\"sum-card\">\n                            <h3 class=\"sum-title\"><span class=\"num\">{card.number}</span>{card.title}</h3>\n                            <dl class=\"kv\">\n                                <template for:each={card.rows} for:item=\"r\">\n                                    <div key={r.key} class={r.cls}>\n                                        <dt>{r.label}</dt>\n                                        <dd>{r.value}</dd>\n                                    </div>\n                                </template>\n                            </dl>\n                        </div>\n                    </template>\n                    <template lwc:if={isConnection}>\n                        <div class=\"sum-card\">\n                            <h3 class=\"sum-title\">{eventsShownTitle}</h3>\n                            <template lwc:if={hasEventRows}>\n                                <div class=\"ih-table-wrap\">\n                                    <table class=\"ih-table\">\n                                        <thead>\n                                            <tr>\n                                                <th scope=\"col\">Event Key</th>\n                                                <th scope=\"col\">Direction</th>\n                                                <th scope=\"col\">Active</th>\n                                            </tr>\n                                        </thead>\n                                        <tbody>\n                                            <template for:each={eventRows} for:item=\"e\">\n                                                <tr key={e.key}>\n                                                    <td><a class=\"ih-link ih-mono\" href={e.url} data-id={e.id}\n                                                        onclick={handleOpenEvent}>{e.eventKey}</a></td>\n                                                    <td>{e.direction}</td>\n                                                    <td><span class={e.activeCls}>{e.active}</span></td>\n                                                </tr>\n                                            </template>\n                                        </tbody>\n                                    </table>\n                                </div>\n                            </template>\n                            <template lwc:else>\n                                <p class=\"ih-small\">No events use this connection yet.</p>\n                            </template>\n                            <p class=\"ih-small more\">\n                                <template lwc:if={moreEvents}><span>{moreEvents}</span></template>\n                                <template lwc:if={isAdmin}>\n                                    <a class=\"ih-link\" href=\"#\" onclick={handleNewEvent}>New event (Connection filled in)</a>\n                                </template>\n                            </p>\n                        </div>\n                    </template>\n                </div>\n            </div>\n        </template>\n    </section>\n</template>"}
