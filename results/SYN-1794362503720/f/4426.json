{"path":"force-app/main/default/lwc/ihSetupHeaders/ihSetupHeaders.html","left":null,"right":"<template>\n    <template lwc:if={raw}>\n        <lightning-textarea label=\"Headers (JSON)\" value={rawText} onchange={handleRaw} disabled={disabled}\n            class=\"ih-mono\"></lightning-textarea>\n        <template lwc:if={rawError}>\n            <p class=\"ih-small ih-bad-text\">{rawError}</p>\n            <div class=\"ih-row\">\n                <lightning-button label=\"Clear headers\" onclick={handleClearRaw} disabled={disabled}></lightning-button>\n            </div>\n        </template>\n        <template lwc:else>\n            <div class=\"ih-row\">\n                <span class=\"ih-small ih-ok-text\">✓ valid JSON</span>\n                <lightning-button variant=\"base\" label=\"Edit as a table\" onclick={handleUseTable} disabled={disabled}></lightning-button>\n            </div>\n        </template>\n    </template>\n    <template lwc:else>\n        <div class=\"ih-table-wrap\">\n            <table class=\"ih-table grid\">\n                <thead>\n                    <tr>\n                        <th scope=\"col\">Header</th>\n                        <th scope=\"col\">Value</th>\n                        <th scope=\"col\" class=\"x-col\"><span class=\"slds-assistive-text\">Remove</span></th>\n                    </tr>\n                </thead>\n                <tbody>\n                    <template for:each={viewRows} for:item=\"row\">\n                        <tr key={row.id}>\n                            <td>\n                                <lightning-input label=\"Header\" variant=\"label-hidden\" value={row.name} data-id={row.id}\n                                    onchange={handleName} disabled={disabled} class=\"ih-mono\"></lightning-input>\n                            </td>\n                            <td>\n                                <lightning-input label=\"Value\" variant=\"label-hidden\" value={row.value} data-id={row.id}\n                                    onchange={handleValue} disabled={disabled}></lightning-input>\n                                <template lwc:if={row.merge}>\n                                    <span class=\"ih-small\">from Named Credential</span>\n                                </template>\n                            </td>\n                            <td class=\"x-col\">\n                                <lightning-button-icon icon-name=\"utility:close\" variant=\"bare\" alternative-text={row.removeLabel}\n                                    title={row.removeLabel} data-id={row.id} onclick={handleRemove} disabled={disabled}></lightning-button-icon>\n                            </td>\n                        </tr>\n                    </template>\n                </tbody>\n            </table>\n        </div>\n        <template lwc:if={noRows}>\n            <p class=\"ih-small\">No extra headers.</p>\n        </template>\n        <div class=\"ih-row\">\n            <lightning-button variant=\"base\" label=\"+ Add header\" onclick={handleAdd} disabled={disabled}></lightning-button>\n            <span class=\"ih-small\">saved as JSON in Headers, e.g. {example}</span>\n            <span class=\"ih-small ih-ok-text\">✓ valid JSON</span>\n        </div>\n        <template lwc:if={duplicates}>\n            <p class=\"ih-small ih-bad-text\">Listed twice, the last one is used: {duplicates}</p>\n        </template>\n    </template>\n</template>"}
