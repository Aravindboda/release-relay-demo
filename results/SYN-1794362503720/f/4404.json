{"path":"force-app/main/default/lwc/ihMonitor/ihMonitor.html","left":null,"right":"<template>\n    <div class=\"ih-page\">\n        <section class=\"ih-hero\">\n            <span class=\"ih-hero-icon\">\n                <lightning-icon icon-name=\"utility:heart\" size=\"small\" variant=\"inverse\" alternative-text=\"\"></lightning-icon>\n            </span>\n            <div class=\"ih-hero-text\">\n                <span class=\"ih-eyebrow\">Integration Hub</span>\n                <h1>Monitor</h1>\n                <p>Totals for the period and failures grouped by cause. Fix the cause, then retry the group.</p>\n            </div>\n            <div class=\"ih-hero-actions\">\n                <template lwc:if={polling}>\n                    <span class=\"ih-small ih-auto\" title=\"Updates by itself while transactions are in progress\">\n                        <lightning-icon icon-name=\"utility:sync\" size=\"xx-small\" variant=\"inverse\" alternative-text=\"\"></lightning-icon>\n                        Auto-refreshing\n                    </span>\n                </template>\n                <lightning-button label=\"Open Transactions\" icon-name=\"utility:list\" onclick={handleOpenTransactions}></lightning-button>\n                <lightning-button-icon icon-name=\"utility:refresh\" variant=\"border-inverse\" alternative-text=\"Refresh\" title=\"Refresh\"\n                    onclick={handleRefresh} disabled={busy}></lightning-button-icon>\n            </div>\n        </section>\n\n        <section class=\"ih-card period-bar\" aria-label=\"Period\">\n            <lightning-combobox label=\"Period\" value={period} options={periodOptions} onchange={handlePeriod}></lightning-combobox>\n            <template lwc:if={isCustom}>\n                <lightning-input type=\"number\" label=\"Last\" value={customDays} min=\"1\" max=\"3650\" step=\"1\"\n                    message-when-range-overflow=\"At most 3,650 days.\" message-when-range-underflow=\"At least 1 day.\"\n                    onchange={handleDays} class=\"days\"></lightning-input>\n                <span class=\"ih-small hint\">days, ending today</span>\n            </template>\n            <template lwc:if={isRange}>\n                <lightning-input type=\"date\" label=\"From\" value={customFrom} max={maxDay} data-field=\"customFrom\"\n                    onchange={handleRange} class=\"date\"></lightning-input>\n                <lightning-input type=\"date\" label=\"To\" value={customTo} max={maxDay} data-field=\"customTo\"\n                    field-level-help=\"Includes the whole day\" onchange={handleRange} class=\"date\"></lightning-input>\n            </template>\n            <span class=\"spacer\"></span>\n            <span class=\"ih-small hint\">{sinceText}</span>\n        </section>\n\n        <template lwc:if={rangeError}>\n            <p class=\"ih-callout ih-callout_bad\">{rangeError}</p>\n        </template>\n        <template lwc:if={anyCapped}>\n            <p class=\"ih-callout\">Some totals reached 4,000 and are shown as \"4,000+\". Use a shorter period, the Transactions tab or a report for exact numbers.</p>\n        </template>\n        <template lwc:if={error}>\n            <p class=\"ih-callout ih-callout_bad\">{error}</p>\n        </template>\n        <template lwc:if={loading}>\n            <div class=\"ih-spinner\"><lightning-spinner alternative-text=\"Loading\" size=\"small\"></lightning-spinner></div>\n        </template>\n\n        <div class=\"ih-tiles\">\n            <template for:each={tiles} for:item=\"t\">\n                <div key={t.key} class={t.cls}>\n                    <span class=\"ih-tile-label\">{t.label}</span>\n                    <span class=\"ih-tile-value\">{t.value}</span>\n                </div>\n            </template>\n        </div>\n\n        <section class=\"ih-card\">\n            <div class=\"ih-card-head\">\n                <h2 class=\"ih-card-title\">Failures by cause</h2>\n                <span class=\"ih-small\">Failed and Abandoned, grouped by event and error</span>\n            </div>\n            <template lwc:if={groupNote}>\n                <p class=\"ih-small group-note\">{groupNote}</p>\n            </template>\n            <template lwc:if={hasGroups}>\n                <div class=\"ih-table-wrap\">\n                    <table class=\"ih-table\">\n                        <thead>\n                            <tr>\n                                <th class=\"first\" scope=\"col\">Event</th>\n                                <th scope=\"col\">Error</th>\n                                <th scope=\"col\">Count</th>\n                                <th scope=\"col\">Latest</th>\n                                <th class=\"last\" scope=\"col\"><span class=\"slds-assistive-text\">Action</span></th>\n                            </tr>\n                        </thead>\n                        <tbody>\n                            <template for:each={groups} for:item=\"g\">\n                                <tr key={g.key}>\n                                    <td class=\"first\">{g.eventName}</td>\n                                    <td class=\"ih-note ih-note_bad\">{g.errorText}</td>\n                                    <td class=\"ih-nowrap\">{g.total}</td>\n                                    <td class=\"ih-nowrap\">\n                                        <lightning-formatted-date-time value={g.latest} month=\"short\" day=\"numeric\" hour=\"numeric\"\n                                            minute=\"2-digit\"></lightning-formatted-date-time>\n                                    </td>\n                                    <td class=\"last ih-nowrap\">\n                                        <template lwc:if={g.confirming}>\n                                            <div class=\"confirm\">\n                                                <span class=\"ih-small\">{g.confirmText}</span>\n                                                <lightning-button variant=\"brand\" label=\"Retry\" data-key={g.key} onclick={handleRetryGroup}\n                                                    disabled={busy}></lightning-button>\n                                                <lightning-button label=\"Cancel\" onclick={handleCancel}></lightning-button>\n                                            </div>\n                                        </template>\n                                        <template lwc:else>\n                                            <lightning-button label=\"Retry group\" icon-name=\"utility:refresh\" data-key={g.key}\n                                                onclick={handleAsk} disabled={busy}></lightning-button>\n                                        </template>\n                                    </td>\n                                </tr>\n                            </template>\n                        </tbody>\n                    </table>\n                </div>\n            </template>\n            <template lwc:if={noGroups}>\n                <p class=\"ih-empty\">No failures in this period.</p>\n            </template>\n        </section>\n\n        <c-ih-cleanup-status></c-ih-cleanup-status>\n    </div>\n</template>"}
