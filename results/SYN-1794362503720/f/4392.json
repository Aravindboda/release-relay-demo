{"path":"force-app/main/default/lwc/ihConnectionCheck/ihConnectionCheck.html","left":null,"right":"<template>\n    <section class=\"ih-card\" aria-label=\"Connection check\">\n        <div class=\"ih-card-head\">\n            <h2 class=\"ih-card-title\">\n                <lightning-icon icon-name=\"standard:data_integration_hub\" size=\"small\" alternative-text=\"\"></lightning-icon>\n                Connection check\n            </h2>\n        </div>\n        <div class=\"ih-card-body\">\n            <p class=\"ih-small\">Sends one GET to the Named Credential's URL. No record data is sent.</p>\n            <template lwc:if={canCheck}>\n                <lightning-button variant=\"brand\" label=\"Check connection\" icon-name=\"utility:connected_apps\"\n                    onclick={handleCheck} disabled={checking} class=\"check\"></lightning-button>\n            </template>\n            <template lwc:else>\n                <p class=\"ih-small\">Integration Hub Admin permission is needed to run the check.</p>\n            </template>\n            <template lwc:if={checking}>\n                <div class=\"ih-spinner\"><lightning-spinner alternative-text=\"Checking\" size=\"small\"></lightning-spinner></div>\n            </template>\n            <template lwc:if={result}>\n                <div class={resultClass} role=\"status\">\n                    <lightning-icon icon-name={resultIcon} size=\"x-small\" alternative-text=\"\"></lightning-icon>\n                    <span>{result.message}</span>\n                    <span class=\"ih-small\">{resultTime}</span>\n                </div>\n            </template>\n        </div>\n    </section>\n\n    <section class=\"ih-card events\" aria-label=\"Events of this connection\">\n        <div class=\"ih-card-head\">\n            <h2 class=\"ih-card-title\">{eventsTitle}</h2>\n            <lightning-button-icon icon-name=\"utility:refresh\" alternative-text=\"Refresh\" title=\"Refresh\"\n                onclick={handleRefresh}></lightning-button-icon>\n        </div>\n        <template lwc:if={eventsError}>\n            <p class=\"ih-error\">{eventsError}</p>\n        </template>\n        <template lwc:if={hasEvents}>\n            <ul class=\"list\">\n                <template for:each={events} for:item=\"ev\">\n                    <li key={ev.id} class=\"item\">\n                        <div class=\"line1\">\n                            <span class={ev.directionClass}>{ev.direction}</span>\n                            <a class=\"ih-link\" href={ev.url} data-id={ev.id} data-label={ev.name} onclick={handleOpen}>{ev.name}</a>\n                            <span class={ev.stateClass}>{ev.state}</span>\n                        </div>\n                        <div class=\"ih-small\">{ev.key} · {ev.object}</div>\n                    </li>\n                </template>\n            </ul>\n        </template>\n        <template lwc:if={noEvents}>\n            <p class=\"ih-empty\">No events use this connection yet.</p>\n        </template>\n    </section>\n</template>"}
