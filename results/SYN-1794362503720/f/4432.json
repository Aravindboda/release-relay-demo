{"path":"force-app/main/default/lwc/ihTransactionExchange/ihTransactionExchange.html","left":null,"right":"<template>\n    <lightning-modal-header label={headerLabel}></lightning-modal-header>\n    <lightning-modal-body>\n        <template lwc:if={loading}>\n            <div class=\"ih-spinner\"><lightning-spinner alternative-text=\"Loading\" size=\"small\"></lightning-spinner></div>\n        </template>\n        <template lwc:if={error}>\n            <div class=\"ih-callout ih-callout_bad\" role=\"alert\">\n                <lightning-icon icon-name=\"utility:error\" size=\"x-small\" variant=\"error\" alternative-text=\"\"></lightning-icon>\n                <span>{error}</span>\n            </div>\n        </template>\n\n        <!-- Rerun confirm step -->\n        <template lwc:if={confirming}>\n            <p class=\"confirm-lead\">Runs <strong>{handlerClass}</strong> again on the {dataSource} stored on this\n                transaction. Nothing is sent to {conn}.</p>\n            <div class=\"sec-head gap\">\n                <h3 class=\"sec-title\">{rerunDataTitle}</h3>\n                <template lwc:if={hasRerunData}>\n                    <button class=\"copy\" data-what=\"rerun\" onclick={handleCopy}>Copy</button>\n                </template>\n            </div>\n            <template lwc:if={hasRerunData}>\n                <c-ih-code text={rerunData} max-height=\"220px\"></c-ih-code>\n            </template>\n            <template lwc:if={rerunCut}>\n                <p class=\"ih-small\">The box shows the start of the body; the handler gets the full body from the File.</p>\n            </template>\n            <p class=\"ih-small gap\">Fix the cause first (for example a validation rule or the data), then rerun. It runs in\n                the background; Business Status shows Processing, then Done or Failed. Every run is listed under\n                Attempts.</p>\n        </template>\n\n        <template lwc:if={showMain}>\n            <p class=\"ih-small intro\">\n                <template lwc:if={hasSentAt}>\n                    {introStart}\n                    <lightning-formatted-date-time value={ex.sentAt} year=\"numeric\" month=\"short\" day=\"numeric\"\n                        hour=\"numeric\" minute=\"2-digit\"></lightning-formatted-date-time>.\n                </template>\n                Copy it to share with the middleware team.\n            </p>\n            <template lwc:if={retryText}>\n                <div class=\"ih-callout ih-callout_info retry-line\" role=\"status\">\n                    <lightning-icon icon-name=\"utility:clock\" size=\"x-small\" alternative-text=\"\"></lightning-icon>\n                    <span>{retryText}. A Retry by hand sends it now and cancels this.</span>\n                </div>\n            </template>\n            <div class=\"cols\">\n                <!-- left: request -->\n                <div class=\"col\">\n                    <div class=\"sec-head\">\n                        <h3 class=\"sec-title\">{requestTitle}</h3>\n                        <button class=\"copy\" data-what=\"request\" onclick={handleCopy}>Copy request</button>\n                    </div>\n                    <c-ih-code text={requestText} max-height=\"520px\"></c-ih-code>\n                    <template lwc:if={requestCut}>\n                        <a class=\"download\" href=\"#\" data-file={ex.requestFileId} onclick={handleDownload}>Download full body</a>\n                    </template>\n                </div>\n\n                <!-- right: answer, callback, business, attempts -->\n                <div class=\"col\">\n                    <div class=\"sec-head\">\n                        <h3 class=\"sec-title\">{answerTitle}</h3>\n                        <button class=\"copy\" data-what=\"answer\" onclick={handleCopy}>Copy</button>\n                    </div>\n                    <c-ih-code text={answerText} max-height=\"260px\"></c-ih-code>\n                    <template lwc:if={responseCut}>\n                        <a class=\"download\" href=\"#\" data-file={ex.responseFileId} onclick={handleDownload}>Download full body</a>\n                    </template>\n\n                    <template lwc:if={showCallback}>\n                        <div class=\"sec-head gap\">\n                            <h3 class=\"sec-title\">3. Callback received</h3>\n                            <template lwc:if={hasCallbackBody}>\n                                <button class=\"copy\" data-what=\"callback\" onclick={handleCopy}>Copy</button>\n                            </template>\n                        </div>\n                        <c-ih-code text={callbackText} muted={callbackMuted} max-height=\"260px\"></c-ih-code>\n                        <template lwc:if={callbackCut}>\n                            <a class=\"download\" href=\"#\" data-file={ex.callbackFileId} onclick={handleDownload}>Download full body</a>\n                        </template>\n                    </template>\n\n                    <template lwc:if={businessData}>\n                        <div class=\"sec-head gap\">\n                            <h3 class=\"sec-title\">{businessTitle}</h3>\n                            <template lwc:if={canRerun}>\n                                <lightning-button label=\"Rerun handler\" icon-name=\"utility:refresh\" size=\"small\"\n                                    onclick={handleRerun}></lightning-button>\n                            </template>\n                        </div>\n                        <table class=\"grid kv\">\n                            <tbody>\n                                <tr>\n                                    <th scope=\"row\">Business Status</th>\n                                    <td><span class={businessClass}>{businessStatus}</span> <span class=\"ih-muted\">{businessWhen}</span></td>\n                                </tr>\n                                <tr>\n                                    <th scope=\"row\">Handler</th>\n                                    <td>{handlerClass}</td>\n                                </tr>\n                                <tr>\n                                    <th scope=\"row\">Input</th>\n                                    <td>{inputText}</td>\n                                </tr>\n                                <template lwc:if={hasResult}>\n                                    <tr>\n                                        <th scope=\"row\">Result</th>\n                                        <td>{ex.businessResult}</td>\n                                    </tr>\n                                </template>\n                                <template lwc:if={hasBusinessError}>\n                                    <tr>\n                                        <th scope=\"row\">Error</th>\n                                        <td class=\"ih-bad-text pre\">{ex.businessError}</td>\n                                    </tr>\n                                </template>\n                            </tbody>\n                        </table>\n                    </template>\n\n                    <div class=\"sec-head gap\">\n                        <h3 class=\"sec-title\">{attemptsTitle}</h3>\n                    </div>\n                    <template lwc:if={hasAttempts}>\n                        <div class=\"ih-table-wrap\">\n                            <table class=\"grid\">\n                                <thead>\n                                    <tr><th>#</th><th>When</th><th>HTTP</th><th>Outcome</th><th>Payload</th></tr>\n                                </thead>\n                                <tbody>\n                                    <template for:each={attemptRows} for:item=\"a\">\n                                        <tr key={a.key}>\n                                            <td>{a.n}</td>\n                                            <td class=\"ih-nowrap\">\n                                                <lightning-formatted-date-time value={a.at} month=\"short\" day=\"numeric\"\n                                                    hour=\"numeric\" minute=\"2-digit\"></lightning-formatted-date-time>\n                                            </td>\n                                            <td>{a.http}</td>\n                                            <td>\n                                                {a.outcome}\n                                                <template lwc:if={a.error}>\n                                                    <div class=\"ih-small ih-bad-text\">{a.error}</div>\n                                                </template>\n                                            </td>\n                                            <td>{a.payload}</td>\n                                        </tr>\n                                    </template>\n                                </tbody>\n                            </table>\n                        </div>\n                    </template>\n                    <template lwc:else>\n                        <p class=\"ih-small\">No attempts yet.</p>\n                    </template>\n                </div>\n            </div>\n        </template>\n    </lightning-modal-body>\n    <lightning-modal-footer>\n        <template lwc:if={confirming}>\n            <div class=\"foot\">\n                <lightning-button label=\"Cancel\" onclick={handleCancelRerun} disabled={rerunning}></lightning-button>\n                <lightning-button variant=\"brand\" label=\"Rerun now\" onclick={handleRerunNow}\n                    disabled={rerunning}></lightning-button>\n            </div>\n        </template>\n        <template lwc:else>\n            <lightning-button label=\"Close\" onclick={handleClose}></lightning-button>\n        </template>\n    </lightning-modal-footer>\n</template>"}
