{"path":"force-app/main/default/lwc/ihTransactionsTab/ihTransactionsTab.html","left":null,"right":"<template>\n    <div class=\"ih-page\">\n        <section class=\"ih-hero\">\n            <span class=\"ih-hero-icon\">\n                <lightning-icon icon-name=\"utility:list\" size=\"small\" variant=\"inverse\" alternative-text=\"\"></lightning-icon>\n            </span>\n            <div class=\"ih-hero-text\">\n                <span class=\"ih-eyebrow\">Integration Hub</span>\n                <h1>Transactions</h1>\n                <p>Every send and every inbound call you can see. Select one to see all of its information.</p>\n            </div>\n            <div class=\"ih-hero-actions\">\n                <template lwc:if={polling}>\n                    <span class=\"ih-small ih-auto\" title=\"Updates by itself while transactions are in progress\">\n                        <lightning-icon icon-name=\"utility:sync\" size=\"xx-small\" variant=\"inverse\" alternative-text=\"\"></lightning-icon>\n                        Auto-refreshing\n                    </span>\n                </template>\n                <template lwc:if={isAdmin}>\n                    <lightning-button-menu label={retrySelectedLabel} icon-name=\"utility:refresh\" variant=\"border-inverse\"\n                        menu-alignment=\"right\" alternative-text=\"Retry choices\" onselect={handleRetrySelected}\n                        disabled={noneChecked}>\n                        <lightning-menu-item value=\"new\" label=\"Retry with new payload\" prefix-icon-name=\"utility:refresh\"></lightning-menu-item>\n                        <lightning-menu-item value=\"original\" label=\"Resend original payload\" prefix-icon-name=\"utility:send\"></lightning-menu-item>\n                    </lightning-button-menu>\n                </template>\n                <lightning-button-icon icon-name=\"utility:refresh\" variant=\"border-inverse\" alternative-text=\"Refresh\"\n                    title=\"Refresh\" onclick={handleRefresh} disabled={busy}></lightning-button-icon>\n            </div>\n        </section>\n\n        <section class=\"ih-card\">\n            <div class=\"ih-card-body filters\">\n                <lightning-input class=\"grow\" type=\"search\" label=\"Search\" placeholder=\"Number, event, connection, error, record Id, reference\"\n                    onchange={handleSearch}></lightning-input>\n                <lightning-combobox label=\"Direction\" value={direction} options={directionOptions} data-field=\"direction\"\n                    onchange={handleFilter}></lightning-combobox>\n                <lightning-combobox label=\"Status\" value={status} options={statusOptions} data-field=\"status\"\n                    onchange={handleFilter}></lightning-combobox>\n                <lightning-combobox label=\"Created\" value={created} options={createdOptions} data-field=\"created\"\n                    onchange={handleFilter}></lightning-combobox>\n                <template lwc:if={isCustom}>\n                    <lightning-input class=\"days\" type=\"number\" label=\"Last (days)\" value={daysInput} min=\"1\" max=\"3650\" step=\"1\"\n                        field-level-help=\"Days ending today, 1 to 3,650\" onchange={handleDays}></lightning-input>\n                </template>\n                <template lwc:if={isRange}>\n                    <lightning-input class=\"date\" type=\"date\" label=\"From\" value={fromInput} max={maxDay} data-field=\"fromInput\"\n                        onchange={handleRange}></lightning-input>\n                    <lightning-input class=\"date\" type=\"date\" label=\"To\" value={toInput} max={maxDay} data-field=\"toInput\"\n                        field-level-help=\"Includes the whole day\" onchange={handleRange}></lightning-input>\n                </template>\n            </div>\n        </section>\n\n        <template lwc:if={error}>\n            <p class=\"ih-callout ih-callout_bad\">{error}</p>\n        </template>\n\n        <div class=\"layout\">\n            <section class=\"ih-card list-card\" aria-label=\"Transactions\">\n                <div class=\"ih-card-head\">\n                    <h2 class=\"ih-card-title\">Results</h2>\n                    <span class=\"ih-small\">{countText}</span>\n                </div>\n                <template lwc:if={loading}>\n                    <div class=\"ih-spinner\"><lightning-spinner alternative-text=\"Loading\" size=\"small\"></lightning-spinner></div>\n                </template>\n                <template lwc:if={hasRows}>\n                    <div class=\"ih-table-wrap\">\n                        <table class=\"ih-table\">\n                            <thead>\n                                <tr>\n                                    <template lwc:if={isAdmin}>\n                                        <th class=\"first\" scope=\"col\"><span class=\"slds-assistive-text\">Select</span></th>\n                                    </template>\n                                    <th scope=\"col\">Transaction</th>\n                                    <th scope=\"col\">Event</th>\n                                    <th scope=\"col\">Connection or handler</th>\n                                    <th scope=\"col\">Status</th>\n                                    <th scope=\"col\">Reference or error</th>\n                                    <th scope=\"col\">Related record</th>\n                                    <th scope=\"col\">Attempts</th>\n                                    <th class=\"last\" scope=\"col\">Created</th>\n                                </tr>\n                            </thead>\n                            <tbody>\n                                <template for:each={viewRows} for:item=\"r\">\n                                    <tr key={r.id} class={r.rowClass} data-id={r.id} onclick={handleSelect}>\n                                        <template lwc:if={isAdmin}>\n                                            <td class=\"first\" onclick={stop}>\n                                                <lightning-input type=\"checkbox\" variant=\"label-hidden\" label={r.selectLabel} data-id={r.id}\n                                                    checked={r.checked} disabled={r.selectDisabled} onchange={handleCheck}></lightning-input>\n                                            </td>\n                                        </template>\n                                        <td>\n                                            <span class=\"ih-row\">\n                                                <span class={r.directionClass}>{r.directionText}</span>\n                                                <a class=\"ih-link\" href={r.url} data-id={r.id} data-label={r.name} onclick={handleOpen}>{r.name}</a>\n                                            </span>\n                                        </td>\n                                        <td>{r.eventName}</td>\n                                        <td>{r.targetName}</td>\n                                        <td><span class={r.badgeClass}>{r.status}</span></td>\n                                        <td class={r.noteClass}>{r.note}</td>\n                                        <td>\n                                            <template lwc:if={r.relatedId}>\n                                                <a class=\"ih-link\" href={r.relatedUrl} data-id={r.relatedId} onclick={handleOpen}>{r.relatedText}</a>\n                                            </template>\n                                        </td>\n                                        <td class=\"ih-nowrap\">{r.attempts}</td>\n                                        <td class=\"ih-nowrap last\">\n                                            <lightning-formatted-date-time value={r.createdDate} month=\"short\" day=\"numeric\" hour=\"numeric\"\n                                                minute=\"2-digit\"></lightning-formatted-date-time>\n                                        </td>\n                                    </tr>\n                                </template>\n                            </tbody>\n                        </table>\n                    </div>\n                    <template lwc:if={hasNext}>\n                        <div class=\"more\"><lightning-button label=\"Load more\" onclick={handleMore}></lightning-button></div>\n                    </template>\n                    <template lwc:if={showWideHint}>\n                        <p class=\"ih-small hint\">{wideHintText}</p>\n                    </template>\n                </template>\n                <template lwc:if={isEmpty}>\n                    <p class=\"ih-empty\">No transactions match these filters.</p>\n                </template>\n            </section>\n\n            <template lwc:if={selected}>\n                <section class=\"ih-card detail\" aria-label=\"Transaction details\">\n                    <div class=\"ih-card-head\">\n                        <h2 class=\"ih-card-title\">{selected.name}</h2>\n                        <div class=\"ih-row\">\n                            <template lwc:if={selectedCanRetry}>\n                                <lightning-button variant=\"brand\" label=\"Retry with new payload\" icon-name=\"utility:refresh\"\n                                    data-mode=\"new\" title=\"Rebuild the payload from the record as it is now, then send\"\n                                    onclick={handleRetryOne} disabled={busy}></lightning-button>\n                                <lightning-button label=\"Resend original payload\" icon-name=\"utility:send\"\n                                    data-mode=\"original\" title=\"Send the stored Request Payload again, unchanged\"\n                                    onclick={handleRetryOne} disabled={busy}></lightning-button>\n                            </template>\n                            <lightning-button-icon icon-name=\"utility:close\" variant=\"bare\" alternative-text=\"Close\"\n                                onclick={closeDetail}></lightning-button-icon>\n                        </div>\n                    </div>\n                    <div class=\"ih-card-body\">\n                        <dl class=\"ih-kv\">\n                            <template for:each={detailFields} for:item=\"f\">\n                                <div key={f.key} class=\"kv-row\">\n                                    <dt>{f.label}</dt>\n                                    <dd>\n                                        <template lwc:if={f.isDate}>\n                                            <lightning-formatted-date-time value={f.value} year=\"numeric\" month=\"short\" day=\"numeric\"\n                                                hour=\"numeric\" minute=\"2-digit\" second=\"2-digit\"></lightning-formatted-date-time>\n                                        </template>\n                                        <template lwc:else>{f.value}</template>\n                                    </dd>\n                                </div>\n                            </template>\n                        </dl>\n                        <template lwc:if={hasBodies}>\n                            <template for:each={detailBodies} for:item=\"b\">\n                                <div key={b.key} class=\"body\">\n                                    <span class=\"ih-small\">{b.label}</span>\n                                    <pre class=\"ih-pre\">{b.text}</pre>\n                                </div>\n                            </template>\n                        </template>\n                    </div>\n                </section>\n            </template>\n        </div>\n    </div>\n</template>"}
