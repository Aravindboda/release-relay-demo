{"path":"force-app/main/default/lwc/ihSetupFieldPicker/ihSetupFieldPicker.html","left":null,"right":"<template>\n    <div class=\"picker\">\n        <div class=\"pane pane_list\">\n            <lightning-input type=\"search\" label=\"Search fields\" variant=\"label-hidden\" placeholder={searchPlaceholder}\n                value={search} onchange={handleSearch} disabled={disabled}></lightning-input>\n            <template lwc:if={loading}>\n                <div class=\"ih-spinner\"><lightning-spinner alternative-text=\"Loading fields\" size=\"small\"></lightning-spinner></div>\n            </template>\n            <template lwc:elseif={error}>\n                <p class=\"ih-small ih-bad-text pad\">{error}</p>\n            </template>\n            <template lwc:elseif={hasOptions}>\n                <ul class=\"rows\" role=\"list\">\n                    <template for:each={rows} for:item=\"row\">\n                        <li key={row.key}>\n                            <template lwc:if={row.isGroup}>\n                                <button type=\"button\" class={row.cls} data-value={row.value} aria-expanded={row.ariaExpanded}\n                                    onclick={handleGroup}>\n                                    <span class=\"row-label\">\n                                        {row.label}\n                                        <lightning-icon icon-name={row.icon} size=\"xx-small\" alternative-text=\"\"></lightning-icon>\n                                    </span>\n                                    <span class=\"row-api ih-mono\">{row.api}</span>\n                                </button>\n                            </template>\n                            <template lwc:else>\n                                <button type=\"button\" class={row.cls} data-value={row.value} aria-pressed={row.ariaPressed}\n                                    onclick={handleRow} disabled={disabled}>\n                                    <span class=\"row-label\">\n                                        <template lwc:if={row.isChosen}>\n                                            <lightning-icon icon-name=\"utility:check\" size=\"xx-small\" alternative-text=\"Chosen\"></lightning-icon>\n                                        </template>\n                                        {row.label}\n                                    </span>\n                                    <span class=\"row-api ih-mono\">{row.api}</span>\n                                </button>\n                            </template>\n                        </li>\n                    </template>\n                </ul>\n                <template lwc:if={typedPath}>\n                    <button type=\"button\" class=\"add-typed ih-link\" onclick={handleAddTyped}>+ Add {typedPath} as typed</button>\n                </template>\n                <template lwc:if={moreHidden}>\n                    <p class=\"ih-small pad\">More fields match: type more to narrow the list.</p>\n                </template>\n                <template lwc:if={noMatch}>\n                    <p class=\"ih-small pad\">No field matches.</p>\n                </template>\n            </template>\n            <template lwc:else>\n                <p class=\"ih-small pad\">Enter the Related Object to pick its fields.</p>\n            </template>\n        </div>\n        <div class=\"pane pane_chosen\">\n            <p class=\"ih-small\">Selected ({count}) · drag to reorder</p>\n            <template lwc:if={hasChips}>\n                <ul class=\"chips\" role=\"list\">\n                    <template for:each={chips} for:item=\"chip\">\n                        <li key={chip.key} class={chip.cls} title={chip.title} draggable=\"true\" tabindex=\"0\"\n                            data-index={chip.index} ondragstart={handleDragStart} ondragover={handleDragOver}\n                            ondrop={handleDrop} ondragend={handleDragEnd} onkeydown={handleChipKey}>\n                            <span class=\"ih-mono\">{chip.value}</span>\n                            <button type=\"button\" class=\"chip-x\" data-index={chip.index} onclick={handleRemove}\n                                aria-label={chip.removeLabel} title={chip.removeLabel} disabled={disabled}>×</button>\n                        </li>\n                    </template>\n                </ul>\n            </template>\n            <template lwc:else>\n                <p class=\"ih-small\">No fields chosen: only the transaction Id, event, record Id and object are sent.</p>\n            </template>\n            <p class=\"ih-small\">Empty fields are left out of the JSON. Alt+Left/Right moves a focused field.</p>\n        </div>\n    </div>\n</template>"}
