{"path":"force-app/main/default/lwc/ihUsage/ihUsage.html","left":null,"right":"<template>\n    <div class=\"usage\">\n        <template lwc:if={isAdmin}>\n            <div class=\"bar\">\n                <span class=\"ih-small\">{scannedText}</span>\n                <span class=\"ih-spacer\"></span>\n                <lightning-button label=\"Scan again\" icon-name=\"utility:refresh\" onclick={handleScan} disabled={loading}></lightning-button>\n            </div>\n\n            <template lwc:if={loading}>\n                <div class=\"ih-spinner\"><lightning-spinner alternative-text=\"Scanning\" size=\"small\"></lightning-spinner></div>\n            </template>\n\n            <template lwc:if={error}>\n                <p class=\"ih-callout ih-callout_bad\">{error}</p>\n            </template>\n\n            <template lwc:if={ready}>\n                <div class=\"ih-tiles\">\n                    <template for:each={tiles} for:item=\"t\">\n                        <div key={t.key} class={t.cls}>\n                            <span class=\"ih-tile-label\">{t.label}</span>\n                            <span class=\"ih-tile-value\">{t.value}</span>\n                            <template lwc:if={t.hasMeter}>\n                                <span class=\"meter\"><span class=\"meter-fill\" style={t.meter}></span></span>\n                            </template>\n                            <template for:each={t.lines} for:item=\"l\">\n                                <span key={l.key} class=\"ih-small\">{l.text}</span>\n                            </template>\n                        </div>\n                    </template>\n                </div>\n\n                <template for:each={tables} for:item=\"tb\">\n                    <div key={tb.key} class=\"block\">\n                        <h3 class=\"block-title\">{tb.title}</h3>\n                        <div class=\"ih-table-wrap table-box\">\n                            <table class=\"ih-table\">\n                                <thead>\n                                    <tr>\n                                        <template for:each={tb.cols} for:item=\"c\">\n                                            <th key={c.key} scope=\"col\">{c.label}</th>\n                                        </template>\n                                    </tr>\n                                </thead>\n                                <tbody>\n                                    <template lwc:if={tb.isEmpty}>\n                                        <tr>\n                                            <td class=\"cell ih-muted\" colspan={tb.colspan}>{tb.empty}</td>\n                                        </tr>\n                                    </template>\n                                    <template for:each={tb.rows} for:item=\"r\">\n                                        <tr key={r.key}>\n                                            <template for:each={r.cells} for:item=\"cell\">\n                                                <td key={cell.key} class={cell.cls}>\n                                                    <template for:each={cell.parts} for:item=\"p\">\n                                                        <span key={p.key} class={p.cls}>{p.text}</span>\n                                                    </template>\n                                                </td>\n                                            </template>\n                                        </tr>\n                                    </template>\n                                </tbody>\n                            </table>\n                        </div>\n                        <template lwc:if={tb.hasNote}>\n                            <p class=\"ih-small note\">{tb.note}</p>\n                        </template>\n                    </div>\n                </template>\n\n                <template lwc:if={isImplemented}>\n                    <div>\n                        <lightning-button label={toggleLabel} variant=\"base\" onclick={handleToggle}></lightning-button>\n                    </div>\n                </template>\n                <p class=\"ih-small note\">{footnote}</p>\n            </template>\n        </template>\n        <template lwc:else>\n            <p class=\"ih-callout ih-callout_info\">{readerNote}</p>\n        </template>\n    </div>\n</template>"}
