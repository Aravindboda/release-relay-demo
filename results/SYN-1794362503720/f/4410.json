{"path":"force-app/main/default/lwc/ihPayloadPreview/ihPayloadPreview.html","left":null,"right":"<template>\n    <lightning-modal-header label={headerLabel}></lightning-modal-header>\n    <lightning-modal-body>\n        <div class=\"input-row\">\n            <lightning-input class=\"input\" label={inputLabel} value={recordInput} onchange={handleInput}\n                onkeyup={handleKey}></lightning-input>\n            <lightning-button variant=\"brand\" label=\"Build\" onclick={build} disabled={buildDisabled}\n                class=\"build\"></lightning-button>\n        </div>\n        <p class=\"ih-small object-line\">{objectLine}</p>\n        <p class=\"ih-small hint\">{hint}</p>\n\n        <template lwc:if={building}>\n            <div class=\"ih-spinner\"><lightning-spinner alternative-text=\"Building\" size=\"small\"></lightning-spinner></div>\n        </template>\n        <template lwc:if={problem}>\n            <div class=\"ih-callout ih-callout_bad\" role=\"alert\">\n                <lightning-icon icon-name=\"utility:error\" size=\"x-small\" variant=\"error\" alternative-text=\"\"></lightning-icon>\n                <span>{problem}</span>\n            </div>\n        </template>\n\n        <template lwc:if={hasResult}>\n            <div class=\"cols\">\n                <!-- left: the request -->\n                <div class=\"col\">\n                    <div class=\"sec-head\">\n                        <h3 class=\"sec-title\">{leftTitle}</h3>\n                        <button class=\"copy\" onclick={copyLeft}>{copyLeftLabel}</button>\n                    </div>\n                    <template lwc:if={isInbound}>\n                        <c-ih-code text={inboundText} max-height=\"440px\"></c-ih-code>\n                    </template>\n                    <template lwc:else>\n                        <c-ih-code text={requestLines} max-height=\"none\"></c-ih-code>\n                        <template lwc:if={hasBody}>\n                            <c-ih-code class=\"gap\" text={body} max-height=\"360px\"></c-ih-code>\n                        </template>\n                    </template>\n                </div>\n\n                <!-- right: how the answer comes back -->\n                <div class=\"col\">\n                    <div class=\"sec-head\">\n                        <h3 class=\"sec-title\">{rightTitle}</h3>\n                    </div>\n                    <template lwc:if={isInbound}>\n                        <table class=\"grid\">\n                            <thead>\n                                <tr><th>HTTP</th><th>When</th></tr>\n                            </thead>\n                            <tbody>\n                                <template for:each={inboundAnswers} for:item=\"a\">\n                                    <tr key={a.code}><td class=\"ih-nowrap\">{a.code}</td><td>{a.when}</td></tr>\n                                </template>\n                            </tbody>\n                        </table>\n                        <div class=\"sec-head gap\">\n                            <h3 class=\"sec-title\">Same X-Request-Id again</h3>\n                        </div>\n                        <c-ih-code text={sameIdText} max-height=\"none\"></c-ih-code>\n                    </template>\n                    <template lwc:else>\n                        <c-ih-code text={answerText} max-height=\"none\"></c-ih-code>\n                        <template lwc:if={expectsCallback}>\n                            <div class=\"sec-head gap\">\n                                <h3 class=\"sec-title\">{callbackTitle}</h3>\n                                <button class=\"copy\" onclick={copyCallback}>Copy</button>\n                            </div>\n                            <c-ih-code text={callbackText} max-height=\"300px\"></c-ih-code>\n                            <p class=\"ih-mono words\">{callbackWords}</p>\n                            <template lwc:if={callbackLimit}>\n                                <p class=\"ih-mono words\">{callbackLimit}</p>\n                            </template>\n                        </template>\n                    </template>\n                    <template lwc:if={businessData}>\n                        <div class=\"ih-callout ih-callout_info gap\">\n                            <lightning-icon icon-name=\"utility:info\" size=\"x-small\" alternative-text=\"\"></lightning-icon>\n                            <span>{dataNote}</span>\n                        </div>\n                        <c-ih-code class=\"gap-s\" text={envelope} max-height=\"none\"></c-ih-code>\n                    </template>\n                </div>\n            </div>\n        </template>\n    </lightning-modal-body>\n    <lightning-modal-footer>\n        <lightning-button label=\"Close\" onclick={handleClose}></lightning-button>\n    </lightning-modal-footer>\n</template>"}
