{"path":"force-app/main/default/lwc/rlyBranchDelete/rlyBranchDelete.html","left":null,"right":"<template>\n    <section role=\"dialog\" tabindex=\"-1\" aria-modal=\"true\" aria-labelledby=\"rr-bd-title\" aria-describedby=\"rr-bd-intro\"\n        class=\"slds-modal slds-fade-in-open slds-modal_large rr-modal\" onkeydown={handleKeydown}>\n        <div class=\"slds-modal__container rr-modal-container\">\n            <button type=\"button\" class=\"slds-button slds-button_icon slds-modal__close rr-close\" title=\"Close\" onclick={close}>\n                <lightning-icon icon-name=\"utility:close\" size=\"small\" variant=\"inverse\" alternative-text=\"Close\"></lightning-icon>\n            </button>\n            <div class=\"slds-modal__header rr-modal-head\">\n                <h1 id=\"rr-bd-title\" class=\"slds-modal__title rr-title\">{heading}</h1>\n                <p id=\"rr-bd-intro\" class=\"rr-small rr-weak\">{intro}</p>\n            </div>\n            <div class=\"slds-modal__content rr-modal-body\">\n                <template lwc:if={error}>\n                    <div class=\"rr-msg rr-msg-bad\" role=\"alert\">{error}</div>\n                </template>\n                <div class=\"rr-prog\" role=\"status\" aria-live=\"polite\">\n                    <strong>{progressText}</strong>\n                    <span class=\"rr-bar\" aria-hidden=\"true\"><i style={barStyle}></i></span>\n                    <template lwc:if={busy}><span class=\"rr-spin\"><lightning-spinner alternative-text=\"Reading\" size=\"x-small\"></lightning-spinner></span></template>\n                </div>\n                <template lwc:if={truncated}><div class=\"rr-msg rr-msg-info\">{truncatedText}</div></template>\n                <template lwc:if={hasFailures}>\n                    <ul class=\"rr-fails\" aria-label=\"Parts that couldn't be read\">\n                        <template for:each={failureRows} for:item=\"f\">\n                            <li key={f.key} class=\"rr-msg rr-msg-bad rr-fail\">\n                                <span class=\"rr-grow\">{f.text}</span>\n                                <lightning-button label=\"Try again\" data-key={f.key} onclick={retry} disabled={busy}></lightning-button>\n                            </li>\n                        </template>\n                    </ul>\n                </template>\n\n                <div class=\"rr-bar-row\">\n                    <c-rly-search-box class=\"rr-grow\" label=\"Search the branch\" placeholder={searchHint} shown={shownCount} total={totalCount}\n                        onsearch={handleSearch}></c-rly-search-box>\n                    <div class=\"rr-segs\" role=\"group\" aria-label=\"Show\">\n                        <button type=\"button\" class={allCls} aria-pressed={allPressed} onclick={showAll}>All</button>\n                        <button type=\"button\" class={chosenCls} aria-pressed={chosenPressed} onclick={showChosen}>{chosenTabLabel}</button>\n                    </div>\n                </div>\n\n                <div class=\"rr-split\">\n                    <nav class=\"rr-types\" aria-label=\"Types\">\n                        <template for:each={types} for:item=\"t\">\n                            <button key={t.key} type=\"button\" class={t.cls} aria-pressed={t.pressed} data-key={t.key} onclick={pickType}>\n                                <span class=\"rr-grow rr-ellipsis\">{t.label}</span><span class=\"rr-weak\">{t.count}</span>\n                            </button>\n                        </template>\n                    </nav>\n                    <div class=\"rr-rows\">\n                        <div class=\"rr-row rr-row-head\" aria-hidden=\"true\">\n                            <span>On the {targetBranch} branch</span><span>In {sourceName}</span><span>Delete</span>\n                        </div>\n                        <template lwc:if={hasRows}>\n                            <template for:each={rows} for:item=\"r\">\n                                <div key={r.key} class={r.rowCls}>\n                                    <div class=\"rr-name\">\n                                        <strong class=\"rr-mono\"><template for:each={r.nameParts} for:item=\"p\"><template lwc:if={p.hit}><mark key={p.key}>{p.text}</mark></template><template lwc:else><span key={p.key}>{p.text}</span></template></template></strong>\n                                        <span class=\"rr-small rr-weak\">{r.typeLabel}</span>\n                                        <template lwc:if={r.reason}><span class=\"rr-small rr-reason\">{r.reason}</span></template>\n                                    </div>\n                                    <div><template lwc:if={r.hasTag}><span class={r.tagCls}>{r.tag}</span></template></div>\n                                    <div>\n                                        <template lwc:if={r.canChoose}>\n                                            <button type=\"button\" class={r.chipCls} aria-pressed={r.pressed} aria-label={r.chipAria} data-key={r.key} onclick={toggle}>{r.chipLabel}</button>\n                                        </template>\n                                        <template lwc:elseif={r.inRelease}><span class=\"rr-pill rr-pill-bad\">In release</span></template>\n                                    </div>\n                                </div>\n                            </template>\n                            <template lwc:if={hasMore}>\n                                <div class=\"rr-more\"><button type=\"button\" class=\"rr-textbtn\" onclick={showMore}>{moreText}</button></div>\n                            </template>\n                        </template>\n                        <template lwc:else>\n                            <p class=\"rr-empty rr-small rr-weak\">{emptyText}</p>\n                        </template>\n                    </div>\n                </div>\n                <template lwc:if={hasStillWarning}><div class=\"rr-msg rr-msg-warn\" role=\"status\">{stillWarning}</div></template>\n            </div>\n            <div class=\"slds-modal__footer rr-modal-foot\">\n                <span class=\"rr-grow rr-small\"><strong>{footText}</strong> <span class=\"rr-weak\">{limitText}</span></span>\n                <lightning-button label=\"Cancel\" onclick={close}></lightning-button>\n                <lightning-button variant=\"brand\" label={addLabel} onclick={add} disabled={noneChosen}></lightning-button>\n            </div>\n        </div>\n    </section>\n    <div class=\"slds-backdrop slds-backdrop_open\" role=\"presentation\"></div>\n</template>"}
