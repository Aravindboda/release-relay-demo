{"path":"force-app/main/default/lwc/rlyArchive/rlyArchive.html","left":null,"right":"<template>\n    <template lwc:if={statusRead}>\n        <c-rly-org-gate status={gateStatus}></c-rly-org-gate>\n        <template lwc:if={showPage}>\n            <div class=\"rr-page slds-is-relative\">\n                <template lwc:if={loading}><lightning-spinner alternative-text=\"Loading\" size=\"small\"></lightning-spinner></template>\n\n                <!-- header -->\n                <section class=\"rr-card rr-head\">\n                    <span class=\"rr-head-icon\"><lightning-icon icon-name=\"utility:archive\" size=\"x-small\" variant=\"inverse\" alternative-text=\"\"></lightning-icon></span>\n                    <div class=\"rr-head-text\">\n                        <p class=\"rr-kicker\">{appName}</p>\n                        <h1 class=\"rr-title\">Archive</h1>\n                        <p class=\"rr-head-sub rr-hide-narrow\">Numbers of what has been archived. Archived releases can't be opened again.</p>\n                    </div>\n                    <template lwc:if={canView}>\n                        <span class=\"rr-kicker\" role=\"status\">{liveText}</span>\n                        <template lwc:if={runningPill}><span class=\"rr-pill rr-pill-info\">Running…</span></template>\n                        <template lwc:if={canRun}>\n                            <span class=\"rr-run-wrap\" title={runNowReason}>\n                                <lightning-button class=\"rr-run-now\" variant=\"brand\" label={runNowLabel} onclick={openRunNow} disabled={runNowDisabled}></lightning-button>\n                            </span>\n                            <template lwc:if={showRunNowReason}><span class=\"rr-kicker rr-run-why\">{runNowReason}</span></template>\n                        </template>\n                        <template lwc:if={showApproverLine}><p class=\"rr-kicker rr-full\">Only admins can run the archive.</p></template>\n                    </template>\n                </section>\n\n                <template lwc:if={error}><div class=\"rr-msg rr-msg-bad\" role=\"alert\">{error}</div></template>\n\n                <!-- no access: developers and others (the tab is hidden for them; a direct link lands here) -->\n                <template lwc:if={noAccess}>\n                    <section class=\"rr-card rr-pad\">\n                        <div class=\"rr-empty\"><b>Ask an admin for access</b><span>The Archive tab is for Release Relay admins and approvers.</span></div>\n                    </section>\n                </template>\n\n                <template lwc:if={canView}>\n                    <!-- tiles -->\n                    <div class=\"rr-kpis\">\n                        <div class={eligibleTileCls}>\n                            <span class=\"rr-tile-label\">Eligible now</span>\n                            <span class=\"rr-tile-value\">{eligibleValue}<template lwc:if={showEligibleRecords}><small class=\"rr-hide-narrow\">releases</small></template></span>\n                            <span class=\"rr-tile-sub\"><template lwc:if={showEligibleRecords}><b>{eligibleRecordsText}</b></template>{eligibleSub}{eligibleNarrowSub}</span>\n                            <template lwc:if={eligibleNextText}><span class=\"rr-tile-sub\">{eligibleNextText}</span></template>\n                        </div>\n                        <div class=\"rr-tile\">\n                            <span class=\"rr-tile-label\">Archived so far</span>\n                            <span class=\"rr-tile-value\">{archivedValue}<small class=\"rr-hide-narrow\">releases</small></span>\n                            <template lwc:if={hasRuns}><span class=\"rr-tile-sub\"><b>{archivedRecordsText}</b> records</span></template>\n                            <template lwc:else><span class=\"rr-tile-sub\">No runs yet</span></template>\n                            <template lwc:if={archivedSince}><span class=\"rr-tile-sub\">{archivedSince}</span></template>\n                        </div>\n                        <div class=\"rr-tile rr-tile-good\">\n                            <span class=\"rr-tile-label\">Storage freed</span>\n                            <span class=\"rr-tile-value\">{freedValue}<small>MB</small></span>\n                            <span class=\"rr-tile-sub\">{freedPerRecord}</span>\n                            <template lwc:if={freedMoreText}><span class=\"rr-tile-sub\">{freedMoreText}</span></template>\n                        </div>\n                        <button type=\"button\" class=\"rr-tile rr-tile-btn\" onclick={scrollToRuns} title=\"Runs list\">\n                            <span class=\"rr-tile-go\" aria-hidden=\"true\">›</span>\n                            <span class=\"rr-tile-label\">Last run</span>\n                            <span class=\"rr-tile-value rr-tile-txt\">{lastRunWhen}</span>\n                            <template lwc:if={lastRun}><span class=\"rr-tile-sub\"><b>{lastRunHow}</b>{lastRunBy}</span></template>\n                            <template lwc:if={lastRunNums}><span class=\"rr-tile-sub\">{lastRunNums}</span></template>\n                        </button>\n                        <button type=\"button\" class=\"rr-tile rr-tile-btn rr-tile-blue rr-tile-wide\" onclick={openRetention} title=\"Pipeline › Retention\">\n                            <span class=\"rr-tile-go\" aria-hidden=\"true\">›</span>\n                            <span class=\"rr-tile-label\">Retention setting</span>\n                            <span class=\"rr-tile-value rr-tile-txt\">{settingValue}</span>\n                            <template lwc:if={settingLead}><span class=\"rr-tile-sub\"><b>{settingLead}</b>{settingTail}</span></template>\n                            <span class=\"rr-tile-sub rr-tile-link\">{settingLink}</span>\n                        </button>\n                    </div>\n\n                    <!-- empty states -->\n                    <template lwc:if={showNoDays}>\n                        <section class=\"rr-card rr-pad\">\n                            <div class=\"rr-empty\">\n                                <b>Set retention on the Pipeline tab</b>\n                                <span>Choose how many days finished releases are kept. Nothing is removed until you do.</span>\n                                <lightning-button label=\"Open Pipeline › Retention\" onclick={openRetention}></lightning-button>\n                            </div>\n                        </section>\n                    </template>\n                    <template lwc:if={showNothingEligible}>\n                        <section class=\"rr-card rr-pad\">\n                            <div class=\"rr-empty\"><b>Nothing to archive right now</b><span>{nothingText}</span></div>\n                        </section>\n                    </template>\n\n                    <template lwc:if={showDetail}>\n                        <!-- nightly job -->\n                        <section class=\"rr-card\" aria-label=\"Nightly job\">\n                            <div class=\"rr-card-hd\">\n                                <h2 class=\"rr-h2\">Nightly job</h2>\n                                <span class=\"rr-weak rr-small\">{healthSub}</span>\n                                <span class=\"rr-grow\"></span>\n                                <span class={healthPillCls}>{healthPill}</span>\n                            </div>\n                            <div class=\"rr-hl\">\n                                <div class=\"rr-hl-cell\"><span class=\"rr-hl-l\">{hRunsLabel}</span><span class=\"rr-hl-v\">{hRuns}</span><span class=\"rr-hl-s rr-hide-narrow\">{hRunsSub}</span></div>\n                                <div class=\"rr-hl-cell\"><span class=\"rr-hl-l\">{hSucceededLabel}</span><span class=\"rr-hl-v\">{hSucceeded}</span><span class=\"rr-hl-s rr-hide-narrow\">all eligible removed</span></div>\n                                <div class={hFailedCls}><span class=\"rr-hl-l\">Failed</span><span class=\"rr-hl-v\">{hFailed}</span><span class=\"rr-hl-s rr-hide-narrow\">{hFailedDates}</span></div>\n                                <div class=\"rr-hl-cell\"><span class=\"rr-hl-l\">Partial</span><span class=\"rr-hl-v\">{hPartial}</span><span class=\"rr-hl-s rr-hide-narrow\">continued next night</span></div>\n                                <div class=\"rr-hl-cell rr-hl-call rr-hide-narrow\"><span class=\"rr-hl-l\">Last nightly call received</span><span class={lastCallCls}>{lastCallText}</span><span class=\"rr-hl-s\">{lastCallSub}</span></div>\n                                <div class=\"rr-hl-cell rr-hl-fail rr-hide-narrow\">\n                                    <span class=\"rr-hl-l\">{lastFailureTitle}</span>\n                                    <span class={lastFailureCls}>{lastFailureText}</span>\n                                    <template lwc:if={lastFailureUrl}><a class=\"rr-hl-s rr-a\" href={lastFailureUrl} target=\"_blank\" rel=\"noopener noreferrer\" title={lastFailureLink}>{lastFailureLink}</a></template>\n                                </div>\n                            </div>\n                            <p class=\"rr-hl-narrow rr-show-narrow\">Last call <b>{lastCallNarrow}</b>{narrowHealthLine}\n                                <template lwc:if={lastFailureUrl}> <a class=\"rr-a\" href={lastFailureUrl} target=\"_blank\" rel=\"noopener noreferrer\">{lastFailureLink}</a></template></p>\n                            <template lwc:if={showMissedLine}>\n                                <p class=\"rr-miss-line\" role=\"status\">{missedLine}</p>\n                            </template>\n                            <template lwc:if={showMissedBox}>\n                                <div class=\"rr-miss\" role=\"alert\">\n                                    <lightning-icon icon-name=\"utility:warning\" size=\"x-small\" alternative-text=\"Warning\" class=\"rr-miss-icon\"></lightning-icon>\n                                    <div>\n                                        <b>{missedTitle}</b>\n                                        <p>“Archive every night” is on, but the pipeline's scheduled job hasn't called {missedSince}. Check the schedule in <span class=\"rr-mono\">release-relay.yml</span> and that the workflow is enabled in GitHub → Actions.\n                                            <button type=\"button\" class=\"rr-link rr-sp\" onclick={openGuide}>Guide › Nightly archive ›</button></p>\n                                    </div>\n                                </div>\n                            </template>\n                        </section>\n\n                        <div class=\"rr-row2\">\n                            <!-- releases archived per month (plain HTML bars) -->\n                            <section class=\"rr-card\" aria-label=\"Releases archived per month\">\n                                <div class=\"rr-card-hd\">\n                                    <h2 class=\"rr-h2\"><span class=\"rr-hide-narrow\">Releases archived per month</span><span class=\"rr-show-narrow\">Per month</span></h2>\n                                    <span class=\"rr-weak rr-small\">Last 12 months</span>\n                                </div>\n                                <template lwc:if={hasMonths}>\n                                    <div class=\"rr-chart\">\n                                        <div class=\"rr-plot\" role=\"img\" aria-label={chartAria}>\n                                            <div class=\"rr-axis-y\" aria-hidden=\"true\">\n                                                <template for:each={chart.grid} for:item=\"g\">\n                                                    <span key={g.key} class=\"rr-gl\" style={g.style}><i>{g.text}</i></span>\n                                                </template>\n                                            </div>\n                                            <ol class=\"rr-bars\">\n                                                <template for:each={chart.bars} for:item=\"b\">\n                                                    <li key={b.key} class=\"rr-col\" title={b.tip}>\n                                                        <span class=\"rr-bar-area\">\n                                                            <span class={b.barCls} style={b.barStyle}><span class={b.valueCls}>{b.value}</span></span>\n                                                        </span>\n                                                        <span class=\"rr-m\"><span class=\"rr-hide-narrow\">{b.label}</span><span class=\"rr-show-narrow\">{b.letter}</span></span>\n                                                        <span class=\"rr-y rr-hide-narrow\">{b.year}</span>\n                                                        <span class=\"slds-assistive-text\">{b.tip}</span>\n                                                    </li>\n                                                </template>\n                                            </ol>\n                                        </div>\n                                        <div class=\"rr-chart-foot\">\n                                            <template lwc:if={chart.hasCut}>\n                                                <span class=\"rr-hide-narrow\">{chart.cutLabel}: <b>{chart.cutValue}</b>{cutNote} · bar cut to keep the other months readable</span>\n                                                <span class=\"rr-show-narrow\">{chart.cutShort}: <b>{chart.cutValue}</b> (cut)</span>\n                                            </template>\n                                            <template lwc:if={chart.hasCurrent}>\n                                                <span class=\"rr-hide-narrow\">{chart.currentLabel} so far: <b>{chart.currentValue}</b></span>\n                                                <span class=\"rr-show-narrow\">· {chart.currentShort} so far: <b>{chart.currentValue}</b></span>\n                                            </template>\n                                            <template lwc:if={chart.hasDash}><span class=\"rr-hide-narrow\">– no retention set yet</span></template>\n                                        </div>\n                                    </div>\n                                </template>\n                                <template lwc:else>\n                                    <div class=\"rr-pad\"><div class=\"rr-empty\"><b>No runs yet.</b><span>Bars appear after the first run.</span></div></div>\n                                </template>\n                            </section>\n\n                            <!-- how a run works -->\n                            <section class=\"rr-card rr-hide-narrow\" aria-label=\"How a run works\">\n                                <div class=\"rr-card-hd\"><h2 class=\"rr-h2\">How a run works</h2></div>\n                                <ul class=\"rr-how\">\n                                    <li><span class=\"rr-ic rr-ic-B\">1</span><span>Finds finished releases older than <b>{howDays}</b>: Deployed, Rejected, Failed, Rolled back, Closed. Never open, waiting or running ones, or one whose promotion is still open.</span></li>\n                                    <li><span class=\"rr-ic rr-ic-B\">2</span><span>Removes up to <b>{passSizeText}</b> per pass with their items, history, evidence PDFs, manual steps, step runs and back promote syncs, then empties the Recycle Bin for them.</span></li>\n                                    <li><span class=\"rr-ic rr-ic-B\">3</span><span>Repeats passes until nothing is eligible. Nightly: the Git pipeline's scheduled job. Run now: this page, while you watch.</span></li>\n                                    <li><span class=\"rr-ic rr-ic-G\">✓</span><span>Leaves one summary row per run (below). Git keeps branches, pull requests and snapshots.</span></li>\n                                </ul>\n                            </section>\n                        </div>\n\n                        <!-- runs list: fixed columns, pinned header, scroll inside, search with highlight -->\n                        <section class=\"rr-card rr-list-card\" aria-label=\"Runs\" data-id=\"runs\">\n                            <div class=\"rr-card-hd\">\n                                <h2 class=\"rr-h2\">Runs</h2>\n                                <span class=\"rr-pill rr-pill-none\">{runTotalText}</span>\n                                <span class=\"rr-grow\"></span>\n                                <span class=\"rr-weak rr-small rr-hide-narrow\">One row per run · numbers only</span>\n                            </div>\n                            <template lwc:if={hasRunRows}>\n                                <div class=\"rr-toolbar\">\n                                    <c-rly-search-box label=\"Search runs\" placeholder=\"Search by date, who or message\"\n                                        shown={runsShown} total={runsTotal} onsearch={handleSearch}></c-rly-search-box>\n                                    <div class=\"rr-chips rr-hide-narrow\" role=\"group\" aria-label=\"Show runs\">\n                                        <template for:each={filterChips} for:item=\"c\">\n                                            <button key={c.value} type=\"button\" class={c.cls} data-value={c.value} onclick={pickFilter} aria-pressed={c.pressed}>{c.label} <i>{c.count}</i></button>\n                                        </template>\n                                    </div>\n                                    <div class=\"rr-chips rr-hide-narrow\" role=\"group\" aria-label=\"Status\">\n                                        <span class=\"rr-kicker\">Status:</span>\n                                        <template for:each={statusChips} for:item=\"s\">\n                                            <button key={s.value} type=\"button\" class={s.cls} data-value={s.value} onclick={pickFilter} aria-pressed={s.pressed} title={s.title}>{s.label}</button>\n                                        </template>\n                                    </div>\n                                </div>\n                                <div class=\"rr-scroll rr-scroll-runs\">\n                                    <table class=\"rr-ft rr-ft-runs\">\n                                        <template lwc:if={narrow}>\n                                            <colgroup><col><col class=\"rr-w-72\"><col class=\"rr-w-96\"></colgroup>\n                                            <thead><tr><th scope=\"col\">When</th><th scope=\"col\" class=\"rr-r\">Releases</th><th scope=\"col\">Status</th></tr></thead>\n                                        </template>\n                                        <template lwc:else>\n                                            <colgroup><col class=\"rr-w-132\"><col class=\"rr-w-72\"><col class=\"rr-w-120\"><col class=\"rr-w-70\"><col class=\"rr-w-72\"><col class=\"rr-w-74\"><col class=\"rr-w-158\"><col class=\"rr-w-116\"><col></colgroup>\n                                            <thead><tr>\n                                                <th scope=\"col\" aria-sort=\"descending\">When <span class=\"rr-so\" aria-hidden=\"true\">▼</span></th><th scope=\"col\">How</th><th scope=\"col\">By</th>\n                                                <th scope=\"col\" class=\"rr-r\">Releases</th><th scope=\"col\" class=\"rr-r\">Records</th><th scope=\"col\" class=\"rr-r\">Freed</th>\n                                                <th scope=\"col\">Oldest – newest</th><th scope=\"col\">Status</th><th scope=\"col\">Message</th>\n                                            </tr></thead>\n                                        </template>\n                                        <template for:each={shownRuns} for:item=\"r\">\n                                            <tbody key={r.key}>\n                                                <template lwc:if={narrow}>\n                                                    <tr>\n                                                        <td><button type=\"button\" class=\"rr-rowbtn\" data-id={r.id} onclick={toggleRun} aria-expanded={r.expanded} aria-label={r.rowLabel}>\n                                                            <template for:each={r.whenParts} for:item=\"a\"><template lwc:if={a.hit}><mark key={a.key}>{a.text}</mark></template><template lwc:else><span key={a.key}>{a.text}</span></template></template><span class=\"rr-weak\"> · {r.how}</span></button></td>\n                                                        <td class=\"rr-r\">{r.releases}</td>\n                                                        <td><span class={r.statusCls}>{r.statusShort}</span></td>\n                                                    </tr>\n                                                    <template lwc:if={r.open}>\n                                                        <tr class=\"rr-detail\"><td colspan=\"3\">\n                                                            <span class=\"rr-detail-line\">{r.detail}</span>\n                                                            <span class=\"rr-detail-line\"><template for:each={r.messageParts} for:item=\"b\"><template lwc:if={b.hit}><mark key={b.key}>{b.text}</mark></template><template lwc:else><span key={b.key}>{b.text}</span></template></template>{r.sep}<template lwc:if={r.hasUrl}><a class=\"rr-a\" href={r.url} target=\"_blank\" rel=\"noopener noreferrer\" title={r.urlTip}>{r.urlText}</a></template></span>\n                                                        </td></tr>\n                                                    </template>\n                                                </template>\n                                                <template lwc:else>\n                                                    <tr>\n                                                        <td title={r.whenText}><template for:each={r.whenParts} for:item=\"c\"><template lwc:if={c.hit}><mark key={c.key}>{c.text}</mark></template><template lwc:else><span key={c.key}>{c.text}</span></template></template></td>\n                                                        <td><template for:each={r.howParts} for:item=\"d\"><template lwc:if={d.hit}><mark key={d.key}>{d.text}</mark></template><template lwc:else><span key={d.key}>{d.text}</span></template></template></td>\n                                                        <td class={r.byCls} title={r.by}><template for:each={r.byParts} for:item=\"e\"><template lwc:if={e.hit}><mark key={e.key}>{e.text}</mark></template><template lwc:else><span key={e.key}>{e.text}</span></template></template></td>\n                                                        <td class=\"rr-r\">{r.releases}</td>\n                                                        <td class=\"rr-r\">{r.records}</td>\n                                                        <td class={r.freedCls}>{r.freed}</td>\n                                                        <td class={r.rangeCls} title={r.range}>{r.range}</td>\n                                                        <td><span class={r.statusCls}>{r.status}</span></td>\n                                                        <td title={r.message}><template for:each={r.messageParts} for:item=\"f\"><template lwc:if={f.hit}><mark key={f.key}>{f.text}</mark></template><template lwc:else><span key={f.key}>{f.text}</span></template></template>{r.sep}<template lwc:if={r.hasUrl}><a class=\"rr-a\" href={r.url} target=\"_blank\" rel=\"noopener noreferrer\" title={r.urlTip}>{r.urlText}</a></template></td>\n                                                    </tr>\n                                                </template>\n                                            </tbody>\n                                        </template>\n                                        <template lwc:if={runsNoMatch}>\n                                            <tbody><tr><td colspan=\"9\" class=\"rr-nomatch\">No runs match. <button type=\"button\" class=\"rr-linkbtn\" onclick={clearSearch}>Clear search</button></td></tr></tbody>\n                                        </template>\n                                    </table>\n                                </div>\n                                <div class=\"rr-lfoot\"><span>{runsFoot}</span></div>\n                            </template>\n                            <template lwc:if={noRunsYet}>\n                                <div class=\"rr-pad\"><div class=\"rr-empty\"><b>No runs yet.</b><span>Each nightly call or Run now leaves one row here.</span></div></div>\n                            </template>\n                        </section>\n                    </template>\n                </template>\n            </div>\n\n            <!-- Run now: confirm (type the days) → progress (one pass per call) → done / stopped -->\n            <template lwc:if={modalOpen}>\n                <section role=\"dialog\" tabindex=\"-1\" aria-modal=\"true\" aria-labelledby=\"rr-run-title\" class=\"slds-modal slds-fade-in-open rr-modal\" onkeydown={handleModalKey}>\n                    <div class=\"slds-modal__container\">\n                        <button type=\"button\" class=\"slds-button slds-button_icon slds-modal__close\" title=\"Close\" onclick={closeModal} disabled={closeDisabled}>\n                            <lightning-icon icon-name=\"utility:close\" size=\"small\" alternative-text=\"Close\"></lightning-icon>\n                        </button>\n                        <div class=\"slds-modal__header rr-mh\">\n                            <h2 id=\"rr-run-title\" class=\"slds-modal__title rr-mh-title rr-grow\">{modalTitle}</h2>\n                            <template lwc:if={modalPill}><span class={modalPillCls}>{modalPill}</span></template>\n                        </div>\n                        <div class=\"slds-modal__content rr-mb\">\n                            <template lwc:if={isConfirm}>\n                                <p>Remove <b>{confirmReleases}</b> older than <b>{daysText}</b>{confirmCutoff}</p>\n                                <p class=\"rr-msg rr-msg-wait\">This can't be undone. Evidence PDFs and history go with them; Git keeps the branches and pull requests.</p>\n                                <p class=\"rr-kicker\">{confirmFacts}</p>\n                                <div onkeyup={handleConfirmKey}>\n                                    <lightning-input class=\"rr-modal-focus rr-confirm-in\" type=\"text\" label=\"Type the number of days to confirm\" value={typedDays}\n                                        placeholder={confirmHint} onchange={handleTyped} autocomplete=\"off\"></lightning-input>\n                                </div>\n                            </template>\n                            <template lwc:if={isRunningModal}>\n                                <p class=\"rr-pl\" role=\"status\">{runLine}</p>\n                                <div class={progressCls}><i style={progressStyle}></i></div>\n                                <p class=\"rr-kicker\">{runSubLine}</p>\n                                <ul class=\"rr-passes\" aria-label=\"Passes\">\n                                    <template for:each={passes} for:item=\"p\">\n                                        <li key={p.key}>\n                                            <span class=\"rr-pass-n\">{p.label}</span>\n                                            <span class=\"rr-grow\">{p.text}</span>\n                                            <template lwc:if={p.busy}><span class=\"rr-spin\" aria-hidden=\"true\"></span></template>\n                                            <template lwc:else><span class={p.pillCls}>{p.pill}</span></template>\n                                        </li>\n                                    </template>\n                                </ul>\n                            </template>\n                            <template lwc:if={isFinished}>\n                                <p class=\"rr-pl\" role=\"status\">{runLine}</p>\n                                <div class={progressCls}><i style={progressStyle}></i></div>\n                                <template lwc:if={showRunMessage}><p class={runMessageCls}>{runMessage}</p></template>\n                                <dl class=\"rr-nums\">\n                                    <div><dt>Releases</dt><dd>{doneReleases}</dd></div>\n                                    <div><dt>Records</dt><dd>{doneRecords}</dd></div>\n                                    <div><dt>Storage freed</dt><dd>{doneFreed}</dd></div>\n                                    <div><dt>Passes · time</dt><dd>{donePasses}</dd></div>\n                                    <div class=\"rr-nums-wide\"><dt>Oldest – newest removed</dt><dd>{doneRange}</dd></div>\n                                </dl>\n                                <p class=\"rr-kicker\">{finishedNote}</p>\n                            </template>\n                        </div>\n                        <div class=\"slds-modal__footer rr-mf\">\n                            <template lwc:if={isConfirm}>\n                                <lightning-button label=\"Cancel\" onclick={closeModal}></lightning-button>\n                                <lightning-button variant=\"destructive\" label=\"Run\" onclick={startArchive} disabled={runDisabled}></lightning-button>\n                            </template>\n                            <template lwc:if={isRunningModal}>\n                                <span class=\"rr-kicker rr-grow\">Leaving the page stops after this pass.</span>\n                                <lightning-button label={cancelLabel} onclick={cancelAfterPass} disabled={cancelAsked}></lightning-button>\n                            </template>\n                            <template lwc:if={isFinished}>\n                                <lightning-button class=\"rr-modal-focus\" variant=\"brand\" label=\"Close\" onclick={closeModal}></lightning-button>\n                            </template>\n                        </div>\n                    </div>\n                </section>\n                <div class=\"slds-backdrop slds-backdrop_open\" role=\"presentation\"></div>\n            </template>\n        </template>\n    </template>\n</template>"}
