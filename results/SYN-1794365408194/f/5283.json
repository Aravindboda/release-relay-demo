{"path":"force-app/main/default/lwc/rlyOrgTile/rlyOrgTile.html","left":null,"right":"<template>\n    <button type=\"button\" class={cardCls} title={t.domain} aria-haspopup=\"dialog\" onclick={handleOpen}>\n        <span class=\"rr-tile-head\">\n            <strong class=\"rr-tile-name\">{t.name}</strong>\n            <span class={t.roleCls}>{t.rolePill}</span>\n            <span class=\"rr-tile-status\"><span class={t.dotCls} aria-hidden=\"true\"></span>{t.statusText}</span>\n        </span>\n        <span class=\"rr-tile-facts\">\n            <span class=\"rr-tile-lab\">Branch</span>\n            <span class={t.branchCls}>{t.branch}</span>\n            <span class=\"rr-tile-lab\">Approval</span>\n            <span class=\"rr-tile-val\">{t.approvalText}</span>\n            <template lwc:if={t.windowText}>\n                <span class=\"rr-tile-lab\">Window</span>\n                <span class=\"rr-tile-val\">{t.windowText}</span>\n            </template>\n        </span>\n        <span class=\"rr-tile-foot\">\n            <span>{t.checkedText}</span>\n            <span class=\"rr-tile-open\" aria-hidden=\"true\">Open ›</span>\n        </span>\n        <span class=\"slds-assistive-text\">{t.openLabel}</span>\n    </button>\n</template>"}
