{"path":"force-app/main/default/lwc/rlyReleaseTickets/rlyReleaseTickets.html","left":null,"right":"<template>\n    <!-- design board: several trackers (build 47, section 4) -->\n    <section class=\"rr-tk\" aria-label=\"Work items\">\n        <div class=\"rr-tk-head\">\n            <h2 class=\"rr-h2\">Work items</h2>\n            <span class=\"rr-weak rr-small rr-grow\">{summary}</span>\n            <template lwc:if={showAdd}><lightning-button label=\"Add tickets\" icon-name=\"utility:add\" onclick={startAdd} disabled={busy}></lightning-button></template>\n        </div>\n        <template lwc:if={error}><div class=\"rr-msg rr-msg-bad\" role=\"alert\">{error}</div></template>\n        <template lwc:if={notice}><div class=\"rr-msg rr-msg-ok\" role=\"status\">{notice}</div></template>\n        <template lwc:if={hasTickets}>\n            <ul class=\"rr-tk-list\">\n                <template for:each={rows} for:item=\"t\">\n                    <li key={t.ticket} class=\"rr-tk-row\">\n                        <span class=\"rr-tk-id\">\n                            <template lwc:if={t.link}><a class=\"rr-a rr-strong\" href={t.link} target=\"_blank\" rel=\"noopener noreferrer\">{t.ticket}</a></template>\n                            <template lwc:else><strong>{t.ticket}</strong></template>\n                        </span>\n                        <span class=\"rr-small rr-weak rr-tk-tracker\">{t.trackerText}</span>\n                        <span class=\"rr-small rr-weak rr-grow\">{t.detail}</span>\n                        <span class={t.pillCls}>{t.statusText}</span>\n                        <template lwc:if={t.failed}><lightning-button label=\"Try again\" onclick={sync} disabled={busy}></lightning-button></template>\n                        <template lwc:if={canEdit}>\n                            <lightning-button label=\"Remove\" variant=\"base\" data-ticket={t.ticket} onclick={removeTicket} disabled={busy}></lightning-button>\n                        </template>\n                    </li>\n                </template>\n            </ul>\n        </template>\n        <template lwc:if={showEmpty}><p class=\"rr-small rr-weak\">{emptyText}</p></template>\n        <template lwc:if={adding}>\n            <div class=\"rr-tk-add\">\n                <c-rly-ticket-input label=\"Add tickets\" value={draft} known-tickets={knownTickets} onchange={handleDraft} disabled={busy}></c-rly-ticket-input>\n                <div class=\"rr-tk-actions\">\n                    <lightning-button label=\"Cancel\" onclick={cancelAdd} disabled={busy}></lightning-button>\n                    <lightning-button label=\"Add\" variant=\"brand\" onclick={saveAdd} disabled={busy}></lightning-button>\n                </div>\n            </div>\n        </template>\n    </section>\n</template>"}
