{"path":"force-app/main/default/lwc/rlyWindowDeploy/rlyWindowDeploy.html","left":null,"right":"<template>\n    <template lwc:if={canDeploy}>\n        <div class=\"rr-wd\">\n            <template lwc:if={asking}>\n                <lightning-textarea label=\"Why can't it wait for the window?\" value={reason} max-length=\"500\" onchange={handleReason}\n                    placeholder=\"For example: Production incident INC0042, approved by the change board\"></lightning-textarea>\n                <div class=\"rr-wd-actions\">\n                    <lightning-button label=\"Cancel\" onclick={cancel} disabled={busy}></lightning-button>\n                    <lightning-button variant=\"destructive\" label=\"Deploy now\" onclick={send} disabled={cantSend}></lightning-button>\n                </div>\n                <template lwc:if={error}><div class=\"rr-msg rr-msg-bad\" role=\"alert\">{error}</div></template>\n            </template>\n            <template lwc:else>\n                <lightning-button label=\"Deploy now anyway\" icon-name=\"utility:warning\" onclick={ask}></lightning-button>\n                <span class=\"rr-kicker\">Release Window Bypass add-on only. The reason goes into History, the evidence PDF and the Slack card.</span>\n            </template>\n        </div>\n    </template>\n</template>"}
