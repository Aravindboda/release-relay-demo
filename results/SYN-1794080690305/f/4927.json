{"path":"force-app/main/default/lwc/rlyRollback/rlyRollback.html","left":null,"right":"<template>\n    <section role=\"dialog\" tabindex=\"-1\" aria-modal=\"true\" aria-labelledby=\"rr-rb-title\" aria-describedby=\"rr-rb-intro\"\n        class=\"slds-modal slds-fade-in-open rr-modal\" onkeydown={handleKeydown}>\n        <div class=\"slds-modal__container rr-modal-container\">\n            <button type=\"button\" class=\"slds-button slds-button_icon rr-close\" title=\"Close\" onclick={cancel}>\n                <lightning-icon icon-name=\"utility:close\" size=\"x-small\" alternative-text=\"Close\"></lightning-icon>\n            </button>\n            <div class=\"slds-modal__header rr-modal-head\">\n                <h1 id=\"rr-rb-title\" class=\"slds-modal__title slds-hyphenate\">{heading}</h1>\n                <p id=\"rr-rb-intro\" class=\"rr-small rr-weak\">Puts an org back the way it was before this release. Nothing happens until you press Roll back.</p>\n            </div>\n            <div class=\"slds-modal__content rr-modal-body slds-is-relative\">\n                <template lwc:if={loading}><lightning-spinner alternative-text=\"Loading\" size=\"small\"></lightning-spinner></template>\n                <template lwc:if={error}><div class=\"rr-msg rr-msg-bad\" role=\"alert\">{error}</div></template>\n\n                <p class=\"rr-label\"><abbr class=\"slds-required\" title=\"required\">*</abbr>Org to roll back</p>\n                <div class=\"rr-chips\" role=\"radiogroup\" aria-label=\"Org to roll back\">\n                    <template for:each={chips} for:item=\"c\">\n                        <button key={c.key} type=\"button\" role=\"radio\" class={c.cls} aria-checked={c.checked} data-id={c.orgId}\n                            disabled={c.off} title={c.title} onclick={pickOrg}>\n                            <template lwc:if={c.picked}><lightning-icon icon-name=\"utility:check\" size=\"xx-small\" variant=\"inverse\" alternative-text=\"\" class=\"rr-chip-icon\"></lightning-icon></template>\n                            <strong>{c.orgName}</strong><span class=\"rr-chip-sub\">{c.sub}</span>\n                        </button>\n                    </template>\n                </div>\n                <template lwc:if={noChoices}><p class=\"rr-small rr-weak\">{noChoicesText}</p></template>\n\n                <template lwc:if={preview}>\n                    <p class=\"rr-kicker rr-head-line\">{whatHeading}</p>\n                    <ul class=\"rr-what\">\n                        <template lwc:if={restoreCount}><li>Restores <strong>{restoreText}</strong> to how they were before {ownerName} deployed{deployedText}.</li></template>\n                        <template lwc:if={removeCount}><li>Removes <strong>{removeText}</strong> the release added.</li></template>\n                        <li><strong>Git is not changed</strong> — raise a release to fix the branch.</li>\n                    </ul>\n                    <template lwc:if={promotionNote}><div class=\"rr-msg rr-msg-info\">{promotionNote}</div></template>\n\n                    <dl class=\"rr-snap\">\n                        <dt>Snapshot</dt><dd>{takenText} · <span class=\"rr-mono\">{snapshotPath}</span></dd>\n                        <template lwc:if={restoreCount}><dt>Restore</dt><dd>{restoreList}</dd></template>\n                        <template lwc:if={removeCount}><dt>Remove</dt><dd>{removeList}</dd></template>\n                    </dl>\n\n                    <template for:each={laterLines} for:item=\"l\">\n                        <div key={l.key} class=\"rr-msg rr-msg-warn\" role=\"status\">{l.text}</div>\n                    </template>\n\n                    <template lwc:if={production}>\n                        <p class=\"rr-label\">Tests in production</p>\n                        <div class=\"rr-seg\" role=\"radiogroup\" aria-label=\"Tests in production\">\n                            <template for:each={testChoices} for:item=\"t\">\n                                <button key={t.value} type=\"button\" role=\"radio\" class={t.cls} aria-checked={t.checked} data-value={t.value}\n                                    disabled={t.off} onclick={pickTests}>{t.label}</button>\n                            </template>\n                        </div>\n                        <p class=\"rr-small rr-weak\">{testsHint}</p>\n                    </template>\n                    <template lwc:else>\n                        <p class=\"rr-small rr-weak\">{sandboxTestsHint}</p>\n                    </template>\n                </template>\n\n                <lightning-input label=\"Why roll back\" required max-length=\"255\" value={reason} oninput={handleReason} onchange={handleReason}\n                    placeholder=\"What went wrong after the deploy\" class=\"rr-reason\"></lightning-input>\n            </div>\n            <div class=\"slds-modal__footer rr-modal-foot\">\n                <lightning-button label=\"Cancel\" onclick={cancel} disabled={busy}></lightning-button>\n                <lightning-button variant=\"destructive\" label=\"Roll back\" onclick={confirm} disabled={confirmDisabled}></lightning-button>\n            </div>\n        </div>\n    </section>\n    <div class=\"slds-backdrop slds-backdrop_open\" role=\"presentation\"></div>\n</template>"}
