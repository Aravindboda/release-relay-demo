{"path":"force-app/main/default/pages/ForgotPasswordConfirm.page","left":null,"right":"<apex:page showHeader=\"false\" title=\"{!$Label.site.forgot_password_confirmation}\">\n  <apex:composition template=\"{!$Site.Template}\">\n    <apex:define name=\"body\">  \n      <center>\n        <apex:panelGrid bgcolor=\"white\" columns=\"1\"> \n          <br/>\n          <br/>\n          <apex:panelGrid width=\"758\" cellpadding=\"0\" cellspacing=\"0\" bgcolor=\"white\" columns=\"1\" styleClass=\"topPanelContainer\"> \n            <br/>\n            <apex:outputPanel layout=\"block\" styleClass=\"topPanel\">\n              <apex:panelGrid width=\"758\" cellpadding=\"0\" cellspacing=\"0\" bgcolor=\"white\" columns=\"2\"> \n                <apex:image url=\"{!URLFOR($Resource.SiteSamples, 'img/clock.png')}\"/>\n                <apex:panelGroup >\n                  <br/>\n                  <apex:outputText styleClass=\"title\" value=\"{!$Label.site.temp_password_sent}\"/>\n                  <br/>\n                  <br/>\n                  <apex:outputLink value=\"{!$Page.SiteLogin}\" rendered=\"{!$Site.LoginEnabled}\">{!$Label.site.go_to_login_page}</apex:outputLink>\n                  <br/>\n                </apex:panelGroup>\n              </apex:panelGrid> \n             </apex:outputPanel>\n            <c:SitePoweredBy />\n          </apex:panelGrid> \n       </apex:panelGrid>\n      </center>\n      <br/>\n    </apex:define>\n  </apex:composition>\n</apex:page>"}
