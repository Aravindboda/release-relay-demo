{"path":"force-app/main/default/lwc/rlyTicketInput/rlyTicketInput.html","left":null,"right":"<template>\n    <div class=\"rr-ti\">\n        <span class=\"rr-ti-label\">{labelText}</span>\n        <div class=\"rr-ti-box\">\n            <template for:each={chips} for:item=\"c\">\n                <span key={c.key} class=\"rr-ti-chip\">{c.label}\n                    <template lwc:if={c.tracker}><span class=\"rr-ti-tracker\">{c.tracker}</span></template>\n                    <button type=\"button\" class=\"rr-ti-x\" data-key={c.key} onclick={remove} disabled={disabled} aria-label=\"Remove\">&times;</button>\n                </span>\n            </template>\n            <input class=\"rr-ti-input\" aria-label={labelText} type=\"text\" value={text} placeholder={hint} maxlength=\"200\" disabled={disabled}\n                onchange={handleText} oninput={handleText} onkeydown={handleKey} onblur={add} />\n        </div>\n        <template lwc:if={problem}><p class=\"rr-ti-bad\" role=\"alert\">{problem}</p></template>\n        <p class=\"rr-ti-help\">{help}</p>\n    </div>\n</template>"}
