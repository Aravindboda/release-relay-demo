{"path":"force-app/main/default/lwc/rlySlackApprovers/rlySlackApprovers.html","left":null,"right":"<template>\n    <section role=\"dialog\" tabindex=\"-1\" aria-modal=\"true\" aria-labelledby=\"rr-ap-title\" class=\"slds-modal slds-fade-in-open slds-modal_large rr-apm\" onkeydown={handleKey}>\n        <div class=\"slds-modal__container rr-apc\">\n            <button type=\"button\" class=\"slds-button slds-button_icon slds-modal__close rr-x\" title=\"Close\" onclick={handleClose}>\n                <lightning-icon icon-name=\"utility:close\" size=\"small\" variant=\"inverse\" alternative-text=\"Close\"></lightning-icon>\n            </button>\n            <div class=\"slds-modal__header rr-aph\">\n                <div class=\"rr-aph-text\">\n                    <h2 id=\"rr-ap-title\" class=\"slds-modal__title rr-aph-title\">Slack approvers</h2>\n                    <p class=\"rr-aph-sub\">People who can approve releases (RLY_Approver or RLY_Admin) and the Slack account each one approves from. {matchLabelLead}<strong>{matchLabel}</strong>{lastMatchText}</p>\n                </div>\n                <template lwc:if={isAdmin}>\n                    <div class=\"rr-aph-btns\">\n                        <template lwc:if={showMatchNow}>\n                            <lightning-button label={matchButtonLabel} onclick={handleMatchNow} disabled={matchDisabled}></lightning-button>\n                        </template>\n                        <lightning-button variant=\"brand\" label=\"Add approvers\" onclick={openAdd} disabled={matching}></lightning-button>\n                    </div>\n                </template>\n            </div>\n\n            <div class=\"slds-modal__content rr-apb\">\n                <template lwc:if={loading}><lightning-spinner alternative-text=\"Loading\" size=\"small\"></lightning-spinner></template>\n                <template lwc:if={error}><div class=\"rr-msg rr-msg-bad rr-m\" role=\"alert\">{error}</div></template>\n                <template lwc:if={problemText}>\n                    <div class=\"rr-msg rr-msg-wait rr-m\" role=\"status\">{problemText}</div>\n                </template>\n                <template lwc:if={prodNote}><div class=\"rr-msg rr-msg-wait rr-m\" role=\"status\">{prodNote}</div></template>\n                <template lwc:if={banner}>\n                    <div class={bannerCls} role=\"status\">\n                        <lightning-icon icon-name={bannerIcon} size=\"x-small\" alternative-text=\"\"></lightning-icon>\n                        <div class=\"rr-grow\"><strong>{bannerText}</strong><template lwc:if={bannerDetail}><span class=\"rr-banner-d\"> {bannerDetail}</span></template></div>\n                        <button type=\"button\" class=\"rr-iconbtn\" title=\"Dismiss\" aria-label=\"Dismiss\" onclick={closeBanner}>\n                            <lightning-icon icon-name=\"utility:close\" size=\"xx-small\" alternative-text=\"\"></lightning-icon>\n                        </button>\n                    </div>\n                </template>\n\n                <!-- Match now: progress, then the result -->\n                <template lwc:if={showRun}>\n                    <div class=\"rr-run\" role=\"status\" aria-live=\"polite\">\n                        <div class=\"rr-run-head\">\n                            <strong class=\"rr-grow\">{runTitle}</strong>\n                            <template lwc:if={runDone}><span class=\"rr-pill rr-pill-ok\">Done</span></template>\n                        </div>\n                        <template lwc:if={runRunning}>\n                            <p class=\"rr-small\">{runProgress}</p>\n                            <div class=\"rr-bar\"><div class=\"rr-bar-in\"></div></div>\n                        </template>\n                        <template lwc:if={runWait}><p class=\"rr-small rr-warn\">{runWait}</p></template>\n                        <template lwc:if={runDone}><p class=\"rr-run-sum\">{runSummary}</p></template>\n                        <template lwc:if={runProblem}><p class=\"rr-msg rr-msg-bad\">{runProblem}</p></template>\n                        <ul class=\"rr-passes\">\n                            <template for:each={runPasses} for:item=\"p\">\n                                <li key={p.key}><strong>{p.title}</strong> <span class=\"rr-weak\">{p.text}</span> <span class=\"rr-pill rr-pill-none\">{p.state}</span></li>\n                            </template>\n                        </ul>\n                        <template lwc:if={runHasMisses}>\n                            <ul class=\"rr-misses\">\n                                <template for:each={runMisses} for:item=\"m\">\n                                    <li key={m.key}><span>{m.name}</span><span class=\"rr-warn\">{m.reason}</span></li>\n                                </template>\n                            </ul>\n                        </template>\n                        <p class=\"rr-hint\">{runFoot}</p>\n                        <template lwc:if={runDone}>\n                            <div class=\"rr-run-btns\">\n                                <lightning-button label=\"Close\" onclick={closeRun}></lightning-button>\n                                <template lwc:if={runHasMisses}><lightning-button variant=\"brand\" label={runShowLabel} onclick={showMisses}></lightning-button></template>\n                            </div>\n                        </template>\n                    </div>\n                </template>\n\n                <template lwc:if={noRows}>\n                    <div class=\"rr-empty\">\n                        <strong>No approvers yet</strong>\n                        <p class=\"rr-small rr-weak\">Add the people who approve releases. They get the RLY_Approver permission set and are looked up in Slack.</p>\n                        <template lwc:if={isAdmin}><lightning-button variant=\"brand\" label=\"Add approvers\" onclick={openAdd}></lightning-button></template>\n                    </div>\n                </template>\n\n                <template lwc:if={hasRows}>\n                    <div class=\"rr-toolbar\">\n                        <c-rly-search-box label=\"Search approvers\" placeholder={searchHint} shown={shownCount} total={total} onsearch={handleSearch}></c-rly-search-box>\n                        <div class=\"rr-chips\" role=\"group\" aria-label=\"Show approvers\">\n                            <template for:each={chips} for:item=\"c\">\n                                <button key={c.key} type=\"button\" class={c.cls} aria-pressed={c.pressed} data-key={c.key} onclick={handleChip}>\n                                    <span class=\"rr-wide-only\">{c.label}</span><span class=\"rr-narrow-only\">{c.short}</span><i>{c.count}</i>\n                                </button>\n                            </template>\n                        </div>\n                        <span class=\"rr-count rr-wide-only\">{countLine}</span>\n                    </div>\n\n                    <!-- Wide: fixed columns, pinned header, scroll inside -->\n                    <div class=\"rr-scroll rr-wide-only\">\n                        <table class=\"slds-table slds-table_cell-buffer slds-table_bordered rr-table rr-ft\" aria-label=\"Slack approvers\">\n                            <colgroup>\n                                <col class=\"rr-w-name\" />\n                                <template lwc:if={showFedColumn}><col class=\"rr-w-fed\" /></template>\n                                <col class=\"rr-w-slack\" />\n                                <col class=\"rr-w-by\" />\n                                <col class=\"rr-w-on\" />\n                                <col class=\"rr-w-access\" />\n                                <col class=\"rr-w-act\" />\n                            </colgroup>\n                            <thead>\n                                <tr>\n                                    <th scope=\"col\">Name</th>\n                                    <template lwc:if={showFedColumn}><th scope=\"col\">Federation ID</th></template>\n                                    <th scope=\"col\">Slack member</th>\n                                    <th scope=\"col\">Linked by</th>\n                                    <th scope=\"col\">Linked on</th>\n                                    <th scope=\"col\">Access</th>\n                                    <th scope=\"col\" class=\"rr-ta-r\">Actions</th>\n                                </tr>\n                            </thead>\n                            <tbody>\n                                <template for:each={shownRows} for:item=\"r\">\n                                    <tr key={r.key} class={r.rowCls}>\n                                        <td title={r.name}>\n                                            <span class=\"rr-line\"><template for:each={r.nameParts} for:item=\"t\"><template lwc:if={t.hit}><mark key={t.key}>{t.text}</mark></template><template lwc:else><span key={t.key}>{t.text}</span></template></template></span>\n                                            <span class=\"rr-line rr-small rr-weak\"><template for:each={r.userParts} for:item=\"t\"><template lwc:if={t.hit}><mark key={t.key}>{t.text}</mark></template><template lwc:else><span key={t.key}>{t.text}</span></template></template></span>\n                                        </td>\n                                        <template lwc:if={showFedColumn}>\n                                            <td title={r.federationId}>\n                                                <template lwc:if={r.showFed}><span class=\"rr-line\"><template for:each={r.fedParts} for:item=\"t\"><template lwc:if={t.hit}><mark key={t.key}>{t.text}</mark></template><template lwc:else><span key={t.key}>{t.text}</span></template></template></span></template>\n                                                <template lwc:if={r.fedEmpty}><span class=\"rr-weak rr-em\">empty</span></template>\n                                            </td>\n                                        </template>\n                                        <template lwc:if={r.editing}>\n                                            <td colspan=\"3\" class=\"rr-td-input\">\n                                                <div class=\"rr-edit\" onkeydown={handleEditKey}>\n                                                    <lightning-input class=\"rr-edit-in\" variant=\"label-hidden\" label={editLabel} value={editValue} placeholder=\"e.g. U05TQ1XM8RJ\" max-length=\"20\" onchange={handleEditInput}></lightning-input>\n                                                    <lightning-button label=\"Cancel\" onclick={cancelEdit} disabled={editSaving}></lightning-button>\n                                                    <lightning-button variant=\"brand\" label={editSaveLabel} onclick={saveEdit} disabled={editSaving}></lightning-button>\n                                                </div>\n                                                <template lwc:if={editError}><p class=\"rr-field-err\" role=\"alert\">{editError}</p></template>\n                                                <p class=\"rr-hint\">On Save the hub asks Slack who it is, then links it to this approver (Linked by Admin).</p>\n                                            </td>\n                                        </template>\n                                        <template lwc:else>\n                                            <td title={r.reasonLine}>\n                                                <template lwc:if={r.linked}>\n                                                    <span class=\"rr-mono rr-line\"><template for:each={r.memberParts} for:item=\"t\"><template lwc:if={t.hit}><mark key={t.key}>{t.text}</mark></template><template lwc:else><span key={t.key}>{t.text}</span></template></template></span>\n                                                    <template lwc:if={r.showChanged}><span class=\"rr-line rr-small rr-warn\">{r.reasonLine}</span></template>\n                                                </template>\n                                                <template lwc:if={r.showReason}>\n                                                    <span class=\"rr-line rr-reason\"><lightning-icon icon-name=\"utility:warning\" size=\"xx-small\" variant=\"warning\" alternative-text=\"Needs attention\"></lightning-icon> <strong>{r.reasonText}</strong><span class=\"rr-weak\"> · {r.reasonDetail}</span></span>\n                                                </template>\n                                            </td>\n                                            <td><template lwc:if={r.hasBy}><span class={r.byCls}>{r.byText}</span></template><template lwc:else><span class=\"rr-weak\">–</span></template></td>\n                                            <td>{r.onText}</td>\n                                        </template>\n                                        <td>{r.access}</td>\n                                        <td class=\"rr-ta-r rr-acts\">\n                                            <template lwc:if={r.busy}><lightning-spinner alternative-text=\"Saving\" size=\"x-small\" class=\"rr-inline-spin\"></lightning-spinner></template>\n                                            <template lwc:if={r.hasFix}>\n                                                <lightning-button label={r.fixLabel} data-id={r.userId} data-action={r.fixAction} onclick={handleFix} disabled={r.busy}></lightning-button>\n                                            </template>\n                                            <template lwc:if={r.showKeep}>\n                                                <lightning-button label=\"Keep\" data-id={r.userId} onclick={handleKeep} disabled={r.busy}></lightning-button>\n                                            </template>\n                                            <template lwc:if={r.canAct}>\n                                                <lightning-button-menu alternative-text={r.menuLabel} title={r.menuLabel} menu-alignment=\"right\" icon-size=\"x-small\" data-id={r.userId} onselect={handleMenu}>\n                                                    <lightning-menu-item value=\"unlink\" label={r.unlinkLabel} disabled={r.unlinkOff}></lightning-menu-item>\n                                                    <lightning-menu-item value=\"set\" label=\"Set ID by hand…\"></lightning-menu-item>\n                                                    <lightning-menu-divider></lightning-menu-divider>\n                                                    <lightning-menu-item value=\"remove\" label={r.removeLabel} disabled={r.removeOff}></lightning-menu-item>\n                                                </lightning-button-menu>\n                                            </template>\n                                        </td>\n                                    </tr>\n                                </template>\n                                <template lwc:if={noMatch}>\n                                    <tr><td colspan=\"7\" class=\"rr-nomatch\">{noMatchText} <button type=\"button\" class=\"rr-linkbtn\" onclick={clearSearch}>Show all</button></td></tr>\n                                </template>\n                            </tbody>\n                        </table>\n                    </div>\n\n                    <!-- Narrow (480px and less): rows stack -->\n                    <ul class=\"rr-stack rr-narrow-only\" aria-label=\"Slack approvers\">\n                        <template for:each={shownRows} for:item=\"r\">\n                            <li key={r.key} class={r.rowCls}>\n                                <div class=\"rr-stack-top\">\n                                    <strong class=\"rr-grow rr-line\">{r.name}</strong>\n                                    <template lwc:if={r.hasBy}><span class={r.byCls}>{r.byText}</span></template>\n                                    <template lwc:if={r.canAct}>\n                                        <lightning-button-menu alternative-text={r.menuLabel} menu-alignment=\"right\" icon-size=\"x-small\" data-id={r.userId} onselect={handleMenu}>\n                                            <lightning-menu-item value=\"unlink\" label={r.unlinkLabel} disabled={r.unlinkOff}></lightning-menu-item>\n                                            <lightning-menu-item value=\"set\" label=\"Set ID by hand…\"></lightning-menu-item>\n                                            <lightning-menu-item value=\"remove\" label={r.removeLabel} disabled={r.removeOff}></lightning-menu-item>\n                                        </lightning-button-menu>\n                                    </template>\n                                </div>\n                                <span class=\"rr-line rr-small rr-weak\">{r.narrowFed}</span>\n                                <template lwc:if={r.showReason}><span class=\"rr-line rr-small rr-reason-t\">{r.reasonText}</span></template>\n                                <template lwc:if={r.linked}><span class=\"rr-line rr-small rr-mono\">{r.narrowLine}</span></template>\n                                <template lwc:if={r.editing}>\n                                    <div class=\"rr-edit\" onkeydown={handleEditKey}>\n                                        <lightning-input class=\"rr-edit-in\" variant=\"label-hidden\" label={editLabel} value={editValue} placeholder=\"e.g. U05TQ1XM8RJ\" max-length=\"20\" onchange={handleEditInput}></lightning-input>\n                                        <lightning-button label=\"Cancel\" onclick={cancelEdit} disabled={editSaving}></lightning-button>\n                                        <lightning-button variant=\"brand\" label={editSaveLabel} onclick={saveEdit} disabled={editSaving}></lightning-button>\n                                    </div>\n                                    <template lwc:if={editError}><p class=\"rr-field-err\" role=\"alert\">{editError}</p></template>\n                                </template>\n                                <template lwc:if={r.hasFix}>\n                                    <div><lightning-button label={r.fixLabel} data-id={r.userId} data-action={r.fixAction} onclick={handleFix} disabled={r.busy}></lightning-button></div>\n                                </template>\n                            </li>\n                        </template>\n                        <template lwc:if={noMatch}><li class=\"rr-nomatch\">{noMatchText} <button type=\"button\" class=\"rr-linkbtn\" onclick={clearSearch}>Show all</button></li></template>\n                    </ul>\n                    <p class=\"rr-hint rr-narrow-only rr-m\">{narrowFooter}</p>\n                </template>\n            </div>\n\n            <div class=\"slds-modal__footer rr-apf\">\n                <p class=\"rr-hint\">Linked by: <span class=\"rr-by rr-by-sso\">SSO</span> Federation ID found in Slack · <span class=\"rr-by rr-by-email\">Email</span> Salesforce email found in Slack · <span class=\"rr-by rr-by-self\">Self</span> the approver linked from Slack · <span class=\"rr-by rr-by-admin\">Admin</span> set by hand (Linked on shows who). Only linked approvers can press Approve or Reject in Slack; the rest still approve in Salesforce.</p>\n            </div>\n        </div>\n    </section>\n    <div class=\"slds-backdrop slds-backdrop_open\" role=\"presentation\"></div>\n\n    <!-- Add approvers: search active users, select several, Add -->\n    <template lwc:if={adding}>\n        <section role=\"dialog\" tabindex=\"-1\" aria-modal=\"true\" aria-labelledby=\"rr-add-title\" class=\"slds-modal slds-fade-in-open rr-addm\" onkeydown={handleKey}>\n            <div class=\"slds-modal__container\">\n                <button type=\"button\" class=\"slds-button slds-button_icon slds-modal__close\" title=\"Close\" onclick={closeAdd}>\n                    <lightning-icon icon-name=\"utility:close\" size=\"small\" variant=\"inverse\" alternative-text=\"Close\"></lightning-icon>\n                </button>\n                <div class=\"slds-modal__header rr-aph\">\n                    <h2 id=\"rr-add-title\" class=\"slds-modal__title rr-aph-title rr-grow\">Add approvers</h2>\n                    <template lwc:if={hasPicked}><span class=\"rr-pill rr-pill-info\">{pickedHeader}</span></template>\n                </div>\n                <div class=\"slds-modal__content rr-addb\">\n                    <lightning-input type=\"search\" label=\"Search people\" variant=\"label-hidden\" value={pickTerm} onchange={handlePickSearch}\n                        placeholder=\"Name, username or Federation ID\"></lightning-input>\n                    <p class=\"rr-hint\">Searches active users by name, username or Federation ID (at least 2 letters, up to 50 shown). Selected people stay selected when you search again.</p>\n                    <template lwc:if={hasCandidates}>\n                        <div class=\"rr-scroll rr-scroll-s\">\n                            <table class=\"slds-table slds-table_cell-buffer slds-table_bordered rr-table rr-ft rr-ft-narrow\" aria-label=\"People\">\n                                <colgroup><col /><col /><col /><col class=\"rr-w-pick\" /></colgroup>\n                                <thead><tr><th scope=\"col\">Name</th><th scope=\"col\">Username</th><th scope=\"col\">Federation ID</th><th scope=\"col\"><span class=\"slds-assistive-text\">Select</span></th></tr></thead>\n                                <tbody>\n                                    <template for:each={candidateRows} for:item=\"c\">\n                                        <tr key={c.userId} class={c.cls} title={c.title}>\n                                            <td>{c.name}</td>\n                                            <td>{c.username}</td>\n                                            <td><span class={c.fedCls}>{c.fedText}</span></td>\n                                            <td class=\"rr-ta-r\">\n                                                <template lwc:if={c.off}><span class=\"rr-pill rr-pill-none\" title={c.blocked}>{c.blockedTag}</span></template>\n                                                <template lwc:else>\n                                                    <button type=\"button\" class=\"rr-chip rr-pick\" aria-pressed={c.pressed} aria-label={c.pickLabel} data-id={c.userId} onclick={togglePick}>\n                                                        <template lwc:if={c.on}>Selected</template><template lwc:else>Select</template>\n                                                    </button>\n                                                </template>\n                                            </td>\n                                        </tr>\n                                    </template>\n                                </tbody>\n                            </table>\n                        </div>\n                    </template>\n                    <template lwc:else><p class=\"rr-nomatch-p\">{pickNoneText}</p></template>\n                    <template lwc:if={hasPicked}>\n                        <p class=\"rr-small\">Selected: {pickedText} · <button type=\"button\" class=\"rr-linkbtn\" onclick={clearPicked}>Clear</button></p>\n                    </template>\n                    <p class=\"rr-hint\">Greyed: already an approver, or their license can't hold RLY_Approver (hover says why).</p>\n                </div>\n                <div class=\"slds-modal__footer rr-apf rr-addf\">\n                    <span class=\"rr-hint rr-grow\">Adds the RLY_Approver permission set, then looks each one up in Slack.</span>\n                    <lightning-button label=\"Cancel\" onclick={closeAdd} disabled={addBusy}></lightning-button>\n                    <lightning-button variant=\"brand\" label={addLabel} onclick={handleAdd} disabled={addDisabled}></lightning-button>\n                </div>\n            </div>\n        </section>\n        <div class=\"slds-backdrop slds-backdrop_open rr-addbd\" role=\"presentation\"></div>\n    </template>\n</template>"}
