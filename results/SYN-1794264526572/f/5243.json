{"path":"force-app/main/default/lwc/rlyPipelineMonitor/rlyPipelineMonitor.html","left":null,"right":"<template>\n    <!-- design board: Pipeline Monitor v2 (fits the screen, each section scrolls on its own) -->\n    <template lwc:if={statusRead}>\n        <c-rly-org-gate status={hubStatus}></c-rly-org-gate>\n        <template lwc:if={showPage}>\n            <div class=\"rr-page\">\n                <div class={mainCls}>\n                    <template lwc:if={showSpinner}><lightning-spinner alternative-text=\"Loading\" size=\"small\"></lightning-spinner></template>\n\n                    <!-- header -->\n                    <section class=\"rr-card rr-head\">\n                        <span class=\"rr-head-icon\"><lightning-icon icon-name=\"utility:pulse\" size=\"x-small\" variant=\"inverse\" alternative-text=\"\"></lightning-icon></span>\n                        <div class=\"rr-head-text\">\n                            <p class=\"rr-kicker\">{appName}</p>\n                            <h1 class=\"rr-title\">Pipeline Monitor</h1>\n                        </div>\n                        <template lwc:if={hasRepos}>\n                            <lightning-combobox class=\"rr-repo\" label=\"Git repository\" variant=\"label-hidden\" value={repository} options={repoOptions}\n                                disabled={repoDisabled} onchange={handleRepo} placeholder=\"Pick a repository\"></lightning-combobox>\n                        </template>\n                        <span class=\"rr-cd\" role=\"status\">\n                            <span class={liveCls} aria-hidden=\"true\"></span>{updatedText}\n                            <template for:each={cycles} for:item=\"c\">\n                                <span key={c.key} class={tickCls} aria-hidden=\"true\" onanimationiteration={handleTick} onanimationend={handleTickEnd}></span>\n                            </template>\n                        </span>\n                        <lightning-button label=\"Refresh\" icon-name=\"utility:refresh\" onclick={refresh} disabled={refreshing}></lightning-button>\n                        <span class=\"rr-meter\" aria-hidden=\"true\">\n                            <template for:each={cycles} for:item=\"c\">\n                                <span key={c.key} class={meterCls}></span>\n                            </template>\n                        </span>\n                    </section>\n\n                    <template lwc:if={error}><div class=\"rr-msg rr-msg-bad\" role=\"alert\">{error}</div></template>\n\n                    <!-- tiles -->\n                    <div class=\"rr-tiles\">\n                        <div class=\"rr-card rr-tile rr-tile-run\">\n                            <span class=\"rr-tile-n\">{tiles.running}<template lwc:if={showRunSpin}><span class=\"rr-spin\" aria-hidden=\"true\"></span></template></span>\n                            <span class=\"rr-tile-l\">Running now</span>\n                        </div>\n                        <div class=\"rr-card rr-tile rr-tile-br\">\n                            <span class=\"rr-tile-n\">{tiles.branches}</span>\n                            <span class=\"rr-tile-l\">Branches in progress</span>\n                        </div>\n                        <div class=\"rr-card rr-tile rr-tile-ok\">\n                            <span class=\"rr-tile-n\">{tiles.succeededToday}</span>\n                            <span class=\"rr-tile-l\">Succeeded today</span>\n                        </div>\n                        <button type=\"button\" class={failedTileCls} onclick={showFailed} title=\"Show the failed runs\">\n                            <span class=\"rr-tile-n\">{tiles.failedToday}</span>\n                            <span class=\"rr-tile-l\">{failedTileHint}</span>\n                        </button>\n                    </div>\n\n                    <!-- route and active branches -->\n                    <div class=\"rr-row2\">\n                        <section class=\"rr-card rr-sec\" aria-label=\"Route\">\n                            <div class=\"rr-ct\">\n                                <h2 class=\"rr-h\">Route</h2>\n                                <span class=\"rr-c\">{laneCountText}</span>\n                                <c-rly-search-box class=\"rr-search\" label=\"Search the route\" placeholder=\"Search org, branch, release, person\"\n                                    onsearch={handleRouteSearch}></c-rly-search-box>\n                            </div>\n                            <div class=\"rr-body\">\n                                <template lwc:if={hasLanes}>\n                                    <template for:each={laneGroups} for:item=\"g\">\n                                        <div key={g.key} class=\"rr-group-wrap\">\n                                            <div class=\"rr-group\">{g.label}</div>\n                                            <template for:each={g.lanes} for:item=\"l\">\n                                                <div key={l.key} class=\"rr-lane\">\n                                                    <div class=\"rr-ln\"><span class=\"rr-ln-name\">{l.name}</span><small>{l.roleText}</small></div>\n                                                    <div class={l.chipCls} role=\"button\" tabindex=\"0\" title={l.title} data-id={l.runId} onclick={selectRun} onkeydown={selectRunKey}>\n                                                        <span class={l.badgeCls}>{l.badge}</span>\n                                                        <template lwc:if={l.hasRun}><span class=\"rr-mono rr-trunc\">{l.branch}</span></template>\n                                                        <span class=\"rr-m\">{l.meta}</span>\n                                                        <template lwc:if={l.hasRun}>\n                                                            <span class=\"rr-segs\" aria-hidden=\"true\">\n                                                                <template for:each={l.segments} for:item=\"s\"><i key={s.key} class={s.cls}></i></template>\n                                                            </span>\n                                                        </template>\n                                                    </div>\n                                                </div>\n                                            </template>\n                                        </div>\n                                    </template>\n                                </template>\n                                <template lwc:else><p class=\"rr-empty\">{laneEmpty}</p></template>\n                            </div>\n                            <div class=\"rr-foot\"><span>Grouped as on the Pipeline tab</span><span>Each org's latest run</span></div>\n                        </section>\n\n                        <section class=\"rr-card rr-sec\" aria-label=\"Active branches\">\n                            <div class=\"rr-ct\">\n                                <h2 class=\"rr-h\">Active branches</h2>\n                                <span class=\"rr-c\">{branchCountText}</span>\n                                <c-rly-search-box class=\"rr-search\" label=\"Search branches\" placeholder=\"Search branch or PR\"\n                                    onsearch={handleBranchSearch}></c-rly-search-box>\n                            </div>\n                            <div class=\"rr-body\">\n                                <template lwc:if={hasBranches}>\n                                    <template for:each={branchRows} for:item=\"b\">\n                                        <div key={b.key} class={b.rowCls} role=\"button\" tabindex=\"0\" data-id={b.runId} onclick={selectRun} onkeydown={selectRunKey}>\n                                            <i class={b.dotCls} title={b.stateText}></i>\n                                            <div class=\"rr-brl-text\"><div class=\"rr-mono rr-trunc\">{b.branch}</div><div class=\"rr-m rr-trunc\">{b.meta}</div></div>\n                                            <span class={b.badgeCls}>{b.badge}</span>\n                                        </div>\n                                    </template>\n                                </template>\n                                <template lwc:else><p class=\"rr-empty\">{branchEmpty}</p></template>\n                            </div>\n                            <div class=\"rr-foot\"><span>Running and failed first</span><span>From releases and pipeline runs</span></div>\n                        </section>\n                    </div>\n\n                    <!-- runs -->\n                    <section class=\"rr-card rr-sec rr-runs\" aria-label=\"Runs\">\n                        <div class=\"rr-ct\">\n                            <h2 class=\"rr-h\">Runs</h2>\n                            <span class=\"rr-c\">{runCountText}</span>\n                            <div class=\"rr-pills\" role=\"group\" aria-label=\"Show runs\">\n                                <template for:each={filterPills} for:item=\"f\">\n                                    <button key={f.value} type=\"button\" class={f.cls} aria-pressed={f.pressed} data-value={f.value} onclick={handleFilter}>{f.label}</button>\n                                </template>\n                            </div>\n                            <c-rly-search-box class=\"rr-search\" label=\"Search runs\" placeholder=\"Search branch, release, org, person\"\n                                onsearch={handleRunSearch}></c-rly-search-box>\n                        </div>\n                        <div class=\"rr-body\">\n                            <table class=\"rr-table\">\n                                <thead>\n                                    <tr>\n                                        <th scope=\"col\">Status</th>\n                                        <th scope=\"col\">Workflow step</th>\n                                        <th scope=\"col\">Branch</th>\n                                        <th scope=\"col\">Target org</th>\n                                        <th scope=\"col\">Release</th>\n                                        <th scope=\"col\">Started</th>\n                                        <th scope=\"col\">Duration</th>\n                                        <th scope=\"col\">Triggered by</th>\n                                        <th scope=\"col\"><span class=\"slds-assistive-text\">GitHub</span></th>\n                                    </tr>\n                                </thead>\n                                <tbody>\n                                    <template for:each={runRows} for:item=\"r\">\n                                        <tr key={r.key} class={r.rowCls} data-id={r.id} onclick={selectRun}>\n                                            <td><span class={r.badgeCls}>{r.badge}</span></td>\n                                            <td>\n                                                <button type=\"button\" class=\"rr-rowbtn\" title=\"Open the run details\">{r.step}</button>\n                                            </td>\n                                            <td class=\"rr-mono\">{r.branch}</td>\n                                            <td>{r.targetOrg}</td>\n                                            <td>\n                                                <template lwc:if={r.hasRelease}>\n                                                    <button type=\"button\" class=\"rr-link\" data-id={r.releaseId} onclick={openRelease}>{r.releaseName}</button>\n                                                </template>\n                                                <template lwc:else><span class=\"rr-weak\">{r.releaseName}</span></template>\n                                            </td>\n                                            <td>{r.startedText}</td>\n                                            <td>{r.durationText}</td>\n                                            <td>{r.actor}</td>\n                                            <td>\n                                                <template lwc:if={r.runUrl}>\n                                                    <a class=\"rr-a\" href={r.runUrl} target=\"_blank\" rel=\"noopener noreferrer\" onclick={stopClick}>View in GitHub ↗</a>\n                                                </template>\n                                            </td>\n                                        </tr>\n                                    </template>\n                                </tbody>\n                            </table>\n                            <template lwc:if={showRunEmpty}><p class=\"rr-empty\">{runEmpty}</p></template>\n                        </div>\n                        <div class=\"rr-foot\">\n                            <span>Running first, then newest</span>\n                            <template lwc:if={hasMore}>\n                                <button type=\"button\" class=\"rr-link\" onclick={loadOlder} disabled={loadingOlder}>{olderLabel}</button>\n                            </template>\n                        </div>\n                    </section>\n                </div>\n\n                <!-- run details -->\n                <template lwc:if={showDetails}>\n                    <aside class=\"rr-card rr-side\" aria-label=\"Run details\">\n                        <div class=\"rr-ct\">\n                            <h2 class=\"rr-h\">Run details</h2>\n                            <span class=\"rr-grow\"></span>\n                            <lightning-button-icon icon-name=\"utility:close\" variant=\"bare\" alternative-text=\"Close run details\" title=\"Close\" onclick={closeDetails}></lightning-button-icon>\n                        </div>\n                        <div class=\"rr-body\">\n                            <dl class=\"rr-kv\">\n                                <dt>Status</dt><dd class={detail.statusCls}>{detail.statusLabel}</dd>\n                                <dt>Release</dt>\n                                <dd>\n                                    <template lwc:if={detail.hasRelease}>\n                                        <button type=\"button\" class=\"rr-link rr-wrap\" data-id={detail.releaseId} onclick={openRelease}>{detail.release}</button>\n                                    </template>\n                                    <template lwc:else>{detail.release}</template>\n                                </dd>\n                                <dt>Step</dt><dd>{detail.step}</dd>\n                                <dt>Branch</dt><dd class=\"rr-mono rr-break\">{detail.branch}</dd>\n                                <dt>Started</dt><dd>{detail.startedText}</dd>\n                                <dt>Triggered by</dt><dd>{detail.actor}</dd>\n                                <dt>Run</dt><dd>{detail.runText}</dd>\n                            </dl>\n                            <template lwc:if={detail.hasSteps}>\n                                <ul class=\"rr-steps\">\n                                    <template for:each={detail.steps} for:item=\"s\">\n                                        <li key={s.key} class=\"rr-st\"><span class={s.iconCls} aria-hidden=\"true\">{s.mark}</span><span class={s.nameCls}>{s.name}</span><span class=\"rr-m\">{s.meta}</span></li>\n                                    </template>\n                                </ul>\n                            </template>\n                            <template lwc:else><p class=\"rr-empty rr-empty-tight\">{detail.noStepsText}</p></template>\n                            <template lwc:if={detail.failure}><pre class=\"rr-err\">{detail.failure}</pre></template>\n                            <div class=\"rr-links\">\n                                <template lwc:if={detail.hasRelease}>\n                                    <button type=\"button\" class=\"rr-link\" data-id={detail.releaseId} onclick={openRelease}>{detail.openReleaseLabel}</button>\n                                </template>\n                                <template lwc:if={detail.runUrl}>\n                                    <a class=\"rr-a\" href={detail.runUrl} target=\"_blank\" rel=\"noopener noreferrer\">Open the run log in GitHub ↗</a>\n                                </template>\n                            </div>\n                        </div>\n                    </aside>\n                </template>\n            </div>\n        </template>\n    </template>\n</template>"}
