{"path":"force-app/main/default/lwc/rlyOrgGate/rlyOrgGate.html","left":null,"right":"<template>\n    <template lwc:if={isOverride}>\n        <div class=\"rr-override\" role=\"status\">\n            <lightning-icon icon-name=\"utility:info\" size=\"x-small\" alternative-text=\"Info\"></lightning-icon>\n            <p class=\"rr-override-text\">{overrideNote}</p>\n            <template lwc:if={canTurnOff}>\n                <lightning-button variant=\"base\" label=\"Turn off\" onclick={turnOff} disabled={busy}></lightning-button>\n            </template>\n        </div>\n        <template lwc:if={error}><p class=\"rr-gate-error\" role=\"alert\">{error}</p></template>\n    </template>\n    <template lwc:if={showCard}>\n        <article class=\"slds-card rr-gate\" aria-label={title}>\n            <span class={iconCls}><lightning-icon icon-name={icon} size=\"small\" alternative-text=\"\"></lightning-icon></span>\n            <h2 class=\"rr-gate-title\">{title}</h2>\n            <p class=\"rr-gate-text\">{message}</p>\n            <template lwc:if={hasButtons}>\n                <div class=\"rr-gate-buttons\">\n                    <template lwc:if={showSetupButton}>\n                        <lightning-button variant=\"brand\" label=\"Open setup\" onclick={openSetup}></lightning-button>\n                    </template>\n                    <template lwc:if={showGuide}>\n                        <lightning-button variant={guideVariant} label=\"Open the Guide\" onclick={openGuide}></lightning-button>\n                    </template>\n                </div>\n            </template>\n            <template lwc:if={canSwitch}>\n                <div class=\"rr-gate-switch\">\n                    <lightning-input type=\"toggle\" label=\"Turn Release Relay on in this sandbox\" checked={switchOn}\n                        message-toggle-active=\"On\" message-toggle-inactive=\"Off\" onchange={handleSwitch}></lightning-input>\n                    <template lwc:if={switchOn}>\n                        <p class=\"rr-gate-confirm\">Release Relay then acts as the hub in this sandbox: it can raise, approve and deploy to the orgs registered here. Slack is switched off and the Git connection set to Not checked first; they stay off until an admin reconnects them. A refresh turns it off.</p>\n                        <div class=\"rr-gate-row\">\n                            <lightning-input class=\"rr-gate-days\" type=\"number\" label=\"Days (1 to 90)\" placeholder=\"30\" min=\"1\" max=\"90\" step=\"1\"\n                                value={days} onchange={handleDays}></lightning-input>\n                            <lightning-button variant=\"brand\" label=\"Turn on\" onclick={turnOn} disabled={cantTurnOn}></lightning-button>\n                        </div>\n                    </template>\n                    <template lwc:if={error}><p class=\"rr-gate-error\" role=\"alert\">{error}</p></template>\n                </div>\n            </template>\n        </article>\n    </template>\n</template>"}
