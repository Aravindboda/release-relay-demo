{"path":"force-app/main/default/lwc/rlyCredentials/rlyCredentials.html","left":null,"right":"<template>\n    <!-- design board: b49 section 3 -->\n    <section class=\"rr-cr\" aria-label=\"Credentials\">\n        <div class=\"rr-cr-head\">\n            <div class=\"rr-grow\">\n                <h2 class=\"rr-h2\">Credentials</h2>\n                <p class=\"rr-small rr-weak\">{subtitle}</p>\n            </div>\n            <template for:each={pills} for:item=\"p\"><span key={p.key} class={p.cls}>{p.text}</span></template>\n            <template lwc:if={canCheck}><lightning-button label={checkLabel} onclick={checkNow} disabled={busy}></lightning-button></template>\n        </div>\n        <template lwc:if={error}><div class=\"rr-msg rr-msg-bad\" role=\"alert\">{error}</div></template>\n        <template lwc:if={message}><div class=\"rr-msg rr-msg-ok\" role=\"status\">{message}</div></template>\n        <template lwc:if={busy}><p class=\"rr-small rr-weak\" role=\"status\">Checking every certificate, token and sign-in… this can take a minute.</p></template>\n        <template lwc:if={hasRows}>\n            <div class=\"rr-table\" role=\"table\" aria-label=\"Credentials\">\n                <div class=\"rr-tr rr-hd\" role=\"row\">\n                    <span role=\"columnheader\">Kind</span><span role=\"columnheader\">Name</span><span role=\"columnheader\">Status</span>\n                    <span role=\"columnheader\">Expires</span><span role=\"columnheader\">Days left</span><span role=\"columnheader\">Last checked</span>\n                    <span role=\"columnheader\">Message · how to renew</span>\n                </div>\n                <template for:each={rows} for:item=\"r\">\n                    <div key={r.key} class=\"rr-tr\" role=\"row\">\n                        <span role=\"cell\" class=\"rr-small\">{r.kind}</span>\n                        <span role=\"cell\" class=\"rr-break\"><span class=\"rr-strong\">{r.name}</span></span>\n                        <span role=\"cell\"><span class={r.pillCls}>{r.status}</span></span>\n                        <span role=\"cell\" class=\"rr-small\">{r.expiresText}</span>\n                        <span role=\"cell\" class=\"rr-small\">{r.daysText}</span>\n                        <span role=\"cell\" class=\"rr-small rr-weak\" title={r.lastOkText}>{r.checkedText}</span>\n                        <span role=\"cell\" class=\"rr-small rr-break\">\n                            <template lwc:if={r.message}><span class=\"rr-block\">{r.message}</span></template>\n                            <template lwc:if={r.showRenew}><span class=\"rr-block\"><span class=\"rr-strong\">How to renew: </span>{r.renew}</span></template>\n                        </span>\n                    </div>\n                </template>\n            </div>\n        </template>\n        <template lwc:if={noRows}><p class=\"rr-small rr-weak\">{noRowsText}</p></template>\n        <p class=\"rr-small rr-weak rr-pb\">Checked nightly with the pipeline's archive call; at most about 40 calls a pass, so a hub with many orgs carries on the next night, oldest checked first. Slack (when on) gets one message when something turns Critical, Expired or Failed.</p>\n    </section>\n</template>"}
