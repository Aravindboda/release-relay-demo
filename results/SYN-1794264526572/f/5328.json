{"path":"force-app/main/default/lwc/rlyWorkItems/rlyWorkItems.html","left":null,"right":"<template>\n    <!-- design board: Work items (build 40, section 3) -->\n    <template lwc:if={statusRead}>\n        <c-rly-org-gate status={hubStatus}></c-rly-org-gate>\n        <template lwc:if={showPage}>\n            <div class=\"rr-page\">\n                <section class=\"rr-card rr-head\">\n                    <span class=\"rr-head-icon\"><lightning-icon icon-name=\"utility:task\" size=\"x-small\" variant=\"inverse\" alternative-text=\"\"></lightning-icon></span>\n                    <div class=\"rr-head-text\">\n                        <p class=\"rr-kicker\">{appName}</p>\n                        <h1 class=\"rr-title\">Work items</h1>\n                        <p class=\"rr-kicker\">{trackerLabel}: where each ticket is, from the releases that carry it</p>\n                    </div>\n                    <div class=\"rr-segs\" role=\"group\" aria-label=\"Show\">\n                        <template for:each={filters} for:item=\"f\">\n                            <button key={f.value} type=\"button\" class={f.cls} aria-pressed={f.pressed} data-value={f.value} onclick={handleFilter}>{f.label}</button>\n                        </template>\n                    </div>\n                    <lightning-combobox class=\"rr-tracker-filter\" label=\"Tracker\" variant=\"label-hidden\" options={trackerOptions} value={trackerFilter}\n                        onchange={handleTrackerFilter}></lightning-combobox>\n                    <c-rly-search-box label=\"Search work items\" placeholder=\"Search ticket, release, title, person\" shown={shown} total={total}\n                        onsearch={handleSearch}></c-rly-search-box>\n                    <template lwc:if={canSync}><lightning-button label=\"Sync now\" icon-name=\"utility:sync\" onclick={syncNow} disabled={syncing}></lightning-button></template>\n                    <lightning-button-icon icon-name=\"utility:refresh\" variant=\"border-filled\" alternative-text=\"Read again\" title=\"Read again\" onclick={load} disabled={loading}></lightning-button-icon>\n                </section>\n                <template lwc:if={error}><div class=\"rr-msg rr-msg-bad\" role=\"alert\">{error}</div></template>\n                <template lwc:if={notice}><div class=\"rr-msg rr-msg-info\" role=\"status\">{notice}</div></template>\n                <section class=\"rr-card rr-list\" aria-label=\"Work items\">\n                    <template lwc:if={loading}><lightning-spinner alternative-text=\"Loading\" size=\"small\"></lightning-spinner></template>\n                    <div class=\"rr-scroll\">\n                        <table class=\"rr-table\">\n                            <thead>\n                                <tr>\n                                    <th scope=\"col\">Ticket</th>\n                                    <th scope=\"col\">Tracker</th>\n                                    <th scope=\"col\">Releases</th>\n                                    <th scope=\"col\">Raised</th>\n                                    <template for:each={orgs} for:item=\"o\"><th key={o.key} scope=\"col\">{o.label}</th></template>\n                                    <th scope=\"col\">Status</th>\n                                    <th scope=\"col\">Sync</th>\n                                </tr>\n                            </thead>\n                            <tbody>\n                                <template for:each={rows} for:item=\"r\">\n                                    <tr key={r.ticket}>\n                                        <td>\n                                            <template lwc:if={r.link}><a class=\"rr-a rr-strong\" href={r.link} target=\"_blank\" rel=\"noopener noreferrer\">{r.ticket}</a></template>\n                                            <template lwc:else><strong>{r.ticket}</strong></template>\n                                        </td>\n                                        <td>\n                                            <template lwc:if={r.tracker}><span class={r.kindCls}>{r.trackerType}</span> <span class=\"rr-tracker\">{r.tracker}</span></template>\n                                            <template lwc:else><span class=\"rr-weak\">Untracked</span></template>\n                                        </td>\n                                        <td>\n                                            <template for:each={r.releaseRefs} for:item=\"x\">\n                                                <button key={x.id} type=\"button\" class=\"rr-link rr-rel\" data-id={x.id} onclick={openRelease}>{x.label}</button>\n                                            </template>\n                                        </td>\n                                        <td class=\"rr-weak\">{r.raisedText}</td>\n                                        <template for:each={r.cellRows} for:item=\"c\">\n                                            <td key={c.key}><span class={c.dotCls} aria-hidden=\"true\"></span><span class={c.textCls}>{c.text}</span></td>\n                                        </template>\n                                        <td><span class={r.pillCls}>{r.status}</span></td>\n                                        <td><span class={r.syncCls} title={r.syncMessage}>{r.syncText}</span></td>\n                                    </tr>\n                                </template>\n                            </tbody>\n                        </table>\n                        <template lwc:if={noRows}><p class=\"rr-empty\">{emptyText}</p></template>\n                        <template lwc:if={truncated}><p class=\"rr-empty\">Showing the newest tickets: search to find older ones.</p></template>\n                    </div>\n                </section>\n            </div>\n        </template>\n    </template>\n</template>"}
