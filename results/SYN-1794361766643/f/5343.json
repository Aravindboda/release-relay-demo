{"path":"force-app/main/default/lwc/rlySearchBox/rlySearchBox.html","left":null,"right":"<template>\n    <div class=\"rr-sb\" role=\"search\">\n        <div class=\"rr-sb-box\">\n            <lightning-icon icon-name=\"utility:search\" size=\"x-small\" alternative-text=\"\" class=\"rr-sb-icon\"></lightning-icon>\n            <input type=\"text\" class=\"rr-sb-input\" aria-label={label} placeholder={placeholder} autocomplete=\"off\" oninput={handleInput} onkeydown={handleKeydown} />\n            <template lwc:if={hasTerm}>\n                <button type=\"button\" class=\"rr-sb-clear\" title={clearLabel} aria-label={clearLabel} onclick={handleClear}>\n                    <lightning-icon icon-name=\"utility:close\" size=\"xx-small\" alternative-text=\"\"></lightning-icon>\n                </button>\n            </template>\n        </div>\n        <template lwc:if={hasCount}>\n            <span class=\"rr-sb-count\" aria-live=\"polite\" title={countLabel}><b>{shownText}</b><template lwc:if={isFiltered}><span class=\"rr-sb-of\">of {totalText}</span></template></span>\n        </template>\n    </div>\n</template>"}
