{"path":"force-app/main/default/lwc/rlyCredentialTile/rlyCredentialTile.html","left":null,"right":"<template>\n    <!-- design board: b49 section 4 -->\n    <template lwc:if={loaded}>\n        <section class=\"rr-ct\" aria-label=\"Credentials\">\n            <span class=\"rr-ct-title\">Credentials</span>\n            <template lwc:if={allOk}>\n                <span class=\"rr-pill rr-pill-ok\">All credentials OK</span>\n                <span class=\"rr-small rr-weak\">{checkedText}</span>\n            </template>\n            <template lwc:if={notChecked}><span class=\"rr-small rr-weak\">Not checked yet: they are checked nightly with the archive call.</span></template>\n            <template lwc:if={hasProblems}>\n                <ul class=\"rr-ct-list\">\n                    <template for:each={problems} for:item=\"p\">\n                        <li key={p.key}><span class={p.pillCls}>{p.status}</span><span class=\"rr-ct-name\">{p.text}</span></li>\n                    </template>\n                </ul>\n                <span class=\"rr-small rr-weak\">{checkedText}</span>\n            </template>\n            <span class=\"rr-grow\"></span>\n            <template lwc:if={isAdmin}><button type=\"button\" class=\"rr-link\" onclick={openPipeline}>Pipeline ›</button></template>\n        </section>\n    </template>\n</template>"}
