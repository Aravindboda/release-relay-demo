{"path":"force-app/main/default/lwc/rlyMetrics/rlyMetrics.html","left":null,"right":"<template>\n    <div class=\"rr-page\">\n        <section class=\"rr-card rr-head\" aria-label=\"Filters\">\n            <div class=\"rr-title\">\n                <p class=\"rr-eyebrow\">Release Relay</p>\n                <h1 class=\"rr-h1\">Metrics</h1>\n            </div>\n            <div class=\"rr-filters\">\n                <lightning-combobox class=\"rr-pick\" label=\"Org\" value={orgId} options={orgOptions} onchange={handleOrg}></lightning-combobox>\n                <lightning-combobox class=\"rr-pick\" label=\"Developer org\" value={devOrgId} options={devOrgOptions} onchange={handleDevOrg}></lightning-combobox>\n                <div class=\"rr-segs\" role=\"group\" aria-label=\"Period\">\n                    <template for:each={periodButtons} for:item=\"p\">\n                        <button key={p.value} type=\"button\" class={p.cls} data-value={p.value} aria-pressed={p.pressed} onclick={handlePeriod}>{p.label}</button>\n                    </template>\n                </div>\n                <span class=\"rr-small rr-weak\" aria-live=\"polite\">{busyText}</span>\n                <lightning-button label=\"Download CSV\" icon-name=\"utility:download\" onclick={downloadCsv} disabled={loading}></lightning-button>\n                <lightning-button-icon icon-name=\"utility:refresh\" variant=\"border-filled\" alternative-text=\"Read again\" title=\"Read again\" onclick={refresh}></lightning-button-icon>\n                <template lwc:if={csvHref}><a class=\"rr-csv rr-small\" href={csvHref} download={csvName}>{csvName}</a></template>\n            </div>\n        </section>\n\n        <template lwc:if={error}><div class=\"rr-msg rr-msg-bad\" role=\"alert\">{error}</div></template>\n        <template lwc:if={showSpinner}>\n            <div class=\"rr-card rr-pad rr-spin\"><lightning-spinner alternative-text=\"Reading the metrics\" size=\"small\"></lightning-spinner></div>\n        </template>\n\n        <template lwc:if={hasData}>\n            <template lwc:if={truncated}>\n                <div class=\"rr-msg rr-msg-warn\" role=\"status\">A very busy period: some numbers cover the first 4,000 events only. Pick a shorter period for exact numbers.</div>\n            </template>\n            <div class=\"rr-tiles\">\n                <template for:each={tiles} for:item=\"t\">\n                    <div key={t.key} class=\"rr-card rr-tile\">\n                        <p class=\"rr-tile-k\">{t.label}<template lwc:if={t.dora}><span class=\"rr-dora\" title=\"One of the four DORA measures\">DORA</span></template></p>\n                        <p class=\"rr-tile-v\">{t.value}</p>\n                        <p class=\"rr-small rr-weak\">{t.detail}</p>\n                        <p class={t.trendCls}>{t.trend}</p>\n                    </div>\n                </template>\n            </div>\n\n            <div class=\"rr-charts\">\n                <template for:each={charts} for:item=\"c\">\n                    <section key={c.key} class=\"rr-card rr-chart\" aria-label={c.title}>\n                        <div class=\"rr-chart-h\"><h2 class=\"rr-h2\">{c.title}</h2><template lwc:if={c.note}><span class=\"rr-dora\">{c.note}</span></template></div>\n                        <template lwc:if={c.empty}><p class=\"rr-small rr-weak rr-pad\">Nothing in this period.</p></template>\n                        <template lwc:else>\n                            <svg class=\"rr-svg\" viewBox={c.viewBox} role=\"img\" aria-label={c.ariaLabel}>\n                                <line x1=\"0\" y1={c.baseY} x2={c.baseX2} y2={c.baseY} class=\"rr-axis\"></line>\n                                <template for:each={c.bars} for:item=\"b\">\n                                    <g key={b.key}>\n                                        <rect x={b.x} y={b.y} width={b.width} height={b.height} fill={b.fill} rx=\"2\"><title>{b.title}</title></rect>\n                                        <text x={b.cx} y={b.valueY} text-anchor=\"middle\" class=\"rr-val\">{b.valueText}</text>\n                                        <text x={b.cx} y={b.labelY} text-anchor=\"middle\" class=\"rr-lab\">{b.axisText}</text>\n                                    </g>\n                                </template>\n                            </svg>\n                        </template>\n                    </section>\n                </template>\n\n                <section class=\"rr-card rr-chart\" aria-label=\"Why checks fail\">\n                    <div class=\"rr-chart-h\"><h2 class=\"rr-h2\">Why checks fail · {orgName}</h2></div>\n                    <div class=\"rr-pad\">\n                        <template lwc:if={noReasons}><p class=\"rr-small rr-weak\">No failed checks in this period.</p></template>\n                        <template for:each={reasonBars} for:item=\"b\">\n                            <div key={b.key} class=\"rr-hb\" title={b.label}>\n                                <span class=\"rr-hb-l\">{b.label}</span><span class=\"rr-hb-t\"><i style={b.style}></i></span><b>{b.value}</b>\n                            </div>\n                        </template>\n                        <template lwc:if={hasFiles}>\n                            <h3 class=\"rr-h3\">Files that conflict most</h3>\n                            <template for:each={fileBars} for:item=\"b\">\n                                <div key={b.key} class=\"rr-hb\" title={b.label}>\n                                    <span class=\"rr-hb-l rr-mono\">{b.label}</span><span class=\"rr-hb-t\"><i style={b.style}></i></span><b>{b.value}</b>\n                                </div>\n                            </template>\n                        </template>\n                        <p class=\"rr-small rr-weak rr-note\">{reasonsProgress}</p>\n                        <template lwc:if={reasonsError}><p class=\"rr-msg rr-msg-bad\">{reasonsError}</p></template>\n                    </div>\n                </section>\n            </div>\n            <p class=\"rr-small rr-weak rr-foot\">From Release Relay's own history: deploys, failed deploys, rollbacks, checks and approvals. Lead time counts each release a promotion carries from the day it was raised. The developer org filter applies to lead time, approvals and checks. The archive's retention limits how far back the numbers go.</p>\n        </template>\n    </div>\n</template>"}
