{"path":"force-app/main/default/lwc/rlyReleaseList/rlyReleaseList.html","left":null,"right":"<template>\n    <template lwc:if={isReviewing}>\n        <c-rly-release-review record-id={reviewId} show-back={showBack} onclose={closeReview} onchanged={refresh}></c-rly-release-review>\n    </template>\n    <div class=\"slds-is-relative\" lwc:if={notReviewing}>\n        <template lwc:if={loading}>\n            <lightning-spinner alternative-text=\"Loading requests\" size=\"small\"></lightning-spinner>\n        </template>\n        <div class=\"slds-grid slds-wrap slds-grid_align-spread slds-grid_vertical-align-end slds-m-bottom_small\">\n            <div class=\"slds-col slds-size_1-of-1 slds-medium-size_4-of-12\">\n                <lightning-combobox label=\"View\" value={view} options={views} onchange={handleView}></lightning-combobox>\n            </div>\n            <div class=\"slds-col slds-size_1-of-1 slds-medium-size_3-of-12\">\n                <lightning-combobox label=\"Type\" value={typeFilter} options={types} onchange={handleType}></lightning-combobox>\n            </div>\n            <div class=\"slds-col slds-grid slds-gutters_x-small slds-m-top_x-small\">\n                <div class=\"slds-col\"><lightning-button label=\"Refresh\" icon-name=\"utility:refresh\" onclick={refresh}></lightning-button></div>\n            </div>\n        </div>\n        <p class=\"slds-text-color_weak slds-m-bottom_small\">Every release raised from this org. Open one to see its files, code scan and validation, and to approve it. Status updates as each pipeline step finishes; this list refreshes itself.</p>\n\n        <template lwc:if={error}>\n            <div class=\"slds-text-color_error slds-m-bottom_small\" role=\"alert\">{error}</div>\n        </template>\n        <template lwc:if={isEmpty}>\n            <div class=\"slds-box slds-theme_shade\">No requests in this view yet. Raise one from the first tab and it appears here.</div>\n        </template>\n        <template lwc:else>\n            <lightning-datatable key-field=\"Id\" data={visibleRows} columns={columns} hide-checkbox-column\n                onrowaction={handleRowAction}></lightning-datatable>\n        </template>\n\n        <template lwc:if={hasFailed}>\n            <div class=\"slds-m-top_medium\">\n                <p class=\"slds-text-title_bold slds-m-bottom_x-small\">Why these failed</p>\n                <ul class=\"slds-list_dotted\">\n                    <template for:each={failedRows} for:item=\"f\">\n                        <li key={f.Id}><strong>{f.Name}</strong>: {f.Error_Message__c}</li>\n                    </template>\n                </ul>\n            </div>\n        </template>\n    </div>\n</template>"}
