{"path":"force-app/main/default/lwc/rlyReleaseChanges/rlyReleaseChanges.html","left":null,"right":"<template>\n    <div class=\"rr-changes\">\n        <template lwc:if={loading}>\n            <div class=\"rr-loading\" role=\"status\"><span class=\"rr-spin\" aria-hidden=\"true\"></span><b>Reading the pull request's files…</b></div>\n        </template>\n        <template lwc:elseif={error}>\n            <div class=\"rr-pd\"><div class=\"rr-msg rr-msg-bad\" role=\"alert\">{error}</div><lightning-button label=\"Try again\" onclick={load}></lightning-button></div>\n        </template>\n        <template lwc:elseif={unavailableText}>\n            <div class=\"rr-pd\">\n                <div class=\"rr-msg rr-msg-info\" role=\"status\">{unavailableText}</div>\n                <template lwc:if={prUrl}><a class=\"slds-button slds-button_neutral rr-btn-s\" href={prUrl} target=\"_blank\" rel=\"noopener\">{prLabel}</a></template>\n            </div>\n        </template>\n        <template lwc:elseif={available}>\n            <div class=\"rr-chsum\">\n                <span class=\"rr-small\"><b>{changedText}</b> · <span class=\"rr-plus\">{addedText}</span> <span class=\"rr-minus\">{removedText}</span> · {intoText}</span>\n                <span class=\"rr-grow\"></span>\n                <template lwc:if={filesUrl}><a class=\"rr-link\" href={filesUrl} target=\"_blank\" rel=\"noopener\">{openLabel}</a></template>\n            </div>\n            <template lwc:if={more}>\n                <p class=\"rr-trunc rr-small\" role=\"status\"><span class=\"rr-spin rr-spin-s\" aria-hidden=\"true\"></span> {moreText}</p>\n            </template>\n            <template lwc:if={moreError}>\n                <p class=\"rr-trunc rr-small\" role=\"alert\">Some files couldn&rsquo;t be read: {moreError} <button type=\"button\" class=\"rr-linkbtn\" onclick={readMore}>Try again</button></p>\n            </template>\n            <template lwc:if={truncatedText}>\n                <p class=\"rr-trunc rr-small\">{truncatedText} · <a class=\"rr-link\" href={filesUrl} target=\"_blank\" rel=\"noopener\">{openLabel}</a></p>\n            </template>\n            <template lwc:if={hasFiles}>\n                <template lwc:if={showSearch}>\n                    <div class=\"rr-toolbar\">\n                        <c-rly-search-box label=\"Search files\" placeholder=\"Search by file name or folder\" shown={shownCount} total={rowCount}\n                            onsearch={handleSearch}></c-rly-search-box>\n                    </div>\n                </template>\n                <div class=\"rr-scroll\">\n                <ul class=\"rr-prl\" aria-label=\"Files in the pull request\">\n                    <template for:each={shownRows} for:item=\"r\">\n                        <li key={r.key}>\n                            <button type=\"button\" class={r.rowCls} data-index={r.index} onclick={openFile} title=\"Show the changes\">\n                                <span class={r.statusCls}>{r.status}</span>\n                                <span class=\"rr-pn\">\n                                    <b class=\"rr-mono\" title={r.name}><template for:each={r.nameParts} for:item=\"t\"><template lwc:if={t.hit}><mark key={t.key}>{t.text}</mark></template><template lwc:else><span key={t.key}>{t.text}</span></template></template></b>\n                                    <span class=\"rr-xs rr-weak\" title={r.folder}><template for:each={r.folderParts} for:item=\"u\"><template lwc:if={u.hit}><mark key={u.key}>{u.text}</mark></template><template lwc:else><span key={u.key}>{u.text}</span></template></template></span>\n                                    <template lwc:if={r.fromText}><span class=\"rr-xs rr-weak\">{r.fromText}</span></template>\n                                </span>\n                                <span class=\"rr-cnt\" aria-label={r.countsLabel}>\n                                    <template lwc:if={r.added}><span class=\"rr-plus\">{r.added}</span></template>\n                                    <template lwc:if={r.removed}><span class=\"rr-minus rr-sp\">{r.removed}</span></template>\n                                </span>\n                                <span class=\"rr-bar\" aria-hidden=\"true\">\n                                    <template for:each={r.blocks} for:item=\"b\"><i key={b.key} class={b.cls}></i></template>\n                                </span>\n                            </button>\n                        </li>\n                    </template>\n                </ul>\n                <template lwc:if={noMatch}>\n                    <p class=\"rr-nomatch-p\">{noMatchText} <button type=\"button\" class=\"rr-linkbtn\" onclick={clearSearch}>Clear search</button></p>\n                </template>\n                </div>\n            </template>\n            <template lwc:else>\n                <p class=\"rr-pd rr-small rr-weak\">The pull request has no changed files.</p>\n            </template>\n        </template>\n    </div>\n\n    <!-- one file's diff, in the wide dialog (board HubCompare, 5) -->\n    <template lwc:if={isOpen}>\n        <section role=\"dialog\" tabindex=\"-1\" aria-modal=\"true\" aria-labelledby=\"rr-ch-title\" class=\"slds-modal slds-fade-in-open slds-modal_large rr-modal\" onkeydown={handleKeydown}>\n            <div class=\"slds-modal__container rr-modal-container\">\n                <div class=\"slds-modal__header rr-mh\">\n                    <h1 id=\"rr-ch-title\" class=\"rr-mh-title\">{modalTitle}</h1>\n                    <span class=\"rr-grow\"></span>\n                    <template lwc:if={filesUrl}><a class=\"rr-link\" href={filesUrl} target=\"_blank\" rel=\"noopener\">{openLabel}</a></template>\n                    <p class=\"rr-mk\">{modalSub}</p>\n                </div>\n                <div class=\"slds-modal__content rr-mb\">\n                    <div class=\"rr-cmp\">\n                        <nav class=\"rr-clist\" aria-label=\"Files\">\n                            <p class=\"rr-clh\">{listHead}</p>\n                            <ul>\n                                <template for:each={rows} for:item=\"r\">\n                                    <li key={r.key}>\n                                        <button type=\"button\" class={r.itemCls} data-index={r.index} onclick={pickFile} aria-current={r.current}>\n                                            <b class=\"rr-fnm\">{r.name}</b>\n                                            <span class=\"rr-l2\"><span class={r.statusCls}>{r.status}</span><span class=\"rr-small\"><template lwc:if={r.added}><span class=\"rr-plus\">{r.added}</span></template><template lwc:if={r.removed}><span class=\"rr-minus rr-sp\">{r.removed}</span></template></span></span>\n                                        </button>\n                                    </li>\n                                </template>\n                            </ul>\n                        </nav>\n                        <div class=\"rr-pick slds-select_container\">\n                            <select class=\"slds-select\" aria-label=\"File\" onchange={pickFromSelect}>\n                                <template for:each={options} for:item=\"o\">\n                                    <option key={o.key} value={o.value} selected={o.selected}>{o.label}</option>\n                                </template>\n                            </select>\n                        </div>\n                        <div class=\"rr-pane\">\n                            <template lwc:if={patchWaiting}>\n                                <section class=\"rr-dv\" aria-label={current.filename}>\n                                    <div class=\"rr-dvh\"><b class=\"rr-mono rr-ell\">{current.filename}</b></div>\n                                    <div class=\"rr-empty\" role=\"status\"><span class=\"rr-spin\" aria-hidden=\"true\"></span><p>Reading this file&rsquo;s changes…</p></div>\n                                </section>\n                            </template>\n                            <template lwc:elseif={hasPatch}>\n                                <template lwc:if={patchNote}><p class=\"rr-trunc rr-small\">{patchNote}</p></template>\n                                <c-rly-diff-view title={current.filename} left-label={leftLabel} right-label={rightLabel} patch={current.patch}\n                                    mode=\"unified\" link-url={current.url} link-label={openLabel}></c-rly-diff-view>\n                            </template>\n                            <template lwc:else>\n                                <section class=\"rr-dv\" aria-label={current.filename}>\n                                    <div class=\"rr-dvh\"><b class=\"rr-mono rr-ell\">{current.filename}</b></div>\n                                    <div class=\"rr-empty\">\n                                        <span class=\"rr-pill rr-pill-none\">No preview</span>\n                                        <p>{noteText}</p>\n                                        <template lwc:if={current.url}><a class=\"rr-link\" href={current.url} target=\"_blank\" rel=\"noopener\">{openLabel}</a></template>\n                                    </div>\n                                </section>\n                            </template>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"slds-modal__footer rr-mf\">\n                    <button type=\"button\" class=\"slds-button slds-button_neutral rr-close\" onclick={close}>Close</button>\n                </div>\n            </div>\n        </section>\n        <div class=\"slds-backdrop slds-backdrop_open\" role=\"presentation\"></div>\n    </template>\n</template>"}
