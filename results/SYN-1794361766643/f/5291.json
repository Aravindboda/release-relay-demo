{"path":"force-app/main/default/lwc/rlyProdApproval/rlyProdApproval.html","left":null,"right":"<template>\n    <!-- design board: b49 section 2 -->\n    <section class=\"rr-pa\" aria-label=\"Approvals\">\n        <div class=\"rr-pa-head\">\n            <div class=\"rr-grow\">\n                <h2 class=\"rr-h2\">Approvals</h2>\n                <p class=\"rr-small rr-weak\">Who may approve releases into production</p>\n            </div>\n            <template lwc:if={view}><span class={pillCls}>{pillText}</span></template>\n        </div>\n        <template lwc:if={error}><div class=\"rr-msg rr-msg-bad\" role=\"alert\">{error}</div></template>\n        <template lwc:if={banner}><div class=\"rr-msg rr-msg-wait\" role=\"status\"><strong>{banner}</strong> Until then every approver can still approve production. {holdersText}</div></template>\n        <template lwc:if={view}>\n            <div class=\"rr-pa-row\">\n                <lightning-input type=\"toggle\" label=\"Production approval needs the add-on\" checked={isOn} disabled={toggleDisabled}\n                    message-toggle-active=\"On\" message-toggle-inactive=\"Off\" onchange={handleToggle}></lightning-input>\n                <p class=\"rr-small rr-weak rr-grow\">On: only holders of the Release Relay Production Approver add-on approve releases into production, here and in Slack; the Approver group alone approves the other orgs.</p>\n            </div>\n            <template lwc:if={showHolders}><p class=\"rr-small\">{holdersText}</p></template>\n            <template lwc:if={view.changedText}><p class=\"rr-small rr-weak\">{view.changedText}</p></template>\n            <template lwc:if={readOnly}><p class=\"rr-small rr-weak\">Only Release Relay admins can change this.</p></template>\n        </template>\n    </section>\n</template>"}
