{"path":"force-app/main/default/lwc/rlyRunSecurity/rlyRunSecurity.html","left":null,"right":"<template>\n    <!-- design board: b48 sections 1 and 2 -->\n    <section class=\"rr-rs\" aria-label=\"Run signing\">\n        <div class=\"rr-rs-head\">\n            <div class=\"rr-grow\">\n                <h2 class=\"rr-h2\">Run signing</h2>\n                <p class=\"rr-small rr-weak\">Only runs the hub starts can deploy; only results the pipeline signed are trusted</p>\n            </div>\n            <template lwc:if={status}><span class={signPillCls}>{signPill}</span></template>\n            <template lwc:if={showGenerate}><lightning-button label={generateLabel} onclick={generate} disabled={busy}></lightning-button></template>\n        </div>\n        <template lwc:if={error}><div class=\"rr-msg rr-msg-bad\" role=\"alert\">{error}</div></template>\n        <template lwc:if={saved}><div class=\"rr-msg rr-msg-ok\" role=\"status\">{saved}</div></template>\n\n        <template lwc:if={status}>\n            <dl class=\"rr-facts\">\n                <div><dt>Run-signing key</dt><dd>{keyText}</dd></div>\n                <div><dt>Runs</dt><dd>{runsText}</dd></div>\n                <div><dt>Results</dt><dd>{resultsText}</dd></div>\n            </dl>\n            <template lwc:if={readOnly}><p class=\"rr-small rr-weak\">Only Release Relay admins can change this.</p></template>\n        </template>\n\n        <template lwc:if={newKey}>\n            <div class=\"rr-new\" aria-label=\"New run-signing key\">\n                <div class=\"rr-rs-head\"><p class=\"rr-strong rr-grow\">New run-signing key</p><span class=\"rr-pill rr-pill-wait\">Not saved yet</span></div>\n                <div class=\"rr-key\" aria-label=\"The new key\">{newKey}</div>\n                <ol class=\"rr-steps\">\n                    <li>Copy the key.</li>\n                    <li>{whereText}</li>\n                    <li>Press Save key here. The key is never shown again.</li>\n                </ol>\n                <div class=\"rr-msg rr-msg-info\">Runs started after step 2 and before step 3 are refused by the pipeline; start them again after saving.<template lwc:if={replacing}> Saving replaces the current key: put the new one in the repository first.</template></div>\n                <div class=\"rr-actions\">\n                    <lightning-button label={copyLabel} onclick={copyKey} disabled={busy}></lightning-button>\n                    <lightning-button label=\"Cancel\" onclick={cancelKey} disabled={busy}></lightning-button>\n                    <lightning-button variant=\"brand\" label=\"Save key\" onclick={saveNewKey} disabled={busy}></lightning-button>\n                </div>\n            </div>\n        </template>\n    </section>\n\n    <section class=\"rr-rs rr-pb\" aria-label=\"Repository security\">\n        <div class=\"rr-rs-head\">\n            <div class=\"rr-grow\">\n                <h2 class=\"rr-h2\">Repository security</h2>\n                <p class=\"rr-small rr-weak\">{reportSubtitle}</p>\n            </div>\n            <template lwc:if={report}><span class={reportPillCls}>{reportPill}</span></template>\n            <template lwc:if={canEdit}><lightning-button label={checkLabel} onclick={checkRepository} disabled={busy}></lightning-button></template>\n        </div>\n        <template lwc:if={checkError}><div class=\"rr-msg rr-msg-bad\" role=\"alert\">{checkError}</div></template>\n        <template lwc:if={report}>\n            <div class=\"rr-table\" role=\"table\" aria-label=\"Repository protections\">\n                <template for:each={rows} for:item=\"r\">\n                    <div key={r.key} class=\"rr-tr\" role=\"row\">\n                        <span role=\"cell\"><span class={r.iconCls} aria-label={r.stateLabel} title={r.stateLabel}>{r.icon}</span></span>\n                        <span role=\"cell\"><span class=\"rr-strong rr-block\">{r.label}</span><span class=\"rr-small rr-weak rr-break\">{r.detail}</span></span>\n                        <span role=\"cell\" class=\"rr-small rr-break\"><template lwc:if={r.fix}><span class=\"rr-strong\">How to fix: </span>{r.fix}</template><template lwc:else><span class=\"rr-weak\">—</span></template></span>\n                    </div>\n                </template>\n            </div>\n            <p class=\"rr-small rr-weak\">Read-only: nothing is changed in the repository. Secrets and variables are read by name only.</p>\n        </template>\n        <template lwc:if={noReport}><p class=\"rr-small rr-weak\">{noReportText}</p></template>\n    </section>\n</template>"}
