{"path":"force-app/main/default/lwc/rlyReleaseReview/rlyReleaseReview.html","left":null,"right":"<template>\n    <div class=\"rr-review slds-is-relative\">\n        <template lwc:if={loading}>\n            <lightning-spinner alternative-text=\"Loading\" size=\"small\"></lightning-spinner>\n        </template>\n        <template lwc:if={error}>\n            <div class=\"rr-msg rr-msg-bad\" role=\"alert\">{error}</div>\n        </template>\n\n        <template lwc:if={ready}>\n            <!-- header -->\n            <div class=\"rr-head\">\n                <div class=\"rr-head-main\">\n                    <template lwc:if={showBack}>\n                        <button class=\"rr-link-btn rr-back\" onclick={handleBack}>← All requests</button>\n                    </template>\n                    <div class=\"rr-title-row\">\n                        <span class=\"rr-req-no\">{req.Name}</span>\n                        <h2 class=\"rr-title\">{req.Title__c}</h2>\n                        <span class={statusClass}>{req.Status__c}</span>\n                    </div>\n                    <p class=\"rr-meta\">\n                        <span class=\"rr-mono\">{route}</span>\n                        <span>· {req.Request_Type__c}</span>\n                        <span>· raised by {raisedBy}</span>\n                        <template lwc:if={review.connectionLabel}><span>· {review.connectionLabel} ({review.repository})</span></template>\n                    </p>\n                    <p class=\"rr-meta rr-links\">\n                        <template lwc:if={req.PR_URL__c}><a href={req.PR_URL__c} target=\"_blank\">{prLabel}</a></template>\n                        <template lwc:if={req.Run_URL__c}><a href={req.Run_URL__c} target=\"_blank\">Latest workflow run</a></template>\n                    </p>\n                </div>\n                <div class=\"rr-head-actions\">\n                    <template lwc:if={canApprove}>\n                        <button class=\"rr-btn rr-btn-brand\" onclick={openApprove}>✓ {approveLabel}</button>\n                    </template>\n                    <template lwc:if={canReject}>\n                        <button class=\"rr-btn rr-btn-danger\" onclick={openReject}>Reject</button>\n                    </template>\n                    <template lwc:if={canBypass}>\n                        <button class=\"rr-btn\" onclick={openBypass}>Bypass scan</button>\n                    </template>\n                    <template lwc:if={canRerun}>\n                        <button class=\"rr-btn\" onclick={handleRerun}>Re-run checks</button>\n                    </template>\n                    <template lwc:if={canSyncBack}>\n                        <button class=\"rr-btn\" onclick={handleSyncBack} title={syncBackHelp}>⇄ Sync back to {syncBackLabel}</button>\n                    </template>\n                    <button class=\"rr-btn rr-btn-quiet\" onclick={handleRefresh} title=\"Read the latest status\">⟳ Refresh</button>\n                </div>\n            </div>\n\n            <!-- pipeline -->\n            <ol class=\"rr-path\" aria-label=\"Progress\">\n                <template for:each={stages} for:item=\"s\">\n                    <li key={s.id} class={s.cls} title={s.title}>\n                        <span class=\"rr-path-icon\" aria-hidden=\"true\">{s.icon}</span>\n                        <span class=\"rr-path-text\"><span class=\"rr-path-label\">{s.label}</span><span class=\"rr-path-note\">{s.note}</span></span>\n                    </li>\n                </template>\n            </ol>\n\n            <!-- what failed and what to do -->\n            <template lwc:if={failure}>\n                <section class=\"rr-fail\" role=\"alert\">\n                    <div class=\"rr-fail-head\">\n                        <span class=\"rr-fail-icon\" aria-hidden=\"true\">✕</span>\n                        <div class=\"rr-fail-titles\">\n                            <h3 class=\"rr-fail-title\">{failure.title}</h3>\n                            <p class=\"rr-fail-sub\">{failure.summary}</p>\n                        </div>\n                    </div>\n                    <template lwc:if={failure.hasLines}>\n                        <ul class=\"rr-fail-list\">\n                            <template for:each={failure.lines} for:item=\"l\">\n                                <li key={l.id}><span class=\"rr-fail-where\">{l.where}</span><span class=\"rr-fail-text\">{l.text}</span></li>\n                            </template>\n                        </ul>\n                        <template lwc:if={failure.more}><p class=\"rr-muted rr-small\">{failure.more}</p></template>\n                    </template>\n                    <p class=\"rr-fail-next\"><strong>What to do:</strong> {failure.next}</p>\n                    <div class=\"rr-fail-actions\">\n                        <button class=\"rr-btn\" data-tab={failure.tab} onclick={handleGoTab}>See details</button>\n                        <template lwc:if={canEdit}>\n                            <button class=\"rr-btn\" data-tab=\"files\" onclick={handleGoTab}>✎ Fix the files here</button>\n                        </template>\n                        <template lwc:if={canRerun}>\n                            <button class=\"rr-btn rr-btn-blue\" onclick={handleRerun}>Re-run checks</button>\n                        </template>\n                        <template lwc:if={failure.runUrl}>\n                            <a class=\"rr-btn\" href={failure.runUrl} target=\"_blank\">Open run log</a>\n                        </template>\n                    </div>\n                </section>\n            </template>\n            <template lwc:else>\n                <template lwc:if={blockedReason}>\n                    <p class=\"rr-msg rr-msg-info\">{blockedReason}</p>\n                </template>\n                <template lwc:if={req.Error_Message__c}>\n                    <p class=\"rr-msg rr-msg-bad\">{req.Error_Message__c}</p>\n                </template>\n            </template>\n\n            <!-- approve / reject / bypass -->\n            <template lwc:if={showActionPanel}>\n                <section class=\"rr-card rr-action-card\" aria-label={actionTitle}>\n                    <h3 class=\"rr-h3\">{actionTitle}</h3>\n                    <p class=\"rr-muted\">{actionHelp}</p>\n                    <lightning-textarea label={commentLabel} value={comment} onchange={handleComment} max-length=\"2000\"></lightning-textarea>\n                    <template lwc:if={actionError}><p class=\"rr-msg rr-msg-bad\" role=\"alert\">{actionError}</p></template>\n                    <div class=\"rr-row-end\">\n                        <button class=\"rr-btn\" onclick={cancelAction}>Cancel</button>\n                        <lightning-button variant={confirmVariant} label={confirmLabel} onclick={confirmAction}></lightning-button>\n                    </div>\n                </section>\n            </template>\n\n            <!-- tabs -->\n            <div class=\"rr-tabs\" role=\"tablist\">\n                <template for:each={tabs} for:item=\"t\">\n                    <button key={t.id} class={t.cls} role=\"tab\" aria-selected={t.selected} data-id={t.id} onclick={handleTab}>{t.label}</button>\n                </template>\n            </div>\n\n            <!-- files -->\n            <template lwc:if={isFiles}>\n                <template lwc:if={filesError}><p class=\"rr-msg rr-msg-bad\">{filesError}</p></template>\n                <template lwc:if={noFiles}><p class=\"rr-muted rr-pad\">No files yet. They appear once the {changeName} is open, or for org to org once the components are retrieved.</p></template>\n                <template lwc:if={fileCount}>\n                    <div class=\"rr-files-layout\">\n                        <ul class=\"rr-file-list\">\n                            <template for:each={fileRows} for:item=\"f\">\n                                <li key={f.id}>\n                                    <button class={f.cls} data-id={f.id} onclick={handleFile} title={f.id}>\n                                        <span class=\"rr-file-name\">{f.name}</span>\n                                        <span class=\"rr-file-folder\">{f.folder}</span>\n                                        <span class=\"rr-file-stats\"><span class=\"rr-adds\">{f.adds}</span> <span class=\"rr-dels\">{f.dels}</span></span>\n                                    </button>\n                                </li>\n                            </template>\n                        </ul>\n                        <div class=\"rr-diff-pane\">\n                            <div class=\"rr-diff-head\">\n                                <span class=\"rr-diff-path rr-mono\" title={selectedFile}>{selectedFile}</span>\n                                <template lwc:if={canEditFile}>\n                                    <button class=\"rr-btn rr-btn-small\" onclick={startEdit}>✎ Edit</button>\n                                </template>\n                            </div>\n                            <template lwc:if={editing}>\n                                <div class=\"rr-editor\">\n                                    <p class=\"rr-muted rr-small\">Editing the version on <span class=\"rr-mono\">{req.Source_Branch__c}</span>. Saving commits the file to that branch and runs the code scan and validation again.</p>\n                                    <template lwc:if={editLoading}><p class=\"rr-muted rr-pad\">Loading the file…</p></template>\n                                    <template lwc:else>\n                                        <textarea class=\"rr-code\" spellcheck=\"false\" aria-label=\"File content\" oninput={handleEditText} onkeydown={handleEditKey}></textarea>\n                                        <lightning-input label=\"What did you change? (commit message)\" value={editMessage} onchange={handleEditMessage} max-length=\"200\"></lightning-input>\n                                        <template lwc:if={editError}><p class=\"rr-msg rr-msg-bad\" role=\"alert\">{editError}</p></template>\n                                        <div class=\"rr-row-end\">\n                                            <button class=\"rr-btn\" onclick={cancelEdit}>Cancel</button>\n                                            <button class=\"rr-btn rr-btn-brand\" onclick={saveEdit} disabled={saving}>Save to branch and re-check</button>\n                                        </div>\n                                    </template>\n                                </div>\n                            </template>\n                            <template lwc:else>\n                            <template lwc:if={pairLoading}><p class=\"rr-muted rr-pad\">Comparing both versions…</p></template>\n                            <template lwc:if={noPatch}><p class=\"rr-muted rr-pad\">{noPatchText}</p></template>\n                            <div class=\"rr-diff-scroll\">\n                                <table class=\"rr-diff\">\n                                    <tbody>\n                                        <template for:each={diffRows} for:item=\"d\">\n                                            <tr key={d.id} class={d.cls}>\n                                                <td class=\"rr-ln\">{d.oldNo}</td>\n                                                <td class=\"rr-ln\">{d.newNo}</td>\n                                                <td class=\"rr-sg\">{d.sign}</td>\n                                                <td class=\"rr-tx\">{d.text}</td>\n                                            </tr>\n                                        </template>\n                                    </tbody>\n                                </table>\n                            </div>\n                            <template lwc:if={patchTruncated}><p class=\"rr-muted rr-pad\">The diff is cut short here. Open it in the Git provider for the rest.</p></template>\n                            </template>\n                        </div>\n                    </div>\n                </template>\n            </template>\n\n            <!-- code scan -->\n            <template lwc:if={isScan}>\n                <div class=\"rr-pad\">\n                    <p>{scanSummary}</p>\n                    <template lwc:if={scanBypassed}>\n                        <p class=\"rr-msg rr-msg-warn\">Bypassed by {bypassedBy}: {req.Scan_Bypass_Reason__c}</p>\n                    </template>\n                    <div class=\"rr-counts\">\n                        <template for:each={scanCounts} for:item=\"c\">\n                            <span key={c.id} class={c.cls}><strong>{c.count}</strong> {c.label}</span>\n                        </template>\n                    </div>\n                    <template lwc:if={hasViolations}>\n                        <div class=\"rr-table-wrap\">\n                            <table class=\"rr-grid\">\n                                <thead><tr><th>Severity</th><th>Rule</th><th>Where</th><th>Problem</th></tr></thead>\n                                <tbody>\n                                    <template for:each={violations} for:item=\"v\">\n                                        <tr key={v.id}>\n                                            <td><span class={v.sevCls}>{v.sev}</span></td>\n                                            <td>\n                                                <template lwc:if={v.url}><a href={v.url} target=\"_blank\">{v.rule}</a></template>\n                                                <template lwc:else>{v.rule}</template>\n                                                <span class=\"rr-muted rr-small\"> {v.engine}</span>\n                                            </td>\n                                            <td class=\"rr-mono\" title={v.path}>{v.where}</td>\n                                            <td>{v.message}</td>\n                                        </tr>\n                                    </template>\n                                </tbody>\n                            </table>\n                        </div>\n                    </template>\n                    <template lwc:if={scanRunUrl}><p class=\"rr-small\"><a href={scanRunUrl} target=\"_blank\">Scan log</a></p></template>\n                </div>\n            </template>\n\n            <!-- validation and deployment -->\n            <template lwc:if={isChecks}>\n                <div class=\"rr-pad rr-checks\">\n                    <section class=\"rr-check\">\n                        <div class=\"rr-check-head\"><h3 class=\"rr-h3\">Validation against {req.Target_Branch__c}</h3><span class={validation.pillCls}>{validation.status}</span></div>\n                        <p class=\"rr-muted\">A check-only deployment of the changes, with tests, before anyone approves it.</p>\n                        <p>{validation.text}</p>\n                        <template lwc:if={validation.hasComponentErrors}>\n                            <table class=\"rr-grid\">\n                                <thead><tr><th>Component</th><th>Line</th><th>Problem</th></tr></thead>\n                                <tbody>\n                                    <template for:each={validation.componentErrors} for:item=\"c\">\n                                        <tr key={c.id}><td class=\"rr-mono\">{c.type}: {c.name}</td><td>{c.line}</td><td>{c.problem}</td></tr>\n                                    </template>\n                                </tbody>\n                            </table>\n                        </template>\n                        <template lwc:if={validation.hasTestFailures}>\n                            <table class=\"rr-grid\">\n                                <thead><tr><th>Test</th><th>Message</th></tr></thead>\n                                <tbody>\n                                    <template for:each={validation.testFailures} for:item=\"t\">\n                                        <tr key={t.id}><td class=\"rr-mono\">{t.name}.{t.method}</td><td>{t.message}</td></tr>\n                                    </template>\n                                </tbody>\n                            </table>\n                        </template>\n                        <template lwc:if={validation.runUrl}><p class=\"rr-small\"><a href={validation.runUrl} target=\"_blank\">Validation log</a></p></template>\n                    </section>\n                    <section class=\"rr-check\">\n                        <div class=\"rr-check-head\"><h3 class=\"rr-h3\">Deployment to {req.Target_Branch__c}</h3><span class={deployment.pillCls}>{deployment.status}</span></div>\n                        <p class=\"rr-muted\">Runs after approval (for Git connections, once the change is merged).</p>\n                        <p>{deployment.text}</p>\n                        <template lwc:if={deployment.hasComponentErrors}>\n                            <table class=\"rr-grid\">\n                                <thead><tr><th>Component</th><th>Line</th><th>Problem</th></tr></thead>\n                                <tbody>\n                                    <template for:each={deployment.componentErrors} for:item=\"c\">\n                                        <tr key={c.id}><td class=\"rr-mono\">{c.type}: {c.name}</td><td>{c.line}</td><td>{c.problem}</td></tr>\n                                    </template>\n                                </tbody>\n                            </table>\n                        </template>\n                        <template lwc:if={deployment.hasTestFailures}>\n                            <table class=\"rr-grid\">\n                                <thead><tr><th>Test</th><th>Message</th></tr></thead>\n                                <tbody>\n                                    <template for:each={deployment.testFailures} for:item=\"t\">\n                                        <tr key={t.id}><td class=\"rr-mono\">{t.name}.{t.method}</td><td>{t.message}</td></tr>\n                                    </template>\n                                </tbody>\n                            </table>\n                        </template>\n                        <template lwc:if={deployment.runUrl}><p class=\"rr-small\"><a href={deployment.runUrl} target=\"_blank\">Deployment log</a></p></template>\n                    </section>\n                </div>\n            </template>\n\n            <!-- components -->\n            <template lwc:if={isItems}>\n                <div class=\"rr-pad\">\n                    <template lwc:if={noItems}><p class=\"rr-muted\">Raised from an existing branch, so there's no component list. See Files.</p></template>\n                    <template lwc:else>\n                        <table class=\"rr-grid\">\n                            <thead><tr><th>Component</th><th>Type</th><th>Change</th></tr></thead>\n                            <tbody>\n                                <template for:each={items} for:item=\"i\">\n                                    <tr key={i.id}><td class=\"rr-mono\">{i.name}</td><td>{i.type}</td><td><span class={i.cls}>{i.change}</span></td></tr>\n                                </template>\n                            </tbody>\n                        </table>\n                    </template>\n                </div>\n            </template>\n\n            <!-- approval -->\n            <template lwc:if={isApproval}>\n                <div class=\"rr-pad\">\n                    <template lwc:if={hasApproval}>\n                        <dl class=\"rr-kv\">\n                            <dt>Decision</dt><dd>{req.Approval_Status__c}</dd>\n                            <dt>By</dt><dd>{approver}</dd>\n                            <dt>On</dt><dd><lightning-formatted-date-time value={req.Approved_On__c} year=\"numeric\" month=\"short\" day=\"numeric\" hour=\"2-digit\" minute=\"2-digit\"></lightning-formatted-date-time></dd>\n                            <dt>Comment</dt><dd>{req.Approval_Comment__c}</dd>\n                            <template lwc:if={req.Merge_Commit__c}><dt>Merge commit</dt><dd class=\"rr-mono\">{req.Merge_Commit__c}</dd></template>\n                        </dl>\n                    </template>\n                    <template lwc:else>\n                        <p class=\"rr-muted\">No decision yet. Approvers (Release Relay Approver permission set) approve here once the code scan and validation pass.</p>\n                    </template>\n                    <template lwc:if={req.Description__c}>\n                        <h3 class=\"rr-h3 rr-top-gap\">Description</h3>\n                        <p class=\"rr-pre\">{req.Description__c}</p>\n                    </template>\n                </div>\n            </template>\n        </template>\n    </div>\n</template>"}
