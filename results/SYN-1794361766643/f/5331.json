{"path":"force-app/main/default/lwc/rlyReleaseWindow/rlyReleaseWindow.html","left":null,"right":"<template>\n    <div class=\"rr-win\" role=\"group\" aria-label=\"Release window\">\n        <div class=\"rr-win-head\">\n            <h3 class=\"rr-h3 rr-grow\">Release window</h3>\n            <span class={stateCls}>{stateLabel}</span>\n            <template lwc:if={showEdit}><lightning-button label=\"Edit\" onclick={startEdit}></lightning-button></template>\n        </div>\n        <template lwc:if={editing}>\n            <div class=\"rr-win-form\">\n                <c-rly-choice-chips label=\"Deploys allowed on\" options={dayOptions} value={form.days} onchange={handleDays}></c-rly-choice-chips>\n                <p class=\"rr-kicker\">No day chosen: no window, deploys run any time (freezes still apply).</p>\n                <div class=\"rr-win-grid\">\n                    <lightning-input type=\"time\" label=\"From\" value={form.fromTime} data-field=\"fromTime\" onchange={handleField}\n                        field-level-help=\"Blank From and To: the whole day.\"></lightning-input>\n                    <lightning-input type=\"time\" label=\"To\" value={form.toTime} data-field=\"toTime\" onchange={handleField}></lightning-input>\n                    <lightning-combobox label=\"Time zone\" value={form.timeZone} options={zoneOptions} data-field=\"timeZone\" onchange={handleField}\n                        placeholder=\"For example America/Chicago\"></lightning-combobox>\n                </div>\n                <template lwc:if={overnight}><p class=\"rr-kicker\">To is earlier than From: the window runs past midnight into the next day.</p></template>\n                <h4 class=\"rr-win-sub\">Freezes</h4>\n                <template lwc:if={hasFormFreezes}>\n                    <template for:each={formFreezes} for:item=\"f\">\n                        <div key={f.key} class=\"rr-win-freeze\">\n                            <lightning-input type=\"date\" label=\"From\" value={f.fromDate} data-key={f.key} data-field=\"fromDate\" onchange={handleFreeze}></lightning-input>\n                            <lightning-input type=\"date\" label=\"To\" value={f.toDate} data-key={f.key} data-field=\"toDate\" onchange={handleFreeze}></lightning-input>\n                            <lightning-input label=\"Reason\" value={f.reason} max-length=\"120\" data-key={f.key} data-field=\"reason\" onchange={handleFreeze}\n                                placeholder=\"For example Year-end close\"></lightning-input>\n                            <lightning-button-icon icon-name=\"utility:delete\" alternative-text=\"Remove this freeze\" title=\"Remove this freeze\"\n                                data-key={f.key} onclick={removeFreeze} class=\"rr-win-del\"></lightning-button-icon>\n                        </div>\n                    </template>\n                </template>\n                <template lwc:else><p class=\"rr-kicker\">No freezes.</p></template>\n                <div class=\"rr-win-actions\">\n                    <lightning-button label=\"Add a freeze\" icon-name=\"utility:add\" onclick={addFreeze}></lightning-button>\n                    <span class=\"rr-grow\"></span>\n                    <lightning-button label=\"Cancel\" onclick={cancelEdit} disabled={saving}></lightning-button>\n                    <lightning-button variant=\"brand\" label=\"Save\" onclick={save} disabled={saving}></lightning-button>\n                </div>\n                <template lwc:if={error}><div class=\"rr-msg rr-msg-bad\" role=\"alert\">{error}</div></template>\n            </div>\n        </template>\n        <template lwc:else>\n            <p class=\"rr-win-summary\">{summary}</p>\n            <p class=\"rr-kicker\">{stateText}</p>\n            <template lwc:if={hasFreezes}>\n                <ul class=\"rr-win-list\" aria-label=\"Freezes\">\n                    <template for:each={freezeRows} for:item=\"r\"><li key={r.key}>{r.text}</li></template>\n                </ul>\n            </template>\n            <p class=\"rr-kicker\">An approved release outside the window waits (Waiting for the window) and deploys when a page reads it inside the window; in a freeze it is held. Someone with the Release Window Bypass add-on can Deploy now anyway, with a reason.</p>\n        </template>\n    </div>\n</template>"}
